string[5] as_kFace;           // the marine strip and minimap appear with the first level         // the debrief is up: the names would draw over it

// ---- helpers ----------------------------------------------------------
string AS_Ui (string name) {return AS_UI+name+".dds";}
color AS_Rgb (int r, int g, int b) {return Color(IntToFixed(r)/2.55,IntToFixed(g)/2.55,IntToFixed(b)/2.55);}
color AS_Full () {return Color(100.0,100.0,100.0);}
int AS_Label (int d, int p, int anchor, int x, int y, int w, int h, string style, string s) {
    int c=DialogControlCreate(d,c_triggerControlTypeLabel);
    DialogControlSetSize(c,PlayerGroupAll(),w,h);
    DialogControlSetPosition(c,PlayerGroupAll(),anchor,x,y);
    DialogControlSetPropertyAsString(c,c_triggerControlPropertyStyle,PlayerGroupAll(),style);
    DialogControlSetPropertyAsText(c,c_triggerControlPropertyText,PlayerGroupAll(),StringToText(s));
    return c;
}
int AS_Image (int d, int anchor, int x, int y, int w, int h, string image, color tint) {
    int c=DialogControlCreate(d,c_triggerControlTypeImage);
    DialogControlSetSize(c,PlayerGroupAll(),w,h);
    DialogControlSetPosition(c,PlayerGroupAll(),anchor,x,y);
    DialogControlSetPropertyAsString(c,c_triggerControlPropertyImage,PlayerGroupAll(),image);
    DialogControlSetPropertyAsInt(c,c_triggerControlPropertyImageType,PlayerGroupAll(),c_triggerImageTypeNormal);
    DialogControlSetPropertyAsColor(c,c_triggerControlPropertyColor,PlayerGroupAll(),tint);
    return c;
}
// HUD art at the top left of a dialog.
int AS_Art (int d, int x, int y, int w, int h, string name, color tint) {return AS_Image(d,c_anchorTopLeft,x,y,w,h,AS_Ui(name),tint);}
int AS_Lbl (int d, int x, int y, int w, int h, string style, string s) {return AS_Label(d,0,c_anchorTopLeft,x,y,w,h,style,s);}
void AS_Text (int c, int p, string s) {
    DialogControlSetPropertyAsText(c,c_triggerControlPropertyText,AS_Me(p),StringToText(s));
}
void AS_Show (int c, int p, bool on) {DialogControlSetVisible(c,AS_Me(p),on);}
void AS_SetArt (int c, int p, string name) {DialogControlSetPropertyAsString(c,c_triggerControlPropertyImage,AS_Me(p),AS_Ui(name));}
void AS_SetTint (int c, int p, color k) {DialogControlSetPropertyAsColor(c,c_triggerControlPropertyColor,AS_Me(p),k);}
void AS_SetStyle (int c, int p, string style) {DialogControlSetPropertyAsString(c,c_triggerControlPropertyStyle,AS_Me(p),style);}
void AS_Place (int c, int p, int x, int y) {DialogControlSetPosition(c,AS_Me(p),c_anchorTopLeft,x,y);}
int AS_Panel (int p, int w, int h, int anchor, int x, int y) {
    int d=DialogCreate(w,h,anchor,x,y,false);
    DialogSetImageVisible(d,false);
    DialogSetVisible(d,AS_Me(p),true);
    return d;
}
string AS_Two (int n) {
    if(n<10) {return "0"+IntToString(n);}
    return IntToString(n);
}
string AS_Three (int n) {
    if(n<10) {return "00"+IntToString(n);}
    if(n<100) {return "0"+IntToString(n);}
    return IntToString(n);
}
// The weapon names AS prints on the HUD.
string AS_GunTitle (int w) {
    if(w==1) {return "Assault Rifle";}if(w==2) {return "Autogun";}if(w==3) {return "Shotgun";}if(w==4) {return "Flamer";}
    if(w==5) {return "Twin Pistols";}if(w==6) {return "Railgun";}if(w==7) {return "Minigun";}if(w==8) {return "Grenade Launcher";}
    if(w==9) {return "Tesla Cannon";}return "Sniper Rifle";
}
// Each slot wears one of AS's four class medallions.
string AS_ClassOf (int q) {
    int k=(q-1)%4;
    if(k==0) {return "officer";}if(k==1) {return "sw";}if(k==2) {return "medic";}return "tech";
}
string AS_PortraitOf (int q) {
    if(as_portrait[q]!="" && AS_HudPortraitKnown(as_portrait[q])) {return as_portrait[q];}
    return AS_HudPortraitDefault(q);
}
text AS_MarineName (int q) {
    if(as_bot[q] && !(as_auto && q==1)) {return StringToText("Marine "+IntToString(q));}
    return PlayerName(q);
}

// ---- building it ------------------------------------------------------
void AS_HudCreate (int p) {
    int d;int k;int i;int x;int y;int ix;
    color blue=AS_HUD_INACTIVE();
    AS_HudMaps();
    // Damage vignette, underneath everything.
    d=DialogCreate(1600,1200,c_anchorCenter,0,0,false);DialogSetImageVisible(d,false);DialogSetFullscreen(d,true);
    AS_Image(d,c_anchorCenter,0,0,2400,1200,AS_VIGNETTE,Color(100.0,8.0,4.0));
    DialogSetTransparency(d,100.0);DialogSetVisible(d,AS_Me(p),true);as_dHurt[p]=d;
    // The marine, bottom left (ASW_Hud_Master).
    d=AS_Panel(p,AS_HUD_STRIP_W,AS_HUD_STRIP_H,c_anchorBottomLeft,0,0);as_dStrip[p]=d;DialogSetVisible(d,AS_Me(p),false);
    x=AS_HUD_PX;y=AS_HUD_PY;
    as_cGun2[p]=AS_Art(d,x,AS_HUD_GUN2_Y,AS_HUD_GUN_W,AS_HUD_GUN_H,"gun1",blue);AS_Show(as_cGun2[p],p,false);
    as_cGun1[p]=AS_Art(d,x,AS_HUD_GUN1_Y,AS_HUD_GUN_W,AS_HUD_GUN_H,"gun1",AS_Full());
    AS_Art(d,x,y,AS_HUD_RING,AS_HUD_RING,"plate",AS_Full());
    AS_Art(d,x+AS_HUD_RING,y+AS_HUD_RING/2,AS_HUD_BAR_W,AS_HUD_RING-AS_HUD_RING/2,"black75",AS_Full());
    as_cFace[p]=AS_Art(d,x+AS_HUD_FACE_X-AS_HUD_FACE_R,y+AS_HUD_FACE_Y-AS_HUD_FACE_R,2*AS_HUD_FACE_R,2*AS_HUD_FACE_R,"face_"+AS_PortraitOf(p),AS_Full());as_kFace[p]=AS_PortraitOf(p);
    as_cRingBg[p]=AS_Art(d,x,y,AS_HUD_RING,AS_HUD_RING,"ringbg",AS_Full());
    as_cRingGhost[p]=AS_Art(d,x,y,AS_HUD_RING,AS_HUD_RING,"hp"+AS_Two(AS_HUD_RING_N),AS_HUD_GHOST_TINT());
    as_cRing[p]=AS_Art(d,x,y,AS_HUD_RING,AS_HUD_RING,"hp"+AS_Two(AS_HUD_RING_N),AS_HUD_HP_TINT());
    as_kRing[p]=AS_HUD_RING_N;as_kGhost[p]=AS_HUD_RING_N;
    as_cCls[p]=AS_Art(d,x+AS_HUD_CLS_X,y+AS_HUD_CLS_Y,AS_HUD_CLS,AS_HUD_CLS,"cls_"+AS_ClassOf(p),AS_Full());as_kCls[p]=AS_ClassOf(p);
    as_cGunName[p]=AS_Lbl(d,x+AS_HUD_NAME_X,y+AS_HUD_NAME_Y,300,26,"ASSmall","");
    as_cLow[p]=AS_Lbl(d,x+AS_HUD_LOW_X,y+AS_HUD_LOW_Y,300,30,"ASLow","");
    as_cBulIcon[p]=AS_Art(d,x+AS_HUD_BUL_X,y+AS_HUD_BUL_Y,AS_HUD_ICON,AS_HUD_ICON,"bullets",AS_Full());
    as_cAmmo[p]=AS_Lbl(d,x+AS_HUD_AMMO_X,y+AS_HUD_AMMO_Y-4,90,42,"ASLarge","");
    as_cGrenIcon[p]=AS_Art(d,x+AS_HUD_GREN_X,y+AS_HUD_BUL_Y,AS_HUD_ICON,AS_HUD_ICON,"grenade",AS_Full());
    as_cGren[p]=AS_Lbl(d,x+AS_HUD_GREN_TX,y+AS_HUD_AMMO_Y-4,40,42,"ASLarge","");
    for(k=0;k<5;k+=1) {as_cClip[p][k]=AS_Art(d,x+AS_HUD_CLIP_X+AS_HUD_CLIP_GAP*k,y+AS_HUD_CLIP_Y,AS_HUD_CLIP,AS_HUD_CLIP,"clip1",AS_Full());}
    as_cClipN[p]=AS_Lbl(d,x+AS_HUD_CLIP_X+AS_HUD_CLIP,y+AS_HUD_CLIP_Y,60,AS_HUD_CLIP,"ASSmall","");
    for(i=0;i<3;i+=1) {
        ix=x+AS_HUD_ITEM_X+AS_HUD_ITEM_GAP*i;
        as_cItem[p][i]=AS_Art(d,ix,y+AS_HUD_ITEM_Y,AS_HUD_ITEM,AS_HUD_ITEM,"item_sentry",blue);
        as_cItemKey[p][i]=AS_Lbl(d,ix,y+AS_HUD_ITEM_Y,AS_HUD_ITEM-4,28,"ASKeyR","");
        as_cItemN[p][i]=AS_Lbl(d,ix,y+AS_HUD_ITEM_Y+AS_HUD_ITEM-24,AS_HUD_ITEM-4,24,"ASQtyR","");
    }
    AS_SetArt(as_cItem[p][1],p,"item_medkit");AS_SetArt(as_cItem[p][2],p,"item_flare");
    AS_Text(as_cItemKey[p][0],p,"Q");AS_Text(as_cItemKey[p][1],p,"E");AS_Text(as_cItemKey[p][2],p,"X");
    as_cStatus[p]=AS_Lbl(d,x+AS_HUD_LOW_X,y+AS_HUD_LOW_Y-30,300,28,"ASSmall","");
    as_cRelBg[p]=AS_Art(d,AS_HUD_RELOAD_X,AS_HUD_RELOAD_Y,AS_HUD_RELOAD_W,AS_HUD_RELOAD_H,"barbg",AS_Full());
    as_cRelMark[p]=AS_Art(d,AS_HUD_RELOAD_X,AS_HUD_RELOAD_Y+2,4,AS_HUD_RELOAD_H-4,"tick",AS_Full());
    AS_Show(as_cRelBg[p],p,false);AS_Show(as_cRelMark[p],p,false);
    // The squad, along the bottom.
    for(k=0;k<3;k+=1) {
        x=AS_HUD_SQ_X+AS_HUD_SQ_GAP*k;y=AS_HUD_SQ_Y;
        as_cSqName[p][k]=AS_Lbl(d,x+AS_HUD_SQ_NAME_X,y+AS_HUD_SQ_NAME_Y,AS_HUD_SQ_BG_W,26,"ASSmall","");
        as_cSqBg[p][k]=AS_Art(d,x+AS_HUD_SQ_BG_X,y+AS_HUD_SQ_BG_Y,AS_HUD_SQ_BG_W,AS_HUD_SQ_BG_H,"teambg",AS_Full());
        as_cSqCls[p][k]=AS_Art(d,x+AS_HUD_SQ_CLS_X,y+AS_HUD_SQ_CLS_Y,AS_HUD_SQ_CLS,AS_HUD_SQ_CLS,"cls_officer",AS_Full());
        as_cSqHpBg[p][k]=AS_Art(d,x+AS_HUD_SQ_HP_X,y+AS_HUD_SQ_HP_Y,AS_HUD_SQ_HP_W,AS_HUD_SQ_HP_H,"tbar0",AS_Full());
        as_cSqHp[p][k]=AS_Art(d,x+AS_HUD_SQ_HP_X,y+AS_HUD_SQ_HP_Y,AS_HUD_SQ_HP_W,AS_HUD_SQ_HP_H,"tbar1",AS_HUD_HP_TINT());
        for(i=0;i<AS_HUD_SQ_TICKS;i+=1) {
            as_cSqTick[p][k*12+i]=AS_Art(d,x+AS_HUD_SQ_AM_X+AS_HUD_SQ_TICK_GAP*i,y+AS_HUD_SQ_AM_Y,AS_HUD_SQ_TICK_W,AS_HUD_SQ_AM_H,"tick",AS_Rgb(200,200,200));
        }
        for(i=0;i<5;i+=1) {
            as_cSqClip[p][k*5+i]=AS_Art(d,x+AS_HUD_SQ_CLIP_X+AS_HUD_SQ_CLIP_GAP*i,y+AS_HUD_SQ_CLIP_Y,AS_HUD_SQ_CLIP,AS_HUD_SQ_CLIP,"clip1",AS_Rgb(200,200,200));
        }
        as_cSqClipN[p][k]=AS_Lbl(d,x+AS_HUD_SQ_CLIP_X+AS_HUD_SQ_CLIP,y+AS_HUD_SQ_CLIP_Y-3,60,24,"ASSmall","");
        as_cSqItem[p][k]=AS_Art(d,x+AS_HUD_SQ_ITEM_X,y+AS_HUD_SQ_ITEM_Y,AS_HUD_SQ_ITEM,AS_HUD_SQ_ITEM,"item_medkit",blue);
        as_cSqItemN[p][k]=AS_Lbl(d,x+AS_HUD_SQ_ITEM_X,y+AS_HUD_SQ_ITEM_Y+AS_HUD_SQ_ITEM-20,AS_HUD_SQ_ITEM-2,22,"ASQtyR","");
        as_sqWho[p][k]= -1;as_sqKey[p][k]= -1;
        AS_SquadPanel(p,k,false);
    }
    // Objectives, top left (CASWHudObjective): hidden until they change.
    d=AS_Panel(p,AS_HUD_OBJ_W,AS_HUD_OBJ_HEAD+6*AS_HUD_OBJ_ROW+60,c_anchorTopLeft,0,0);as_dObj[p]=d;
    as_cObjBar[p]=AS_Art(d,AS_HUD_OBJ_X-6,AS_HUD_OBJ_Y-6,AS_HUD_OBJ_BAR_W,AS_HUD_OBJ_HEAD+12,"objbar",AS_Full());
    as_cObjHead[p]=AS_Lbl(d,AS_HUD_OBJ_X,AS_HUD_OBJ_Y,AS_HUD_OBJ_BAR_W-60,AS_HUD_OBJ_HEAD,"ASObjHead"," Objectives");
    for(k=0;k<5;k+=1) {
        y=AS_HUD_OBJ_Y+AS_HUD_OBJ_HEAD+8+AS_HUD_OBJ_ROW*k;
        as_cObjTick[p][k]=AS_Art(d,AS_HUD_OBJ_X,y,AS_HUD_OBJ_TICK,AS_HUD_OBJ_TICK,"obj0",AS_Full());
        as_cObjText[p][k]=AS_Lbl(d,AS_HUD_OBJ_X+AS_HUD_OBJ_TICK+8,y-3,AS_HUD_OBJ_W-AS_HUD_OBJ_TICK-40,AS_HUD_OBJ_ROW,"ASObj","");
    }
    as_cObjDone[p]=AS_Lbl(d,AS_HUD_OBJ_X+AS_HUD_OBJ_TICK+8,0,400,AS_HUD_OBJ_ROW,"ASObjDone","");
    as_objFade[p]=100.0;DialogSetTransparency(d,100.0);as_objPrev[p]= -1;
    // The use panel, bottom centre (ASWHudUseArea).
    d=AS_Panel(p,AS_HUD_USE_W,AS_HUD_USE_H,c_anchorBottom,0,AS_HUD_USE_B);as_dUse[p]=d;
    AS_Art(d,0,0,AS_HUD_USE_W,AS_HUD_USE_H,"usebox",AS_Full());
    as_cUseKey[p]=AS_Art(d,14,(AS_HUD_USE_H-AS_HUD_KEY)/2,AS_HUD_KEY,AS_HUD_KEY,"keycap",AS_Full());
    as_cUseKeyT[p]=AS_Label(d,0,c_anchorTopLeft,14,(AS_HUD_USE_H-AS_HUD_KEY)/2,AS_HUD_KEY,AS_HUD_KEY,"ASKeyC","");
    as_cUseText[p]=AS_Lbl(d,AS_HUD_KEY+30,12,AS_HUD_USE_W-AS_HUD_KEY-44,34,"ASUse","");
    as_cUseBarBg[p]=AS_Art(d,AS_HUD_KEY+30,AS_HUD_USE_H-36,AS_HUD_USE_W-AS_HUD_KEY-46,16,"barbg",AS_Full());
    as_cUseBar[p]=AS_Art(d,AS_HUD_KEY+32,AS_HUD_USE_H-34,1,12,"barfg",AS_HUD_BAR_TINT());
    DialogSetVisible(d,AS_Me(p),false);
    // The minimap, bottom right (ASWHudMinimap).
    k=AS_HUD_MM+2*AS_HUD_MM_BORDER;
    d=AS_Panel(p,k,k,c_anchorBottomRight,AS_HUD_MM_R-AS_HUD_MM_BORDER,AS_HUD_MM_B-AS_HUD_MM_BORDER);as_dMap[p]=d;DialogSetVisible(d,AS_Me(p),false);
    AS_Art(d,0,0,k,k,"black75",AS_Full());
    as_cMap[p]=AS_Art(d,AS_HUD_MM_BORDER,AS_HUD_MM_BORDER,AS_HUD_MM,AS_HUD_MM,"map0",AS_Full());as_mapLevel[p]= -1;
    as_cBlipObj[p]=AS_Art(d,0,0,AS_HUD_BLIP_OBJ,AS_HUD_BLIP_OBJ,"blipobj",AS_Rgb(230,192,0));AS_Show(as_cBlipObj[p],p,false);
    for(i=0;i<AS_HUD_BLIP_ALIENS;i+=1) {as_cBlipA[p][i]=AS_Art(d,0,0,AS_HUD_BLIP,AS_HUD_BLIP,"blip",AS_Rgb(255,40,24));AS_Show(as_cBlipA[p][i],p,false);}
    for(i=1;i<=AS_PLAYERS;i+=1) {as_cBlipM[p][i]=AS_Art(d,0,0,AS_HUD_BLIP,AS_HUD_BLIP,"blip",AS_Rgb(0,200,0));AS_Show(as_cBlipM[p][i],p,false);}
    as_cBlipSelf[p]=AS_Art(d,0,0,2*AS_HUD_BLIP,2*AS_HUD_BLIP,"blipring",AS_Rgb(60,255,60));AS_Show(as_cBlipSelf[p],p,false);
    // Announcements across the middle, on a dark band (the mission complete message's backdrop).
    d=AS_Panel(p,3200,170,c_anchorCenter,0,-150);as_dCenter[p]=d;
    as_cBand[p]=AS_Image(d,c_anchorCenter,0,0,3200,150,AS_Ui("shade50"),AS_Rgb(35,41,57));AS_Show(as_cBand[p],p,false);
    as_cBig[p]=AS_Label(d,p,c_anchorTop,0,22,1600,64,"ASBig","");
    as_cSmall[p]=AS_Label(d,p,c_anchorTop,0,92,1600,34,"ASBigSub","");
    // Notices (the overlay messages' black box).
    d=AS_Panel(p,AS_HUD_MSG_W,AS_HUD_MSG_H,c_anchorTop,0,AS_HUD_MSG_Y);as_dMsg[p]=d;
    AS_Art(d,0,0,AS_HUD_MSG_W,AS_HUD_MSG_H,"msgbox",AS_Full());
    as_cMsg[p]=AS_Lbl(d,16,0,AS_HUD_MSG_W-32,AS_HUD_MSG_H,"ASNotice","");
    DialogSetVisible(d,AS_Me(p),false);
    d=AS_Panel(p,64,64,c_anchorCenter,0,0);as_dCross[p]=d;
    as_cCross[p]=AS_Art(d,0,0,64,64,"cross",AS_Rgb(140,255,160));
    // The debrief, after AS's stats screen: the whole screen a dark steel blue, a strip across the top with
    // the mission time and title, the kills graph with the marines' names beside it, the level's map framed
    // bottom left, the result panel with the squad's numbers bottom right, and a strip across the bottom
    // saying what happens next.
    d=DialogCreate(1600,1200,c_anchorCenter,0,0,false);DialogSetImageVisible(d,false);DialogSetFullscreen(d,true);as_dDebriefBg[p]=d;
    AS_Image(d,c_anchorCenter,0,0,3200,1200,AS_WHITE,AS_Rgb(20,34,48));
    AS_Image(d,c_anchorTop,0,90,3200,64,AS_Ui("shade75"),AS_Rgb(0,0,0));
    AS_Image(d,c_anchorBottom,0,90,3200,72,AS_Ui("shade75"),AS_Rgb(0,0,0));
    DialogSetVisible(d,AS_Me(p),false);
    d=AS_Panel(p,1500,1020,c_anchorCenter,0,0);as_dDebrief[p]=d;
    as_cDebTime[p]=AS_Lbl(d,20,0,200,64,"ASDebTitle","");
    as_cDebTitle[p]=AS_Lbl(d,230,0,500,64,"ASDebTitle","DEBRIEF");
    as_cDebPlace[p]=AS_Lbl(d,740,0,740,64,"ASDebPlace","");
    // The kills graph: one step line per marine in its colour, the time along the bottom, the most kills up the side.
    AS_Art(d,40,96,1420,268,"black75",AS_Full());
    AS_Art(d,40,96,1420,2,"white",AS_Rgb(64,112,150));AS_Art(d,40,362,1420,2,"white",AS_Rgb(64,112,150));
    if(as_debTabTrig==null) {as_debTabTrig=TriggerCreate("AS_DebTabT");as_debReadyTrig=TriggerCreate("AS_DebReadyT");}
    for(k=0;k<4;k+=1) {
        as_cDebTabImg[p][k]=AS_Art(d,60+186*k,104,180,36,"buttonoff",AS_Full());
        libNtve_gf_CreateDialogItemButton(d,180,36,c_anchorTopLeft,60+186*k,104,StringToText(""),StringToText(AS_GraphName(k)),"");
        as_cDebTab[p][k]=DialogControlLastCreated();
        AS_DebButton(as_cDebTab[p][k],"ASTab");
        TriggerAddEventDialogControl(as_debTabTrig,p,as_cDebTab[p][k],c_triggerControlEventTypeClick);
    }
    as_debTab[p]=1;
    AS_Art(d,AS_DEB_GX,AS_DEB_GY+AS_DEB_GH,AS_DEB_GW,2,"white",AS_Rgb(64,112,150));
    AS_Art(d,AS_DEB_GX+AS_DEB_GW,AS_DEB_GY,2,AS_DEB_GH,"white",AS_Rgb(64,112,150));
    for(k=0;k<5;k+=1) {as_cDebAxis[p][k]=AS_Lbl(d,AS_DEB_GX+AS_DEB_GW*k/4-50,AS_DEB_GY+AS_DEB_GH+4,100,26,"ASSmallC","");}
    as_cDebAxis[p][5]=AS_Lbl(d,AS_DEB_GX+AS_DEB_GW+8,AS_DEB_GY-12,60,26,"ASSmall","");
    as_cDebAxis[p][6]=AS_Lbl(d,AS_DEB_GX+AS_DEB_GW+8,AS_DEB_GY+AS_DEB_GH-14,60,26,"ASSmall","0");
    for(k=0;k<4*2*AS_DEB_PTS;k+=1) {as_cGraph[p][k]=AS_Art(d,0,0,3,3,"white",AS_Full());AS_Show(as_cGraph[p][k],p,false);}
    for(k=1;k<=AS_PLAYERS;k+=1) {as_cDebLegend[p][k]=AS_Lbl(d,1180,AS_DEB_GY-10+44*(k-1),270,34,"ASDebPlace2","");}
    // The map, bottom left, and the result panel, bottom right.
    AS_Art(d,40,388,540,540,"black75",AS_Full());
    AS_Art(d,40,388,540,2,"white",AS_Rgb(64,112,150));AS_Art(d,40,926,540,2,"white",AS_Rgb(64,112,150));
    AS_Art(d,40,388,2,540,"white",AS_Rgb(64,112,150));AS_Art(d,578,388,2,540,"white",AS_Rgb(64,112,150));
    as_cDebMap[p]=AS_Art(d,60,408,500,500,"map0",AS_Full());
    AS_Art(d,620,388,840,540,"frame",AS_Full());
    AS_Art(d,620,388,840,52,"header",AS_Full());
    as_cDebResult[p]=AS_Lbl(d,620,388,840,52,"ASPanelHead","MISSION COMPLETE");
    as_cDebCol[p][0]=AS_Lbl(d,650,466,300,220,"ASBody","");
    as_cDebCol[p][1]=AS_Lbl(d,930,466,100,220,"ASBodyR","");
    as_cDebCol[p][2]=AS_Lbl(d,1040,466,130,220,"ASBodyR","");
    as_cDebCol[p][3]=AS_Lbl(d,1180,466,160,220,"ASBodyR","");
    as_cDebCol[p][4]=AS_Lbl(d,1350,466,90,220,"ASBodyR","");
    as_cDebNext[p]=AS_Lbl(d,650,800,780,110,"ASBody","");
    as_cDebFoot[p]=AS_Lbl(d,0,948,1500,72,"ASBtn","");
    as_cDebReadyImg[p]=AS_Art(d,1240,958,220,52,"button",AS_Full());
    libNtve_gf_CreateDialogItemButton(d,220,52,c_anchorTopLeft,1240,958,StringToText(""),StringToText("READY"),"");
    as_cDebReady[p]=DialogControlLastCreated();
    AS_DebButton(as_cDebReady[p],"ASBtn");
    TriggerAddEventDialogControl(as_debReadyTrig,p,as_cDebReady[p],c_triggerControlEventTypeClick);
    DialogSetVisible(d,AS_Me(p),false);
    // Kit comparison readout, top right.
    d=AS_Panel(p,760,130,c_anchorTopRight,20,20);
    as_cQa[p]=AS_Label(d,p,c_anchorTopRight,0,0,760,130,"ASSmallR","");
    // Help, toggled with H.
    d=AS_Panel(p,800,660,c_anchorCenter,0,0);as_dHelp[p]=d;
    AS_Art(d,0,0,800,660,"frame",AS_Full());
    AS_Art(d,0,0,800,56,"header",AS_Full());
    AS_Lbl(d,28,6,740,44,"ASHead","CONTROLS");
    AS_Lbl(d,36,74,730,570,"ASBody",
        "<c val=\"8CC8F0\">WASD</c>  move  (screen-relative top-down, camera-relative in third person)<n/>"
        +"<c val=\"8CC8F0\">MOUSE</c>  aim  /  turn the camera in third person<n/>"
        +"<c val=\"8CC8F0\">LEFT MOUSE</c>  fire    <c val=\"8CC8F0\">RIGHT MOUSE</c>  rifle grenade<n/>"
        +"<c val=\"8CC8F0\">R</c>  reload    <c val=\"8CC8F0\">1 - 0</c>  weapons    <c val=\"8CC8F0\">WHEEL</c>  zoom (top-down)<n/>"
        +"<c val=\"8CC8F0\">Q</c>  deploy sentry gun    <c val=\"8CC8F0\">E</c>  medkit    <c val=\"8CC8F0\">X</c>  throw flare<n/>"
        +"<c val=\"8CC8F0\">TAB</c>  objectives    <c val=\"8CC8F0\">F</c>  flashlight    <c val=\"8CC8F0\">V</c>  top-down / third person<n/>"
        +"<c val=\"8CC8F0\">L</c>  lighting preset    <c val=\"8CC8F0\">T</c>  director on / off<n/><n/>"
        +"<c val=\"8CC8F0\">TESTING</c><n/>"
        +"<c val=\"8CC8F0\">CTRL + 1..9</c>  spawn at the cursor: drone, parasite, shieldbug, boomer,<n/>    buzzer, ranger, mortarbug, harvester, uber drone<n/>"
        +"<c val=\"8CC8F0\">CTRL + J</c>  spawn a ripper at the cursor<n/>"
        +"<c val=\"8CC8F0\">CTRL + 0</c>  send a horde now    <c val=\"8CC8F0\">CTRL + G</c>  god mode    <c val=\"8CC8F0\">CTRL + K</c>  kill all aliens<n/>"
        +"<c val=\"8CC8F0\">CTRL + L</c>  skip to the next stage    <c val=\"8CC8F0\">CTRL + R</c>  empty the gun's reserve    <c val=\"8CC8F0\">CTRL + H</c>  hurt yourself<n/><n/>"
        +"Shieldbugs shrug off fire from the front: flank them or use explosives.<n/>"
        +"Biomass only burns: use the flamer. Eggs hatch when you get close.");
    DialogSetVisible(d,AS_Me(p),false);
    as_hudSlot[p]=0;as_prevSlot[p]=0;as_kClips[p]= -1;as_kItems[p]= -1;as_kAmmo[p]= -1;
    AS_HudView(p);
}
void AS_HudView (int p) {
    if(as_dCross[p]==0) {return;}
    DialogSetVisible(as_dCross[p],AS_Me(p),as_view[p]==1);
}
void AS_Message (int p, string s) {
    if(!AS_Person(p) || as_dMsg[p]==0) {return;}
    AS_Text(as_cMsg[p],p,s);as_msgUntil[p]=as_now+2.5;
    DialogSetVisible(as_dMsg[p],AS_Me(p),true);
}
void AS_QaText (string s) {
    int p;
    for(p=1;p<=AS_PLAYERS;p+=1) {if(AS_Person(p) && as_cQa[p]!=0) {AS_Text(as_cQa[p],p,s);}}
}
void AS_Announce (int p, string big, string small) {
    if(!AS_Person(p) || as_dCenter[p]==0) {return;}
    AS_Text(as_cBig[p],p,big);AS_Text(as_cSmall[p],p,small);as_bigUntil[p]=as_now+3.5;
    AS_Show(as_cBand[p],p,true);
}
void AS_HelpToggle (int p) {
    as_help[p]=!as_help[p];
    DialogSetVisible(as_dHelp[p],AS_Me(p),as_help[p]);
}
// TAB: keep the objectives up, or let them fade.
void AS_ObjToggle (int p) {
    if(as_dObj[p]==0) {return;}
    as_objPinned[p]=!as_objPinned[p];
    if(!as_objPinned[p]) {as_objShowUntil[p]=as_now+1.0;}
}
void AS_DebriefHide (int p) {
    if(as_dDebrief[p]!=0) {DialogSetVisible(as_dDebrief[p],AS_Me(p),false);DialogSetVisible(as_dDebriefBg[p],AS_Me(p),false);}
    as_tagsOff[p]=false;
}
void AS_NameTagsHide (int p) {
    int q;
    as_tagsOff[p]=true;
    for(q=1;q<=AS_PLAYERS;q+=1) {
        if(as_dTag[p][q]!=0) {DialogSetVisible(as_dTag[p][q],AS_Me(p),false);as_tagKey[p][q]= -2;}
    }
}

// ---- every update (8 Hz) ------------------------------------------------
void AS_HudUpdate (int p) {
    int w=as_slot[p];int k;int n;int key;int clips;int maxClips;fixed f;string s;string cls;bool low;bool none;bool blink;fixed v;
    AS_ObjWatch();
    if(!as_hudOn[p]) {as_hudOn[p]=true;DialogSetVisible(as_dStrip[p],AS_Me(p),true);DialogSetVisible(as_dMap[p],AS_Me(p),true);}
    // Health: the ring, the health just lost (white, catching up after a moment), the track pulsing red when low.
    f=AS_Clamp(as_hp[p]/as_hpMax[p],0.0,1.0);
    if(!as_alive[p]) {f=0.0;}
    k=FixedToInt(f*IntToFixed(AS_HUD_RING_N)+0.5);
    if(f>0.0 && k==0) {k=1;}
    if(k!=as_kRing[p]) {
        if(k<as_kRing[p] && as_ghostUntil[p]<as_now) {as_ghostUntil[p]=as_now+1.2;}
        if(k>as_kGhost[p]) {as_kGhost[p]=k;AS_SetArt(as_cRingGhost[p],p,"hp"+AS_Two(k));}
        AS_SetArt(as_cRing[p],p,"hp"+AS_Two(k));as_kRing[p]=k;
    }
    if(as_kGhost[p]!=as_kRing[p] && as_now>=as_ghostUntil[p]) {as_kGhost[p]=as_kRing[p];AS_SetArt(as_cRingGhost[p],p,"hp"+AS_Two(as_kRing[p]));}
    if(as_infestUntil[p]>as_now && as_alive[p]) {AS_SetTint(as_cRing[p],p,AS_HUD_INFEST_TINT());}
    else {AS_SetTint(as_cRing[p],p,AS_HUD_HP_TINT());}
    if(f<0.6 && as_alive[p]) {
        if(f<0.33) {v=Sin(as_now*360.0)*0.5+0.5;}
        else {v=Sin(as_now*180.0)*0.5+0.5;}
        AS_SetTint(as_cRingBg[p],p,AS_Rgb(255,155+FixedToInt(100.0*v),155+FixedToInt(100.0*v)));
    }
    else {AS_SetTint(as_cRingBg[p],p,AS_Full());}
    if(AS_PortraitOf(p)!=as_kFace[p]) {as_kFace[p]=AS_PortraitOf(p);AS_SetArt(as_cFace[p],p,"face_"+as_kFace[p]);}
    cls=AS_ClassOf(p);
    if(!as_alive[p]) {cls="dead";}
    else if(as_infestUntil[p]>as_now) {cls="infested";}
    if(cls!=as_kCls[p]) {
        as_kCls[p]=cls;AS_SetArt(as_cCls[p],p,"cls_"+cls);
        if(cls=="dead") {AS_SetTint(as_cFace[p],p,AS_Rgb(90,90,90));}else {AS_SetTint(as_cFace[p],p,AS_Full());}
    }
    // The weapon in hand above, and the one before it in blue.
    if(w!=as_hudSlot[p]) {
        if(as_hudSlot[p]>0) {as_prevSlot[p]=as_hudSlot[p];}
        as_hudSlot[p]=w;
        AS_SetArt(as_cGun1[p],p,"gun"+IntToString(w));
        if(as_prevSlot[p]>0) {AS_SetArt(as_cGun2[p],p,"gun"+IntToString(as_prevSlot[p]));AS_Show(as_cGun2[p],p,true);}
        AS_Text(as_cGunName[p],p,AS_GunTitle(w));
        AS_Show(as_cGrenIcon[p],p,w==1);AS_Show(as_cGren[p],p,w==1);
        as_kClips[p]= -1;as_kAmmo[p]= -1;
    }
    // Bullets in the clip; LOW AMMO / NO AMMO blinking over the portrait, the count blinking with it.
    n=as_mag[p][w];
    none=n==0 && as_reserve[p][w]==0;
    low=as_reserve[p][w]<as_gun[w].mag;
    blink=(FixedToInt(as_now*4.0)%2)==0 && as_reloadEnd[p]<=0.0 && as_alive[p];
    key=n*4;
    if(blink && (low || none)) {key+=1;}
    if(none) {key+=2;}
    if(key!=as_kAmmo[p]) {
        as_kAmmo[p]=key;
        if(blink && (low || none)) {AS_Text(as_cAmmo[p],p,"<c val=\"C81919\">"+AS_Three(n)+"</c>");}
        else {AS_Text(as_cAmmo[p],p,AS_Three(n));}
        if(!(blink && (low || none))) {AS_Text(as_cLow[p],p,"");}
        else if(none) {AS_Text(as_cLow[p],p,"- NO AMMO -");}
        else {AS_Text(as_cLow[p],p,"- LOW AMMO -");}
    }
    if(w==1) {AS_Text(as_cGren[p],p,IntToString(MinI(as_grenades[p],9)));}
    // Clips: up to five, filled for those left; more than five is one clip and the count.
    clips=as_reserve[p][w]/MaxI(1,as_gun[w].mag);
    maxClips=as_gun[w].reserve/MaxI(1,as_gun[w].mag);
    if(clips*100+maxClips!=as_kClips[p]) {
        as_kClips[p]=clips*100+maxClips;
        for(k=0;k<5;k+=1) {
            if(clips>5) {
                AS_Show(as_cClip[p][k],p,k==0);
                if(k==0) {AS_SetArt(as_cClip[p][k],p,"clip1");AS_SetTint(as_cClip[p][k],p,AS_Full());}
            }
            else if(k<clips) {AS_Show(as_cClip[p][k],p,true);AS_SetArt(as_cClip[p][k],p,"clip1");AS_SetTint(as_cClip[p][k],p,AS_Full());}
            else if(k<maxClips) {AS_Show(as_cClip[p][k],p,true);AS_SetArt(as_cClip[p][k],p,"clip0");AS_SetTint(as_cClip[p][k],p,AS_Rgb(128,128,128));}
            else {AS_Show(as_cClip[p][k],p,false);}
        }
        if(clips>5) {AS_Text(as_cClipN[p],p,"x"+IntToString(clips));}else {AS_Text(as_cClipN[p],p,"");}
    }
    // The sentry, medkit and flare: blue, dark when there are none left.
    key=as_sentries[p]*10000+as_medkits[p]*100+as_flares[p];
    if(key!=as_kItems[p]) {
        as_kItems[p]=key;
        AS_HudItem(p,0,as_sentries[p]);AS_HudItem(p,1,as_medkits[p]);AS_HudItem(p,2,as_flares[p]);
    }
    // Reloading: AS's fast-reload bar, its marker running along.
    if(as_reloadEnd[p]>0.0) {
        f=AS_Clamp((as_now-as_reloadStart[p])/MaxF(0.1,as_reloadEnd[p]-as_reloadStart[p]),0.0,1.0);
        AS_Show(as_cRelBg[p],p,true);AS_Show(as_cRelMark[p],p,true);
        AS_Place(as_cRelMark[p],p,AS_HUD_RELOAD_X+FixedToInt(IntToFixed(AS_HUD_RELOAD_W-4)*f),AS_HUD_RELOAD_Y+2);
    }
    else {AS_Show(as_cRelBg[p],p,false);AS_Show(as_cRelMark[p],p,false);}
    s="";
    if(!as_alive[p]) {s="<c val=\"FF5040\">KIA  -  redeploying</c>";}
    else if(as_god[p]) {s="<c val=\"8CC8FF\">GOD MODE</c>";}
    AS_Text(as_cStatus[p],p,s);
    AS_SquadHud(p);
    if(as_level>=0) {AS_MissionHud(p);}
    if(as_tick%4==0) {AS_MapHud(p);}
    AS_ObjHud(p);
    if(as_msgUntil[p]>0.0 && as_now>as_msgUntil[p]) {as_msgUntil[p]=0.0;DialogSetVisible(as_dMsg[p],AS_Me(p),false);}
    if(as_bigUntil[p]>0.0 && as_now>as_bigUntil[p]) {as_bigUntil[p]=0.0;AS_Text(as_cBig[p],p,"");AS_Text(as_cSmall[p],p,"");AS_Show(as_cBand[p],p,false);}
}
void AS_HudItem (int p, int i, int n) {
    AS_Text(as_cItemN[p][i],p,"x"+IntToString(n));
    if(n>0) {AS_SetTint(as_cItem[p][i],p,AS_HUD_INACTIVE());}
    else {AS_SetTint(as_cItem[p][i],p,AS_Rgb(33,71,96));}
}
// The red edge of the screen when hurt, fading over half a second.
void AS_HurtPulse (int p) {
    fixed t=as_now-as_hurtFlash[p];fixed a=100.0;
    if(t<0.6) {a=40.0+60.0*t/0.6;}
    if(as_alive[p] && as_hp[p]<30.0) {a=MinF(a,70.0+20.0*Sin(as_now*360.0));}
    if(!as_alive[p]) {a=30.0;}
    DialogSetTransparency(as_dHurt[p],a);
}

// ---- the squad ----------------------------------------------------------
void AS_SquadPanel (int p, int k, bool on) {
    int i;
    AS_Show(as_cSqName[p][k],p,on);AS_Show(as_cSqBg[p][k],p,on);AS_Show(as_cSqCls[p][k],p,on);AS_Show(as_cSqHpBg[p][k],p,on);
    AS_Show(as_cSqHp[p][k],p,on);AS_Show(as_cSqClipN[p][k],p,on);AS_Show(as_cSqItem[p][k],p,on);AS_Show(as_cSqItemN[p][k],p,on);
    for(i=0;i<AS_HUD_SQ_TICKS;i+=1) {AS_Show(as_cSqTick[p][k*12+i],p,on);}
    for(i=0;i<5;i+=1) {AS_Show(as_cSqClip[p][k*5+i],p,on);}
}
void AS_SquadHud (int p) {
    int q;int k=0;int i;int w;int ticks;int clips;int maxClips;int key;fixed f;bool alive;
    for(q=1;q<=AS_PLAYERS;q+=1) {
        if(q==p || !AS_Person(q) || k>=3) {continue;}
        alive=as_alive[q];
        if(as_sqWho[p][k]!=q) {
            if(as_sqWho[p][k]<0) {AS_SquadPanel(p,k,true);}
            as_sqWho[p][k]=q;as_sqKey[p][k]= -1;
            DialogControlSetPropertyAsText(as_cSqName[p][k],c_triggerControlPropertyText,AS_Me(p),AS_MarineName(q));
        }
        w=as_slot[q];
        f=AS_Clamp(as_hp[q]/as_hpMax[q],0.0,1.0);
        if(!alive) {f=0.0;}
        ticks=(as_mag[q][w]*AS_HUD_SQ_TICKS+as_gun[w].mag-1)/MaxI(1,as_gun[w].mag);
        clips=as_reserve[q][w]/MaxI(1,as_gun[w].mag);
        maxClips=as_gun[w].reserve/MaxI(1,as_gun[w].mag);
        key=FixedToInt(f*100.0)*1000000+ticks*10000+MinI(clips,99)*100+MinI(maxClips,9)*10+as_medkits[q];
        if(as_infestUntil[q]>as_now) {key= -key-1;}
        if(key==as_sqKey[p][k]) {k+=1;continue;}
        as_sqKey[p][k]=key;
        if(alive) {AS_SetStyle(as_cSqName[p][k],p,"ASSmall");}else {AS_SetStyle(as_cSqName[p][k],p,"ASSmallDim");}
        if(!alive) {AS_SetArt(as_cSqCls[p][k],p,"cls_dead");}
        else if(as_infestUntil[q]>as_now) {AS_SetArt(as_cSqCls[p][k],p,"cls_infested");}
        else {AS_SetArt(as_cSqCls[p][k],p,"cls_"+AS_ClassOf(q));}
        AS_Show(as_cSqHp[p][k],p,f>0.0);
        DialogControlSetSize(as_cSqHp[p][k],AS_Me(p),MaxI(1,FixedToInt(IntToFixed(AS_HUD_SQ_HP_W)*f)),AS_HUD_SQ_HP_H);
        if(as_infestUntil[q]>as_now) {AS_SetTint(as_cSqHp[p][k],p,AS_HUD_INFEST_TINT());}else {AS_SetTint(as_cSqHp[p][k],p,AS_HUD_HP_TINT());}
        for(i=0;i<AS_HUD_SQ_TICKS;i+=1) {
            AS_Show(as_cSqTick[p][k*12+i],p,alive);
            if(i<ticks) {AS_SetTint(as_cSqTick[p][k*12+i],p,AS_Rgb(200,200,200));}else {AS_SetTint(as_cSqTick[p][k*12+i],p,AS_Rgb(96,96,96));}
        }
        for(i=0;i<5;i+=1) {
            if(!alive || (clips>5 && i>0) || (clips<=5 && i>=clips && i>=maxClips)) {AS_Show(as_cSqClip[p][k*5+i],p,false);continue;}
            AS_Show(as_cSqClip[p][k*5+i],p,true);
            if(clips>5 || i<clips) {AS_SetArt(as_cSqClip[p][k*5+i],p,"clip1");AS_SetTint(as_cSqClip[p][k*5+i],p,AS_Rgb(200,200,200));}
            else {AS_SetArt(as_cSqClip[p][k*5+i],p,"clip0");AS_SetTint(as_cSqClip[p][k*5+i],p,AS_Rgb(96,96,96));}
        }
        if(alive && clips>5) {AS_Text(as_cSqClipN[p][k],p,"x"+IntToString(clips));}else {AS_Text(as_cSqClipN[p][k],p,"");}
        AS_Show(as_cSqItem[p][k],p,alive);
        if(alive) {AS_Text(as_cSqItemN[p][k],p,"x"+IntToString(as_medkits[q]));}else {AS_Text(as_cSqItemN[p][k],p,"");}
        k+=1;
    }
    for(i=k;i<3;i+=1) {
        if(as_sqWho[p][i]>=0) {as_sqWho[p][i]= -1;AS_SquadPanel(p,i,false);}
    }
}

// ---- names under the marines (CASWHud3DMarineNames) ----------------------
// Your own marine's name is yellow, other players' blue, AI marines' white; the bar is teal, orange
// under half health, flashing red while infested.
void AS_NameTagsPulse () {
    int v;int q;int key;fixed f;int bw;color hi;color dk;
    for(v=1;v<=AS_PLAYERS;v+=1) {
        if(!AS_Person(v) || as_dStrip[v]==0 || as_tagsOff[v]) {continue;}
        for(q=1;q<=AS_PLAYERS;q+=1) {
            if(!AS_Person(q)) {continue;}
            if(as_dTag[v][q]==0) {AS_NameTagMake(v,q);}
            if(as_m[q]==null || !as_alive[q]) {
                if(as_tagKey[v][q]!= -2) {as_tagKey[v][q]= -2;DialogSetVisible(as_dTag[v][q],AS_Me(v),false);}
                continue;
            }
            if(as_tagUnit[v][q]!=as_m[q]) {
                as_tagUnit[v][q]=as_m[q];as_tagKey[v][q]= -1;
                DialogSetPositionRelativeToUnitWithAnchor(as_dTag[v][q],as_m[q],"Ref_Center",c_anchorTop,0,36);
            }
            f=AS_Clamp(as_hp[q]/as_hpMax[q],0.0,1.0);
            key=FixedToInt(f*40.0);
            if(as_infestUntil[q]>as_now) {key=100+(FixedToInt(as_now*4.0)%2);}
            if(key==as_tagKey[v][q]) {continue;}
            if(as_tagKey[v][q]<0) {DialogSetVisible(as_dTag[v][q],AS_Me(v),true);}
            as_tagKey[v][q]=key;
            hi=AS_Rgb(0,150,150);dk=AS_Rgb(0,75,75);
            if(f<0.5) {hi=AS_Rgb(200,50,0);dk=AS_Rgb(100,25,0);}
            if(key==100) {hi=AS_Rgb(255,0,0);dk=AS_Rgb(64,0,0);}
            if(key==101) {hi=AS_Rgb(190,0,0);dk=AS_Rgb(48,0,0);}
            bw=FixedToInt(70.0*f);
            AS_Show(as_cTagHp[v][q],v,bw>0);
            DialogControlSetSize(as_cTagHp[v][q],AS_Me(v),MaxI(1,bw),6);
            AS_SetTint(as_cTagHp[v][q],v,hi);AS_SetTint(as_cTagHpDk[v][q],v,dk);
        }
    }
}
void AS_NameTagMake (int v, int q) {
    int d=DialogCreate(240,48,c_anchorCenter,0,0,false);string style="ASTagAI";
    DialogSetImageVisible(d,false);
    if(q==v) {style="ASTagMe";}
    else if(!as_bot[q]) {style="ASTagMate";}
    as_cTagName[v][q]=AS_Lbl(d,0,0,240,26,style,"");
    DialogControlSetPropertyAsText(as_cTagName[v][q],c_triggerControlPropertyText,AS_Me(v),AS_MarineName(q));
    AS_Art(d,84,28,72,8,"shade50",AS_Full());
    as_cTagHpDk[v][q]=AS_Art(d,85,29,70,6,"white",AS_Rgb(0,75,75));
    as_cTagHp[v][q]=AS_Art(d,85,29,70,6,"white",AS_Rgb(0,150,150));
    DialogSetVisible(d,AS_Me(v),false);
    as_dTag[v][q]=d;as_tagKey[v][q]= -2;as_tagUnit[v][q]=null;
}

// ---- objectives -------------------------------------------------------
// Once a tick for everyone: when the objectives change they come up for eight seconds, and a newly
// finished one types out "Objective complete!" under the list.
void AS_ObjWatch () {
    int k;int sig;int m=1;
    if(as_objWatchTick==as_tick) {return;}
    as_objWatchTick=as_tick;
    if(as_level<0) {return;}
    AS_KillLogPulse();
    sig=as_level*100000;
    for(k=0;k<as_objCount;k+=1) {sig+=as_objState[k]*m;m*=3;}
    if(sig==as_objSig) {return;}
    // An objective finished since the last look (same level, a 1 became a 2)?
    if(as_objSig>=0 && as_objSig/100000==as_level && AS_ObjDoneCount(sig)>AS_ObjDoneCount(as_objSig)) {as_objDoneAt=as_now;}
    as_objSig=sig;
    for(k=1;k<=AS_PLAYERS;k+=1) {as_objShowUntil[k]=as_now+8.0;}
}
// Every marine's kills every few seconds of the mission, for the debrief's graph; a full log keeps every
// other sample and samples half as often.
void AS_KillLogPulse () {
    int q;int i;
    if(as_killLogStart!=as_missionStart) {as_killLogStart=as_missionStart;as_killLogN=0;as_killLogEvery=2.0;as_killLogNext=as_now;}
    if(as_missionEnd>0.0 || as_now<as_killLogNext) {return;}
    if(as_killLogN>=256) {
        for(i=0;i<128;i+=1) {
            for(q=1;q<=AS_PLAYERS;q+=1) {
                as_killLog[q][i]=as_killLog[q][2*i];as_hpLog[q][i]=as_hpLog[q][2*i];
                as_ammoLog[q][i]=as_ammoLog[q][2*i];as_ffLog[q][i]=as_ffLog[q][2*i];
            }
        }
        as_killLogN=128;as_killLogEvery*=2.0;
    }
    for(q=1;q<=AS_PLAYERS;q+=1) {
        as_killLog[q][as_killLogN]=AS_GraphNow(1,q);as_hpLog[q][as_killLogN]=AS_GraphNow(2,q);
        as_ammoLog[q][as_killLogN]=AS_GraphNow(3,q);as_ffLog[q][as_killLogN]=AS_GraphNow(0,q);
    }
    as_killLogN+=1;as_killLogNext=as_now+as_killLogEvery;
}
// A marine's value for graph `kind` now, and at log sample i.
int AS_GraphNow (int kind, int q) {
    int w=as_slot[q];
    if(kind==0) {return FixedToInt(as_ffDealt[q]);}
    if(kind==1) {return as_kills[q];}
    if(kind==2) {
        if(!as_alive[q]) {return 0;}
        return FixedToInt(100.0*AS_Clamp(as_hp[q]/as_hpMax[q],0.0,1.0));
    }
    return (as_mag[q][w]+as_reserve[q][w])*100/MaxI(1,as_gun[w].mag+as_gun[w].reserve);
}
int AS_GraphAt (int kind, int q, int i) {
    if(kind==0) {return as_ffLog[q][i];}
    if(kind==1) {return as_killLog[q][i];}
    if(kind==2) {return as_hpLog[q][i];}
    return as_ammoLog[q][i];
}
color AS_SquadColour (int q) {
    if(q==1) {return AS_Rgb(70,130,255);}if(q==2) {return AS_Rgb(235,70,60);}if(q==3) {return AS_Rgb(80,210,80);}
    return AS_Rgb(235,215,70);
}
// The kills graph on player p's debrief.
void AS_DebriefGraph (int p) {
    int q;int i;int top=1;int a;int b;int x0;int x1;int y0;int y1;int c;int k=as_debTab[p];fixed secs=MaxF(1.0,as_missionEnd-as_missionStart);
    if(k>=2) {top=100;}
    else {
        for(q=1;q<=AS_PLAYERS;q+=1) {
            if(!AS_Person(q)) {continue;}
            top=MaxI(top,AS_GraphNow(k,q));
            for(i=0;i<as_killLogN;i+=1) {top=MaxI(top,AS_GraphAt(k,q,i));}
        }
    }
    for(i=0;i<4;i+=1) {
        if(i==k) {AS_SetArt(as_cDebTabImg[p][i],p,"button");}else {AS_SetArt(as_cDebTabImg[p][i],p,"buttonoff");}
    }
    for(q=1;q<=AS_PLAYERS;q+=1) {
        c=(q-1)*2*AS_DEB_PTS;
        for(i=0;i<AS_DEB_PTS;i+=1) {
            if(!AS_Person(q) || as_killLogN<1) {AS_Show(as_cGraph[p][c+2*i],p,false);AS_Show(as_cGraph[p][c+2*i+1],p,false);continue;}
            a=AS_GraphAt(k,q,i*(as_killLogN-1)/AS_DEB_PTS);
            if(i+1<AS_DEB_PTS) {b=AS_GraphAt(k,q,(i+1)*(as_killLogN-1)/AS_DEB_PTS);}else {b=AS_GraphNow(k,q);}
            x0=AS_DEB_GX+AS_DEB_GW*i/AS_DEB_PTS;x1=AS_DEB_GX+AS_DEB_GW*(i+1)/AS_DEB_PTS;
            y0=AS_DEB_GY+AS_DEB_GH-AS_DEB_GH*a/top;y1=AS_DEB_GY+AS_DEB_GH-AS_DEB_GH*b/top;
            AS_Place(as_cGraph[p][c+2*i],p,x0,y0-1);DialogControlSetSize(as_cGraph[p][c+2*i],AS_Me(p),x1-x0+3,3);
            AS_SetTint(as_cGraph[p][c+2*i],p,AS_SquadColour(q));AS_Show(as_cGraph[p][c+2*i],p,true);
            AS_Place(as_cGraph[p][c+2*i+1],p,x1,MinI(y0,y1)-1);DialogControlSetSize(as_cGraph[p][c+2*i+1],AS_Me(p),3,AbsI(y1-y0)+3);
            AS_SetTint(as_cGraph[p][c+2*i+1],p,AS_SquadColour(q));AS_Show(as_cGraph[p][c+2*i+1],p,b!=a);
        }
        if(AS_Person(q)) {DialogControlSetPropertyAsText(as_cDebLegend[p][q],c_triggerControlPropertyText,AS_Me(p),TextWithColor(AS_MarineName(q),AS_SquadColour(q)));}
        else {AS_Text(as_cDebLegend[p][q],p,"");}
    }
    for(i=0;i<5;i+=1) {AS_Text(as_cDebAxis[p][i],p,AS_Clock(secs*IntToFixed(i)/4.0));}
    if(k>=2) {AS_Text(as_cDebAxis[p][5],p,"100%");}else {AS_Text(as_cDebAxis[p][5],p,IntToString(top));}
}
// The graph's tabs, clicked on the debrief.
bool AS_DebTabT (bool testConds, bool runActions) {
    int p=EventPlayer();int c=EventDialogControl();int i;
    if(!AS_Person(p)) {return true;}
    for(i=0;i<4;i+=1) {if(c==as_cDebTab[p][i]) {as_debTab[p]=i;AS_DebriefGraph(p);}}
    return true;
}
// READY: when every player has clicked it the next mission starts (src/Campaign.galaxy AS_NextT).
bool AS_DebReadyT (bool testConds, bool runActions) {
    int p=EventPlayer();
    if(!AS_Person(p) || as_ready[p]) {return true;}
    as_ready[p]=true;AS_SetArt(as_cDebReadyImg[p],p,"buttonhi");
    return true;
}
void AS_ReadyReset () {
    int p;
    for(p=1;p<=AS_PLAYERS;p+=1) {
        as_ready[p]=false;
        if(as_cDebReadyImg[p]!=0) {AS_SetArt(as_cDebReadyImg[p],p,"button");}
    }
}
// Every player with a HUD has clicked READY (never, in the autopilot, so it waits the full time).
bool AS_AllReady () {
    int p;int n=0;
    for(p=1;p<=AS_PLAYERS;p+=1) {
        if(!AS_Person(p) || as_dStrip[p]==0 || as_bot[p]) {continue;}
        if(!as_ready[p]) {return false;}
        n+=1;
    }
    return n>0;
}
void AS_DebriefCountdown (int secs) {
    int p;int q;int wait=0;string s;
    for(q=1;q<=AS_PLAYERS;q+=1) {if(AS_Person(q) && as_dStrip[q]!=0 && !as_bot[q] && !as_ready[q]) {wait+=1;}}
    for(p=1;p<=AS_PLAYERS;p+=1) {
        if(!AS_Person(p) || as_dDebrief[p]==0) {continue;}
        s="NEXT MISSION  //  "+as_levelTitle[as_level+1]+"      STARTING IN "+IntToString(secs);
        if(as_ready[p] && wait>0) {s=s+"  //  WAITING FOR "+IntToString(wait);}
        AS_Text(as_cDebFoot[p],p,s);
    }
}
int AS_ObjDoneCount (int sig) {
    int k;int n=0;int s=sig%100000;
    for(k=0;k<5;k+=1) {if(s%3==2) {n+=1;}s/=3;}
    return n;
}
void AS_ObjHud (int p) {
    int k;int row=0;int y;int letters;fixed t;string s;bool show;
    if(as_level<0) {show=false;}
    else {show=as_objPinned[p] || as_now<as_objShowUntil[p];}
    if(show) {t=MaxF(0.0,as_objFade[p]-25.0);}
    else {t=MinF(100.0,as_objFade[p]+12.5);}
    if(t!=as_objFade[p]) {as_objFade[p]=t;DialogSetTransparency(as_dObj[p],t);}
    if(t>=100.0) {return;}
    if(as_objSig!=as_objPrev[p]) {
        as_objPrev[p]=as_objSig;
        for(k=0;k<5;k+=1) {
            if(k>=as_objCount || as_objState[k]==0) {continue;}
            AS_Show(as_cObjTick[p][row],p,true);AS_Show(as_cObjText[p][row],p,true);
            if(as_objState[k]==2) {AS_SetArt(as_cObjTick[p][row],p,"obj1");}else {AS_SetArt(as_cObjTick[p][row],p,"obj0");}
            AS_Text(as_cObjText[p][row],p,as_objName[k]);
            row+=1;
        }
        for(k=row;k<5;k+=1) {AS_Show(as_cObjTick[p][k],p,false);AS_Show(as_cObjText[p][k],p,false);}
        y=AS_HUD_OBJ_Y+AS_HUD_OBJ_HEAD+8+AS_HUD_OBJ_ROW*row+AS_HUD_OBJ_ROW/2;
        AS_Place(as_cObjDone[p],p,AS_HUD_OBJ_X+AS_HUD_OBJ_TICK+8,y);
    }
    // "Objective complete!" a letter at a time, a cursor while typing, gone after a few seconds.
    s="";
    if(as_now-as_objDoneAt<5.0) {
        letters=MinI(20,FixedToInt((as_now-as_objDoneAt)/0.06)+1);
        s=StringSub("Objective complete! ",1,letters);
        if(letters<20) {s=s+"_";}
    }
    AS_Text(as_cObjDone[p],p,s);
}

// ---- the minimap --------------------------------------------------------
// Puts a blip at a world point, hidden when the point is off the level's square.
void AS_Blip (int c, int p, fixed x, fixed y, int size) {
    fixed u;fixed v;int n=as_mapLevel[p];
    if(n<0) {AS_Show(c,p,false);return;}
    u=(x-as_mmX0[n])/as_mmSize[n];v=1.0-(y-as_mmY0[n])/as_mmSize[n];
    if(u<0.0 || u>1.0 || v<0.0 || v>1.0) {AS_Show(c,p,false);return;}
    DialogControlSetPosition(c,AS_Me(p),c_anchorTopLeft,AS_HUD_MM_BORDER+FixedToInt(u*IntToFixed(AS_HUD_MM))-size/2,AS_HUD_MM_BORDER+FixedToInt(v*IntToFixed(AS_HUD_MM))-size/2);
    AS_Show(c,p,true);
}
void AS_MapHud (int p) {
    int q;int i;int n=0;point at;
    if(as_level!=as_mapLevel[p]) {
        as_mapLevel[p]=as_level;
        if(as_level>=0) {AS_SetArt(as_cMap[p],p,"map"+IntToString(as_level));}
    }
    for(q=1;q<=AS_PLAYERS;q+=1) {
        if(AS_Person(q) && as_alive[q] && as_m[q]!=null) {at=UnitGetPosition(as_m[q]);AS_Blip(as_cBlipM[p][q],p,PointGetX(at),PointGetY(at),AS_HUD_BLIP);}
        else {AS_Show(as_cBlipM[p][q],p,false);}
    }
    if(as_alive[p] && as_m[p]!=null) {at=UnitGetPosition(as_m[p]);AS_Blip(as_cBlipSelf[p],p,PointGetX(at),PointGetY(at),2*AS_HUD_BLIP);}
    else {AS_Show(as_cBlipSelf[p],p,false);}
    for(i=0;i<AS_MAXALIEN && n<AS_HUD_BLIP_ALIENS;i+=1) {
        if(as_a[i]==null || as_aKind[i]==AS_EGG || as_aKind[i]==AS_BIOMASS) {continue;}
        at=UnitGetPosition(as_a[i]);
        AS_Blip(as_cBlipA[p][n],p,PointGetX(at),PointGetY(at),AS_HUD_BLIP);
        n+=1;
    }
    for(i=n;i<AS_HUD_BLIP_ALIENS;i+=1) {AS_Show(as_cBlipA[p][i],p,false);}
    if(as_objAt!=null) {AS_Blip(as_cBlipObj[p],p,PointGetX(as_objAt),PointGetY(as_objAt),AS_HUD_BLIP_OBJ);}
    else {AS_Show(as_cBlipObj[p],p,false);}
}

// ---- mission HUD --------------------------------------------------------
string AS_GraphName (int k) {
    if(k==0) {return "FRIENDLY FIRE";}if(k==1) {return "KILLS";}if(k==2) {return "HEALTH";}return "AMMO";
}
// A debrief button: AS art drawn as an image under it, the button itself clear with a pale hover
// (SC2 slices a button's own image as a border; see the mission menu in src/Campaign.galaxy).
void AS_DebButton (int c, string style) {
    DialogControlSetPropertyAsString(c,c_triggerControlPropertyImage,PlayerGroupAll(),AS_Ui("clear"));
    DialogControlSetPropertyAsString(c,c_triggerControlPropertyHoverImage,PlayerGroupAll(),AS_Ui("hover"));
    DialogControlSetPropertyAsString(c,c_triggerControlPropertyStyle,PlayerGroupAll(),style);
}
string AS_Clock (fixed secs) {
    int t=FixedToInt(secs);string sec=IntToString(t%60);
    if(t%60<10) {sec="0"+sec;}
    return IntToString(t/60)+":"+sec;
}
// The use panel: a key cap when there is a key to press, the line, and the progress under it.
// Without a key the line and the bar take the key cap's place.
void AS_UsePanel (int p, bool show, string key, string s, fixed f) {
    int x=AS_HUD_KEY+30;
    if(show!=as_useOn[p]) {as_useOn[p]=show;DialogSetVisible(as_dUse[p],AS_Me(p),show);}
    if(!show) {return;}
    if(key=="") {x=24;}
    AS_Show(as_cUseKey[p],p,key!="");AS_Show(as_cUseKeyT[p],p,key!="");
    AS_Text(as_cUseKeyT[p],p,key);
    AS_Place(as_cUseText[p],p,x,12);AS_Text(as_cUseText[p],p,s);
    AS_Place(as_cUseBarBg[p],p,x,AS_HUD_USE_H-36);AS_Place(as_cUseBar[p],p,x+2,AS_HUD_USE_H-34);
    DialogControlSetSize(as_cUseBarBg[p],AS_Me(p),AS_HUD_USE_W-x-16,16);
    AS_Show(as_cUseBarBg[p],p,f>=0.0);AS_Show(as_cUseBar[p],p,f>=0.0);
    if(f>=0.0) {DialogControlSetSize(as_cUseBar[p],AS_Me(p),MaxI(1,FixedToInt(IntToFixed(AS_HUD_USE_W-x-20)*AS_Clamp(f,0.0,1.0))),12);}
}
void AS_Progress (int p, bool show, fixed f, string s) {AS_UsePanel(p,show,"",s,f);}
void AS_MissionHud (int p) {
    // Progress: the override, the countdown aboard, the transit car, the depth on the way down.
    if(as_stage==AS_ST_DOOR && as_hack>0.0) {AS_Progress(p,true,as_hack,as_hackLabel+"  "+IntToString(FixedToInt(as_hack*100.0))+"%");}
    else if(as_stage==AS_ST_BOARD && as_boardAt>0.0) {AS_Progress(p,true,(as_now-as_boardAt)/5.0,"Lift starting");}
    else if(as_stage==AS_ST_ESCAPE && as_holdAt>0.0 && as_now<as_holdAt+AS_HOLD) {AS_Progress(p,true,(as_now-as_holdAt)/AS_HOLD,"Transit car inbound  "+AS_Clock(as_holdAt+AS_HOLD-as_now));}
    else if(as_stage==AS_ST_RIDE) {AS_Progress(p,true,as_scroll/AS_RIDE_LEN,"Descending  -  depth "+IntToString(FixedToInt(as_scroll*4.0))+" m");}
    else if(as_alive[p] && as_infestUntil[p]>as_now && as_medkits[p]>0) {AS_UsePanel(p,true,"E","<c val=\"90FF60\">Infested</c>  -  use a medkit",-1.0);}
    else {AS_Progress(p,false,0.0,"");}
}
// The squad's numbers for the level just won; `next` says what happens now.
void AS_Debrief (int p, string next) {
    int q;int acc;text c0;string c1;string c2;string c3;string c4;
    if(as_dDebrief[p]==0) {return;}
    AS_Text(as_cDebPlace[p],p,as_levelTitle[as_level]+"  //  "+as_levelPlace[as_level]);
    AS_Text(as_cDebTime[p],p,AS_Clock(as_missionEnd-as_missionStart));
    AS_SetArt(as_cDebMap[p],p,"map"+IntToString(as_level));
    c0=StringToText("<c val=\"8CC8F0\">MARINE</c><n/>");c1="<c val=\"8CC8F0\">KILLS</c><n/>";c2="<c val=\"8CC8F0\">ACCURACY</c><n/>";
    c3="<c val=\"8CC8F0\">DAMAGE TAKEN</c><n/>";c4="<c val=\"8CC8F0\">DEATHS</c><n/>";
    for(q=1;q<=AS_PLAYERS;q+=1) {
        if(!AS_Person(q)) {continue;}
        acc=0;
        // Pellets and piercing shots can hit more than once a shot.
        if(as_shotsFired[q]>0) {acc=MinI(100,as_shotsHit[q]*100/as_shotsFired[q]);}
        // The names in the graph's colours, as AS lists its players.
        c0=c0+StringToText("<n/>")+TextWithColor(AS_MarineName(q),AS_SquadColour(q));
        c1=c1+"<n/>"+IntToString(as_kills[q]);
        c2=c2+"<n/>"+IntToString(acc)+"%";
        c3=c3+"<n/>"+IntToString(FixedToInt(as_dmgTaken[q]));
        c4=c4+"<n/>"+IntToString(as_deaths[q]);
    }
    DialogControlSetPropertyAsText(as_cDebCol[p][0],c_triggerControlPropertyText,AS_Me(p),c0);AS_Text(as_cDebCol[p][1],p,c1);AS_Text(as_cDebCol[p][2],p,c2);
    AS_Text(as_cDebCol[p][3],p,c3);AS_Text(as_cDebCol[p][4],p,c4);
    AS_Text(as_cDebNext[p],p,next);
    if(as_level+1<AS_LEVELS) {AS_Text(as_cDebFoot[p],p,"NEXT MISSION  //  "+as_levelTitle[as_level+1]);}
    else {AS_Text(as_cDebFoot[p],p,"CAMPAIGN COMPLETE");}
    AS_Show(as_cDebReady[p],p,as_level+1<AS_LEVELS);AS_Show(as_cDebReadyImg[p],p,as_level+1<AS_LEVELS);
    AS_DebriefGraph(p);
    DialogSetVisible(as_dDebriefBg[p],AS_Me(p),true);
    DialogSetVisible(as_dDebrief[p],AS_Me(p),true);
    AS_NameTagsHide(p);
}
