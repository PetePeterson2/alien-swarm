// =====================================================================
// AI marines, as Alien Swarm's own: the marines a lone player is given, or
// the host adds in the briefing. A bot follows the squad leader (the first
// living human) by the trail the leader leaves, or holds where it was told
// to (V / X); holds the platform when the squad boards the lift, stands on
// the transit platform at the end, shoots the nearest alien it can see,
// never hurts a squadmate, heals itself and, a medic, the squad; an AI tech
// walks over and hacks a panel or terminal a squadmate could not.
//
// Autopilot (build.py --auto): player 1 is driven too, along the mission's
// route (tools/cargo.py ROUTE), so a whole run plays itself for QA; every
// stage is written to the ASAuto bank (AS_Log).
// =====================================================================


// ---- the QA log -------------------------------------------------------
int as_botOffscreen;            // aliens in a bot's range it left alone because no player could see them (logged)
void AS_Log (string s) {
    bank b;string k;
    if(!as_qa && !as_auto) {return;}
    b=BankLoad("ASAuto",1);
    as_logN+=1;k=IntToString(1000+as_logN);
    BankValueSetFromString(b,"log",k,"t="+FixedToString(as_now,1)+" stage="+IntToString(as_stage)+" "+s);
    BankValueSetFromInt(b,"meta","lines",as_logN);
    BankValueSetFromString(b,"meta","run",as_runId);
    BankSave(b);
}
string AS_Where (int p) {
    point q;
    if(!AS_Person(p) || as_m[p]==null) {return "-";}
    q=UnitGetPosition(as_m[p]);
    return FixedToString(PointGetX(q),1)+","+FixedToString(PointGetY(q),1);
}
void AS_LogStatus () {
    int p;string s="status aliens="+IntToString(as_alive2)+" living="+IntToString(AS_Living())+" ride="+IntToString(as_ride)+" scroll="+FixedToString(as_scroll,1)+" offscreen="+IntToString(as_botOffscreen);
    for(p=1;p<=AS_PLAYERS;p+=1) {
        if(AS_Person(p)) {s=s+" p"+IntToString(p)+"@"+AS_Where(p)+"/hp"+IntToString(FixedToInt(as_hp[p]))+"/k"+IntToString(as_kills[p])+"/d"+IntToString(as_deaths[p]);}
    }
    AS_Log(s);
}

// ---- following --------------------------------------------------------
int AS_Leader () {
    int p;
    if(as_auto && as_alive[1]) {return 1;}
    for(p=1;p<=AS_PLAYERS;p+=1) {if(AS_Person(p) && !as_bot[p] && as_alive[p]) {return p;}}
    for(p=1;p<=AS_PLAYERS;p+=1) {if(AS_Person(p) && as_alive[p]) {return p;}}
    return 0;
}
void AS_CrumbPulse () {
    point q;
    as_leader=AS_Leader();
    if(as_leader==0 || as_tick%4!=0) {return;}
    q=UnitGetPosition(as_m[as_leader]);
    if(as_crumbHead>=0 && DistanceBetweenPoints(q,as_crumb[as_crumbHead])<0.9) {return;}
    as_crumbHead=(as_crumbHead+1)%48;as_crumb[as_crumbHead]=q;as_crumbN=MinI(48,as_crumbN+1);
}
// The newest point of the leader's trail this bot can walk straight to.
point AS_TrailPoint (point at0) {
    int k;int i;point c;
    for(k=0;k<as_crumbN;k+=1) {
        i=(as_crumbHead-k+48)%48;c=as_crumb[i];
        if(AS_LineClear(PointGetX(at0),PointGetY(at0),PointGetX(c),PointGetY(c))) {return c;}
    }
    return null;
}
// Spots for each marine on the lift and the transit platform, so the squad spreads out.
point AS_PostOf (int p, fixed x0, fixed y0, fixed x1, fixed y1) {
    fixed cx=(x0+x1)*0.5;fixed cy=(y0+y1)*0.5;
    return Point(cx-2.0+IntToFixed((p-1)%2)*4.0,cy-2.0+IntToFixed((p-1)/2)*4.0);
}
point AS_BotWay (point here, point to) {
    point t;fixed a=AngleBetweenPoints(here,to)+90.0;fixed ox=Cos(a)*0.3;fixed oy=Sin(a)*0.3;
    // Clear for the whole body: the line itself and one either side of it at the marine's radius.
    if(AS_LineClear(PointGetX(here),PointGetY(here),PointGetX(to),PointGetY(to))
       && AS_LineClear(PointGetX(here)+ox,PointGetY(here)+oy,PointGetX(to)+ox,PointGetY(to)+oy)
       && AS_LineClear(PointGetX(here)-ox,PointGetY(here)-oy,PointGetX(to)-ox,PointGetY(to)-oy)) {return to;}
    t=AS_TrailPoint(here);
    if(t==null) {return to;}
    return t;
}
point AS_BotGoal (int p) {
    point lq;point here=UnitGetPosition(as_m[p]);point tech;
    if(as_auto && p==1) {return AS_RouteGoal();}
    tech=AS_TechAiGoal(p);
    if(tech!=null) {return tech;}
    if(as_botOrder[p]==1 && as_botHoldAt[p]!=null) {
        if(DistanceBetweenPoints(here,as_botHoldAt[p])<0.6) {return null;}
        return as_botHoldAt[p];
    }
    if(as_leader==0 || as_leader==p) {return null;}
    lq=UnitGetPosition(as_m[as_leader]);
    // The leader through a seam: after it (AS_BotPulse sends the bot to the crossing).
    if(AS_PieceAt(PointGetX(here),PointGetY(here))!=AS_PieceAt(PointGetX(lq),PointGetY(lq))) {return lq;}
    // Everyone aboard: hold a spot on the platform until the ride is over.
    // A spot it can't walk straight to (round the drop's corner onto the bridge) is reached by the leader's trail first:
    // straight at it, a bot south of the bridge pinned itself against the drop for good (autopilot run, 2026-10-24).
    if((as_stage==AS_ST_BOARD && AS_InRect(lq,as_liftX0,as_liftY0,as_liftX1,as_liftY1)) || as_stage==AS_ST_RIDE) {
        return AS_BotWay(here,AS_PostOf(p,as_liftX0,as_liftY0,as_liftX1,as_liftY1));
    }
    if(as_stage==AS_ST_ESCAPE && AS_InRect(lq,as_extX0,as_extY0,as_extX1,as_extY1)) {return AS_BotWay(here,AS_PostOf(p,as_extX0,as_extY0,as_extX1,as_extY1));}
    if(DistanceBetweenPoints(here,lq)<2.6 && AS_LineClear(PointGetX(here),PointGetY(here),PointGetX(lq),PointGetY(lq))) {return null;}
    return AS_TrailPoint(here);
}
bool as_autoTask;                       // the autopilot is busy at a waypoint's job (a welder, a door)
// The watchdog on every leg: a waypoint not reached in 60 s is logged every 30 s with where the marine is, where it is
// going and the nearest door, so a stall names its cause; a plain leg (no job) still not done at 150 s ends with the
// marine set down on the waypoint, logged as forced (a fault to fix, but the run goes on). The hive jobs have their own
// (AS_HiveWatch); the other jobs wait on the level (a lift, a door's timer) and are only logged.
int as_awAt= -1;                        // the waypoint it is watching
fixed as_awSince;
fixed as_awLogAt;
void AS_AutoWatch (point here, point to) {
    int i;int best= -1;fixed bd=4.0;fixed d;string dr="none";
    if(as_routeAt!=as_awAt) {as_awAt=as_routeAt;as_awSince=as_now;as_awLogAt=as_now+60.0;return;}
    if(as_routeWait[as_routeAt]==0 && as_now-as_awSince>=150.0 && AS_Free(PointGetX(to),PointGetY(to),0.35)) {
        AS_Log("autopilot forced: set down on waypoint "+IntToString(as_routeAt+1)+" after 150 s, from "
            +FixedToString(PointGetX(here)-as_oxF,1)+","+FixedToString(PointGetY(here)-as_oyF,1));
        UnitSetPosition(as_m[1],to,false);as_mvX[1]=0.0;as_mvY[1]=0.0;as_botLast[1]=to;as_awSince=as_now;
        return;
    }
    if(as_now<as_awLogAt) {return;}
    as_awLogAt=as_now+30.0;
    for(i=0;i<as_drN;i+=1) {
        d=DistanceBetweenPoints(here,Point(AS_DoorCX(i),AS_DoorCY(i)));
        if(d<bd) {bd=d;best=i;}
    }
    if(best>=0) {
        dr="kind "+IntToString(as_drKind[best])+" "+FixedToString(bd,1)+" off, hp "+FixedToString(as_drHp[best],0)+", open "+FixedToString(as_drOpen[best],2);
        if(!AS_DoorCanOpen(best)) {dr=dr+", can't open";}
    }
    AS_Log("autopilot stalled: waypoint "+IntToString(as_routeAt+1)+" (wait "+IntToString(as_routeWait[as_routeAt])+"); marine at "
        +FixedToString(PointGetX(here)-as_oxF,1)+","+FixedToString(PointGetY(here)-as_oyF,1)+", "+FixedToString(DistanceBetweenPoints(here,to),1)+" off; nearest door "+dr);
}
point AS_RouteGoal () {
    point here=UnitGetPosition(as_m[1]);point to;
    AS_AutoMail();
    AS_AutoWipe();
    // Past the last waypoint, hold it: the swarm shoves an idle marine off the transit platform.
    to=Point(as_routeX[MinI(as_routeAt,as_routeN-1)],as_routeY[MinI(as_routeAt,as_routeN-1)]);
    if(as_routeAt>=as_routeN) {return to;}
    AS_AutoWatch(here,to);
    // Once at a waypoint with a job, stay on the job wherever it leads (a welder, a panel, a terminal).
    if(DistanceBetweenPoints(here,to)<0.9 || (as_routeWait[as_routeAt]>0 && as_autoTask)) {
        if(as_routeWait[as_routeAt]>0) {as_autoTask=true;}
        if(as_routeWait[as_routeAt]==1 && !AS_AutoGateDone()) {return AS_AutoGate();}
        if(as_routeWait[as_routeAt]==2 && as_ride<4) {return null;}
        if(as_routeWait[as_routeAt]==3 && !AS_AutoTankDone()) {return AS_AutoTank();}
        if(as_routeWait[as_routeAt]==4 && !AS_AutoDataDone()) {return AS_AutoData();}
        if(as_routeWait[as_routeAt]==5 && !AS_AutoButtonDone(to)) {return AS_AutoButton(to);}
        if(as_routeWait[as_routeAt]==6 && !AS_AutoWayOpen(to)) {return null;}
        if(as_routeWait[as_routeAt]==7 && !AS_AutoHiveDone(to)) {return AS_AutoHive(to);}
        as_extraHeld[1]=false;as_autoTask=false;
        as_routeAt+=1;AS_Log("route waypoint "+IntToString(as_routeAt)+"/"+IntToString(as_routeN));
        if(as_routeAt>=as_routeN) {return to;}
        to=Point(as_routeX[as_routeAt],as_routeY[as_routeAt]);
    }
    return to;
}

// ---- fighting ---------------------------------------------------------
// The squad's AI marines fight by AS's own AI rules (asw_marine.h, asw_marine_schedule.cpp), so
// they back the player up rather than clearing every room first:
//   sight       AS's 525 units (6.6 cells) following, 768 (9.6) holding, here 8 and 10: at AS's
//               own 6.6 the autopilot run lost all three in Cargo Elevator's lift lobby
//   aim error   4-14 degrees on each new target (AS: 5-20), x0.9 a think (0.1 s) while firing;
//               none at 1.5 cells, full from 4.5 (an uber drone in the lift lobby got in among
//               them and took all three)
//   turn        0.1-0.25 s onto a new target before the first shot, none inside 2.5 cells
//   ammo        the clips they carry; a dry one scrounges one clip every 20 s
// The autopilot's own marine (player 1 of an --auto run) stands in for a person and has none of this.
bool AS_BotFull (int p) {return as_auto && p==1;}
fixed AS_BotSight (int p) {
    if(AS_BotFull(p)) {return 11.0;}
    if(as_botOrder[p]==1) {return 10.0;}
    return 8.0;
}
int AS_BotFoe (int p) {
    int i=AS_AutoHiveFoe(p);int best= -1;fixed bd=AS_BotSight(p);fixed d;point here=UnitGetPosition(as_m[p]);point q;
    if(i>=0) {return i;}
    for(i=0;i<AS_MAXALIEN;i+=1) {
        if(as_a[i]==null || as_aKind[i]==AS_BIOMASS || as_aKind[i]==AS_BARREL) {continue;}
        if(as_aKind[i]==AS_EGG) {d=DistanceBetweenPoints(here,UnitGetPosition(as_a[i]))+4.0;}
        else {d=DistanceBetweenPoints(here,UnitGetPosition(as_a[i]));}
        if(d>=bd) {continue;}
        q=UnitGetPosition(as_a[i]);
        // Only what a player can see: nothing off the edge of every player's screen yet (AS's AI marines
        // fight what the squad is looking at; ours used to drop aliens the player never saw coming). One within
        // 3.5 cells of the bot is fought wherever the bot is: a marine below the screen's edge, or at a door the camera
        // is not on, meets a rush, but nothing is picked off before the player can see it.
        if(!AS_BotFull(p) && d>3.5 && !AS_OnScreen(q,0.35)) {as_botOffscreen+=1;continue;}
        if(!AS_LineClear(PointGetX(here),PointGetY(here),PointGetX(q),PointGetY(q))) {continue;}
        bd=d;best=i;
    }
    return best;
}
// The autopilot's marine shoots down an auto door dented shut in front of it, as a player would: below a third of its
// health a door never opens again (AS_DoorCanOpen), and the swarm massed behind SynTek Residential's Door10 held the
// route there for 1,400 s (run 8b762a2cecdf).
int AS_AutoDoorFoe (int p) {
    int i;point here=UnitGetPosition(as_m[p]);
    if(!(as_auto && p==1)) {return -1;}
    for(i=0;i<as_drN;i+=1) {
        if(as_drKind[i]!=0 || as_drBroken[i] || as_drLeaf[i]==null || !as_drShut[i] || as_drLocked[i] || as_drSeal[i]>0.0 || AS_DoorCanOpen(i)) {continue;}
        if(DistanceBetweenPoints(here,Point(AS_DoorCX(i),AS_DoorCY(i)))<3.0) {return i;}
    }
    return -1;
}
void AS_BotPulse (int p) {
    point here;point goal;fixed dx;fixed dy;fixed d;int q;point oq;fixed sx=0.0;fixed sy=0.0;int f;int was;fixed ang;int w;
    if(!as_bot[p] || !as_alive[p]) {return;}
    // The demo is player 1's firing range: the squad stands by and holds its fire.
    if(as_demo) {as_trigger[p]=false;as_botVX[p]=0.0;as_botVY[p]=0.0;return;}
    here=UnitGetPosition(as_m[p]);
    // The trail search is the costly part: once every four steps, each bot on its own step.
    if(as_tick%4==p%4 || as_botGoalPt[p]==null || (as_auto && p==1)) {as_botGoalPt[p]=AS_SeamWay(here,AS_BotGoal(p));}
    goal=as_botGoalPt[p];
    AS_BotCatchUp(p,here);
    as_botVX[p]=0.0;as_botVY[p]=0.0;
    if(goal!=null) {
        dx=PointGetX(goal)-PointGetX(here);dy=PointGetY(goal)-PointGetY(here);d=SquareRoot(dx*dx+dy*dy);
        if(d>0.35) {as_botVX[p]=dx/d;as_botVY[p]=dy/d;}
    }
    // Keep a little room from the rest of the squad.
    for(q=1;q<=AS_PLAYERS;q+=1) {
        if(q==p || !AS_Person(q) || !as_alive[q]) {continue;}
        oq=UnitGetPosition(as_m[q]);d=DistanceBetweenPoints(here,oq);
        if(d<0.9 && d>0.01) {sx+=(PointGetX(here)-PointGetX(oq))/d*(0.9-d);sy+=(PointGetY(here)-PointGetY(oq))/d*(0.9-d);}
    }
    as_botVX[p]+=sx*1.5;as_botVY[p]+=sy*1.5;
    // Pick a target a few times a second; shoot while it is in sight.
    if(as_now>=as_botNextLook[p]) {
        was=as_botFoe[p];as_botNextLook[p]=as_now+0.25;as_botFoe[p]=AS_BotFoe(p);
        if(as_botFoe[p]>=0 && as_botFoe[p]!=was && !AS_BotFull(p)) {
            as_botAimErr[p]=RandomFixed(4.0,14.0);if(RandomInt(0,1)==0) {as_botAimErr[p]= -as_botAimErr[p];}
            as_botFireAt[p]=as_now+RandomFixed(0.1,0.25);
        }
    }
    f=as_botFoe[p];
    if(f>=0 && as_a[f]!=null) {
        oq=UnitGetPosition(as_a[f]);
        dx=PointGetX(oq)-PointGetX(here);dy=PointGetY(oq)-PointGetY(here);
        if(AS_BotFull(p)) {as_botAimErr[p]=0.0;as_botFireAt[p]=0.0;}
        d=SquareRoot(dx*dx+dy*dy);ang=ATan2(dy,dx)+as_botAimErr[p]*MinF(1.0,MaxF(0.0,(d-1.5)/3.0));
        as_mouseDX[p]=Cos(ang)*d;as_mouseDY[p]=Sin(ang)*d;as_trigger[p]=as_now>=as_botFireAt[p] || d<2.5;
        // AS closes the error by a tenth a 0.1 s think; this loop steps every 1/16 s.
        if(as_trigger[p]) {as_botAimErr[p]*=0.936;}
    }
    else if(AS_AutoDoorFoe(p)>=0) {
        f=AS_AutoDoorFoe(p);
        if(as_hand[p]!=0) {AS_SelectHand(p,0);}
        as_mouseDX[p]=AS_DoorCX(f)-PointGetX(here);as_mouseDY[p]=AS_DoorCY(f)-PointGetY(here);as_trigger[p]=true;
    }
    else {
        as_trigger[p]=false;
        if(as_botVX[p]*as_botVX[p]+as_botVY[p]*as_botVY[p]>0.1) {as_mouseDX[p]=as_botVX[p]*4.0;as_mouseDY[p]=as_botVY[p]*4.0;}
    }
    as_mouseSeen[p]=true;
    if(as_auto && p==1 && as_extraHeld[1]) {as_trigger[p]=false;}
    // A gun in hand, never a deployable; they shoot what they carry, and they patch themselves (and the squad) up.
    if(as_slot[p]<=0 || AS_IsDeployable(as_slot[p]) || as_slot[p]==AS_IT_HEALGUN || as_slot[p]==AS_IT_CHAINSAW) {
        if(as_inv[p][1-as_hand[p]]>0 && !AS_IsDeployable(as_inv[p][1-as_hand[p]]) && as_inv[p][1-as_hand[p]]!=AS_IT_HEALGUN) {AS_SelectHand(p,1-as_hand[p]);}
    }
    w=as_slot[p];
    if(w>0 && !AS_IsDeployable(w)) {
        if(AS_BotFull(p)) {if(as_reserve[p][w]<as_it[w].mag) {as_reserve[p][w]=as_it[w].reserve;}}
        else if(as_mag[p][w]<=0 && as_reserve[p][w]<=0) {
            if(as_botDryAt[p]==0.0) {as_botDryAt[p]=as_now+20.0;AS_Log("bot "+IntToString(p)+" dry: "+as_it[w].title);}
            else if(as_now>=as_botDryAt[p]) {as_botDryAt[p]=0.0;as_reserve[p][w]=as_it[w].mag;AS_Log("bot "+IntToString(p)+" scrounged a clip");}
        }
        else {as_botDryAt[p]=0.0;}
    }
    if((as_hp[p]<as_hpMax[p]*0.45 || as_infestUntil[p]>as_now) && as_inv[p][2]==AS_IT_MEDKIT && as_charges[p]>0) {AS_UseExtra(p);}
    if(as_tick%16==p) {AS_BotMedic(p);}
}
// An AI medic drops a heal beacon among two or more hurt squadmates (or one infested one) near it.
void AS_BotMedic (int p) {
    int q;int hurt=0;point here=UnitGetPosition(as_m[p]);int w=AS_IT_HEALBEACON;
    if(AS_Class(p)!=AS_CL_MEDIC || !AS_HasItem(p,w) || as_mag[p][w]<=0 || AS_FieldBusy(p)) {return;}
    for(q=1;q<=AS_PLAYERS;q+=1) {
        if(!AS_Person(q) || !as_alive[q] || DistanceBetweenPoints(UnitGetPosition(as_m[q]),here)>3.0) {continue;}
        if(as_infestUntil[q]>as_now) {hurt+=2;}
        else if(as_hp[q]<as_hpMax[q]*0.6) {hurt+=1;}
    }
    if(hurt<2) {return;}
    as_mag[p][w]-=1;AS_FieldStart(p,0,PointGetX(here),PointGetY(here));
    AS_Log("bot "+IntToString(p)+" heal beacon");
}
bool AS_FieldBusy (int p) {return false;}

// ---- chatter (asw_marine_speech.cpp) --------------------------------------------------------
// AS's 124 spoken lines become a short line of text over the marine. One line at a time for the squad, the next
// no sooner than this one would take to say (21-23); firing on the swarm, running dry and the spotting lines wait
// 30 s to come again, friendly fire 12 s (373-378, 468-480, 671-676), a drone in a marine's face 10 to 30 s.
fixed as_chatNext;
fixed[16] as_chatCool;
fixed[5] as_chatPainAt;
fixed[5] as_chatStillAt;
point[5] as_chatStillPt;
fixed as_chatIdleAt;
fixed as_chatDownAt;
int as_chatDownBy;
// The lines of each kind and each marine's voice clip of them (tools/barks.py; build.py writes them here):
// AS_ChatCount, AS_ChatKey, AS_ChatLine(k, r), as_barkLen[profile][k][r] (0: not voiced) and AS_BarkInit.
@BARKS@
void AS_Chatter (int p, int k) {
    string line;int r;fixed secs=0.0;
    if(p<1 || p>AS_PLAYERS || !AS_Person(p) || as_m[p]==null || !as_levelReady || AS_MissionOver() || as_demo) {return;}
    if(!as_alive[p] && k!=AS_CH_DIE) {return;}
    if(k!=AS_CH_DIE && (as_now<as_chatNext || as_now<as_chatCool[k])) {return;}
    // Chances (asw_marine_profile.cpp 454-460): holding 20%, healing 50%.
    if(k==AS_CH_HOLD && RandomInt(1,5)!=1) {return;}
    if(k==AS_CH_HEALING && RandomInt(0,1)==0) {return;}
    if(!as_barkReady) {AS_BarkInit();}
    r=RandomInt(0,AS_ChatCount(k)-1);
    line=AS_ChatLine(k,r);
    if(as_prof[p]>=0) {secs=as_barkLen[as_prof[p]][k][r];}
    // The next line waits for this one to be said: its clip, or the time to read it.
    if(k!=AS_CH_DIE) {as_chatNext=as_now+MaxF(1.0+0.06*IntToFixed(StringLength(line)),secs+0.4);}
    if(k==AS_CH_FF) {as_chatCool[k]=as_now+12.0;}
    else if(k==AS_CH_FIRING || k==AS_CH_NOAMMO || k==AS_CH_SHIELDBUG || k==AS_CH_PARASITE || k==AS_CH_EGGS) {as_chatCool[k]=as_now+30.0;}
    else if(k==AS_CH_CLOSE) {as_chatCool[k]=as_now+RandomFixed(10.0,30.0);}
    else if(k==AS_CH_HEALING) {as_chatCool[k]=as_now+8.0;}
    TextTagCreate(StringToText("<c val=\"C8E6FF\">"+line+"</c>"),18,UnitGetPosition(as_m[p]),2.3,true,false,PlayerGroupAll());
    TextTagSetTextShadow(TextTagLastCreated(),true);TextTagAttachToUnit(TextTagLastCreated(),as_m[p],2.3);
    TextTagSetTime(TextTagLastCreated(),c_textTagTimeDuration,MaxF(2.2,secs+0.5));TextTagSetTime(TextTagLastCreated(),c_textTagTimeFadeOut,0.5);
    // The marine says it, in its own voice, to the whole squad.
    if(secs>0.0) {SoundPlay(SoundLink("ASBark_"+as_pfFace[as_prof[p]]+"_"+AS_ChatKey(k)+"_"+IntToString(r),-1),PlayerGroupAll(),100.0,0.0);}
    if(as_auto) {AS_Log("chatter p"+IntToString(p)+": "+line+" ("+FixedToString(secs,2)+" s voiced)");}
}
// Pain: the big line past 35 damage, at most every 0.7 s a marine (asw_marine.cpp 1451, 1466-1474).
void AS_ChatPain (int p, fixed dmg) {
    if(as_now-as_chatPainAt[p]<0.7) {return;}
    as_chatPainAt[p]=as_now;
    if(dmg>35.0) {AS_Chatter(p,AS_CH_PAINBIG);}else {AS_Chatter(p,AS_CH_PAIN);}
}
// Reloading is only called with the swarm about (asw_weapon_shared.cpp 739-742).
void AS_ChatReload (int p) {
    int i;point here=UnitGetPosition(as_m[p]);
    for(i=0;i<AS_MAXALIEN;i+=1) {
        if(as_a[i]!=null && !AS_IsThing(as_aKind[i]) && DistanceBetweenPoints(here,Point(as_aX[i],as_aY[i]))<8.0) {AS_Chatter(p,AS_CH_RELOAD);return;}
    }
}
// A marine falls: its last line, and 0.5 to 1.5 s on the nearest squadmate calls it (asw_marine.cpp 3321, 3381, 3391).
void AS_ChatDied (int p) {
    int q;fixed bd=1000.0;fixed d;point here=UnitGetPosition(as_m[p]);
    AS_Chatter(p,AS_CH_DIE);
    as_chatDownBy=0;
    for(q=1;q<=AS_PLAYERS;q+=1) {
        if(q==p || !AS_Person(q) || !as_alive[q] || as_m[q]==null) {continue;}
        d=DistanceBetweenPoints(here,UnitGetPosition(as_m[q]));
        if(d<bd) {bd=d;as_chatDownBy=q;}
    }
    as_chatDownAt=as_now+RandomFixed(0.5,1.5);
}
// Four times a second: the lines nothing else calls. Firing on the swarm, a drone in a marine's face, a shieldbug,
// parasites or eggs in sight (eggs within 500 units), and after 20 to 30 s standing still, 15 to 25 s since the last
// idle line, a word to the squad (asw_marine.cpp 1620-1667, 2015-2077; asw_drone_advanced.cpp 1555-1564;
// asw_shieldbug.cpp 931; asw_parasite.cpp 1243; asw_egg.cpp 261-268).
void AS_ChatterPulse () {
    int p;int i;point here;fixed d;bool fight=false;
    if(!as_levelReady || AS_MissionOver()) {return;}
    if(as_chatDownBy>0 && as_now>=as_chatDownAt) {AS_Chatter(as_chatDownBy,AS_CH_DOWN);as_chatDownBy=0;}
    for(p=1;p<=AS_PLAYERS;p+=1) {
        if(!AS_Person(p) || !as_alive[p] || as_m[p]==null) {continue;}
        here=UnitGetPosition(as_m[p]);
        for(i=0;i<AS_MAXALIEN;i+=1) {
            if(as_a[i]==null || AS_IsThing(as_aKind[i])) {continue;}
            d=DistanceBetweenPoints(here,Point(as_aX[i],as_aY[i]));
            if(d>8.0) {continue;}
            fight=true;
            if(as_aKind[i]==AS_EGG) {if(d<6.25 && as_now>=as_chatCool[AS_CH_EGGS] && AS_LineClear(PointGetX(here),PointGetY(here),as_aX[i],as_aY[i])) {AS_Chatter(p,AS_CH_EGGS);}continue;}
            if((as_aKind[i]==AS_DRONE || as_aKind[i]==AS_RIPPER || as_aKind[i]==AS_UBER) && d<1.5) {AS_Chatter(p,AS_CH_CLOSE);}
            if(as_aKind[i]==AS_SHIELDBUG && as_now>=as_chatCool[AS_CH_SHIELDBUG] && AS_LineClear(PointGetX(here),PointGetY(here),as_aX[i],as_aY[i])) {AS_Chatter(p,AS_CH_SHIELDBUG);}
            if((as_aKind[i]==AS_PARASITE || as_aKind[i]==AS_XENOMITE) && as_now>=as_chatCool[AS_CH_PARASITE] && AS_LineClear(PointGetX(here),PointGetY(here),as_aX[i],as_aY[i])) {AS_Chatter(p,AS_CH_PARASITE);}
        }
        if(fight && as_trigger[p] && as_now-as_lastShot[p]<0.3) {AS_Chatter(p,AS_CH_FIRING);}
        if(as_chatStillPt[p]==null || DistanceBetweenPoints(here,as_chatStillPt[p])>0.5 || fight) {as_chatStillPt[p]=here;as_chatStillAt[p]=as_now+RandomFixed(20.0,30.0);}
        else if(as_now>=as_chatStillAt[p] && as_now>=as_chatIdleAt) {
            as_chatStillAt[p]=as_now+RandomFixed(20.0,30.0);as_chatIdleAt=as_now+RandomFixed(15.0,25.0);
            AS_Chatter(p,AS_CH_IDLE);
        }
    }
}

// ---- the autopilot's jobs on Landing Bay ---------------------------------------------
bool AS_AutoBusy () {return as_extraHeld[1];}
// A door panel's hack: the autopilot stands at it until the door is open, rather than leaving it to whichever bot
// happens to stand close enough.
bool AS_AutoGateDone () {
    int d;
    if(as_level>=AS_LV_SCRIPT) {d=AS_AutoGateDoor();return d<0 || !as_drLocked[d];}
    return as_bayStage>=1;
}
// The door panel the waypoint is for: Landing Bay's east gate panel; on a scripted mission the panel nearest the
// waypoint (within ten).
int AS_AutoGateDoor () {
    int i;int best= -1;fixed bd=10.0;fixed d;point to=Point(as_routeX[MinI(as_routeAt,as_routeN-1)],as_routeY[MinI(as_routeAt,as_routeN-1)]);
    if(as_level==AS_LV_BAY) {return AS_DoorNamed("gate_east");}
    for(i=0;i<as_drN;i+=1) {
        if(as_drPanelX[i]<=0.0) {continue;}
        d=DistanceBetweenPoints(to,Point(as_drPanelX[i],as_drPanelY[i]));
        if(d<bd) {bd=d;best=i;}
    }
    return best;
}
// A button by the waypoint (within eight): walk over and press it.
int AS_AutoButtonAt (point to) {
    int i;int best= -1;fixed bd=8.0;fixed d;
    for(i=0;i<as_btN;i+=1) {
        d=DistanceBetweenPoints(to,Point(as_btX[i],as_btY[i]));
        if(d<bd) {bd=d;best=i;}
    }
    return best;
}
bool AS_AutoButtonDone (point to) {
    int i=AS_AutoButtonAt(to);
    return i<0 || as_btDone[i];
}
point AS_AutoButton (point to) {
    int i=AS_AutoButtonAt(to);point bp;
    if(i<0) {return null;}
    bp=Point(as_btX[i],as_btY[i]);
    if(DistanceBetweenPoints(UnitGetPosition(as_m[1]),bp)>1.2) {return bp;}
    if(!as_btOn[i]) {return null;}
    AS_ButtonPress(1,i);
    return null;
}
// Hold at the waypoint until the door, gap or ramp nearest it (within six) is open.
bool AS_AutoWayOpen (point to) {
    int i;int best= -1;fixed bd=6.0;fixed d;
    for(i=0;i<as_drN;i+=1) {
        d=DistanceBetweenPoints(to,Point(AS_DoorCX(i),AS_DoorCY(i)));
        if(d<bd) {bd=d;best=i;}
    }
    return best<0 || !as_drShut[best];
}
// At the gate: the autopilot's marine works the east panel itself when it is the tech (the briefing test
// picks Crash), through the same tiles a player clicks; otherwise the squad's tech is sent.
fixed as_autoClickAt;
int as_autoWireClicks;
point AS_AutoGate () {
    int d=AS_AutoGateDoor();point pp;
    if(as_level!=AS_LV_BAY && as_level<AS_LV_SCRIPT) {return as_doorPanel;}
    if(d<0) {return null;}
    if(!AS_IsTech(1)) {
        if(as_aiHackTech==0 && as_drLocked[d]) {AS_OrderTechHack(1,AS_USE_PANEL,d);}
        return null;
    }
    pp=Point(as_drPanelX[d],as_drPanelY[d]);
    if(as_using[1]!=d) {
        if(DistanceBetweenPoints(UnitGetPosition(as_m[1]),pp)>1.3) {return pp;}
        AS_UseStart(1,AS_USE_PANEL,d);
        return null;
    }
    if(as_now>=as_autoClickAt) {
        as_autoClickAt=as_now+0.2;AS_AutoWireClick(d);
        as_autoWireClicks+=1;if(as_autoWireClicks==3) {AS_UiDump("wire",1);}
    }
    return null;
}
// One click toward a solution: the first tile of an unlit wire that is not yet turned the way the path needs.
int[72] as_autoWtGoal;
void AS_AutoWireClick (int d) {
    int w;int i;
    for(w=0;w<as_wtWires[d];w+=1) {
        if(AS_WtWireLit(d,w)) {continue;}
        for(i=0;i<72;i+=1) {as_autoWtGoal[i]= -1;}
        if(!AS_AutoWtSolve(d,w,0,0,3,0)) {AS_Log("autopilot: wire "+IntToString(w)+" has no solution");return;}
        for(i=w*24;i<w*24+24;i+=1) {
            if(as_autoWtGoal[i]>=0 && as_wtRot[d][i]!=as_autoWtGoal[i]) {AS_WireClickTile(1,i);return;}
        }
    }
}
// Depth first along the wire: entering tile (r,c) from side `from` (0 N, 1 E, 2 S, 3 W), the turn that carries
// the path on to the east socket of the last tile.
bool AS_AutoWtSolve (int d, int w, int r, int c, int from, int seen) {
    int i=AS_WtAt(w,r,c);int t=as_wtType[d][i];int rot;int s;int nr;int nc;int bit=1<<(r*8+c);
    for(rot=0;rot<4;rot+=1) {
        if(!AS_WtConn(t,rot,from)) {continue;}
        for(s=0;s<4;s+=1) {
            if(s==from || !AS_WtConn(t,rot,s)) {continue;}
            if(r==as_wtRows[d]-1 && c==as_wtCols[d]-1 && s==1) {as_autoWtGoal[i]=rot;return true;}
            nr=r;nc=c;
            if(s==0) {nr=r-1;}else if(s==2) {nr=r+1;}else if(s==1) {nc=c+1;}else {nc=c-1;}
            if(nr<0 || nc<0 || nr>=as_wtRows[d] || nc>=as_wtCols[d] || (seen&(1<<(nr*8+nc)))!=0) {continue;}
            if(AS_AutoWtSolve(d,w,nr,nc,(s+2)%4,seen|bit)) {as_autoWtGoal[i]=rot;return true;}
        }
    }
    return false;
}
// The tumblers, while they rest between slides: each column moves against column 0 until it shares its row,
// then with it.
void AS_AutoTumblers (int i) {
    int k;int d0;int want;int delta;
    if(as_tbPhase[i]!=0 || as_cpHacked[i] || as_now<as_autoClickAt) {return;}
    as_autoClickAt=as_now+0.2;
    d0=AS_TbDirNow(i,0);
    for(k=1;k<as_cpTumblers[i];k+=1) {
        delta=(AS_TbRow(i,k)-AS_TbRow(i,0)+as_cpEntries[i])%as_cpEntries[i];
        want= -d0;if(delta==0) {want=d0;}
        if(AS_TbDirNow(i,k)!=want) {AS_TumblerClick(1,i,k);}
    }
}
// --wipe: 15 s into the first Landing Bay the squad's tech (the autopilot's marine) dies, which restarts the
// mission; the second time the whole squad dies (MISSION FAILED); the third plays through.
int as_autoWipeStep;
fixed as_autoWipeRun= -1.0;
void AS_AutoWipe () {
    int q;fixed x;fixed y;
    if(!as_autoWipe || as_level!=AS_LV_BAY || as_autoWipeStep>=2 || as_autoWipeRun==as_missionStart || as_now-as_missionStart<15.0) {return;}
    as_autoWipeRun=as_missionStart;
    for(q=1;q<=AS_PLAYERS;q+=1) {
        if(!AS_Person(q) || !as_alive[q] || (as_autoWipeStep==0 && q!=1)) {continue;}
        as_god[q]=false;x=PointGetX(UnitGetPosition(as_m[q]));y=PointGetY(UnitGetPosition(as_m[q]));
        AS_HurtMarineBy(q,1000.0,x,y,0.0,2,0);
    }
    if(as_autoWipeStep==0) {AS_Log("wipe test: the tech is down");}else {AS_Log("wipe test: the squad is down");}
    as_autoWipeStep+=1;
}
// Once, early in the first Landing Bay: every key and button a player has, through the functions the input
// triggers call (src/Main.galaxy), with what each changed written to the log.
bool as_autoInputDone;
string AS_AutoHands (int p) {
    string s=as_it[as_inv[p][0]].title+" / "+as_it[as_inv[p][1]].title+" in hand "+IntToString(as_hand[p]);
    if(as_slot[p]>0) {s=s+" ("+as_it[as_slot[p]].title+" "+IntToString(as_mag[p][as_slot[p]])+"+"+IntToString(as_reserve[p][as_slot[p]])+")";}
    return s;
}
bool AS_AutoInputT (bool testConds, bool runActions) {
    int p=1;int before;
    AS_Log("input test: start, "+AS_AutoHands(p));
    AS_UiDump("hud",p);
    AS_MouseDown(p,c_mouseButtonLeft);Wait(0.4,c_timeGame);AS_MouseUp(p,c_mouseButtonLeft);
    AS_Log("input test: left mouse held 0.4 s, "+AS_AutoHands(p));
    AS_KeyDown(p,c_keyR,false);AS_KeyUp(p,c_keyR);
    AS_Log("input test: R, reloading "+IntToString(BoolToInt(as_reloadEnd[p]>0.0)));
    Wait(3.0,c_timeGame);
    AS_Log("input test: after reload, "+AS_AutoHands(p));
    AS_KeyDown(p,c_keyQ,false);AS_KeyUp(p,c_keyQ);AS_Log("input test: Q, "+AS_AutoHands(p));
    Wait(0.3,c_timeGame);
    AS_Wheel(p,-1.0);AS_Log("input test: wheel out, zoom "+FixedToString(as_zoom[p],2));
    AS_Wheel(p,1.0);AS_Log("input test: wheel in, zoom "+FixedToString(as_zoom[p],2));
    before=as_mag[p][as_slot[p]];
    AS_MouseDown(p,c_mouseButtonRight);AS_MouseUp(p,c_mouseButtonRight);AS_Log("input test: right mouse (melee)");
    Wait(0.6,c_timeGame);
    AS_MouseDown(p,c_mouseButtonMiddle);AS_MouseUp(p,c_mouseButtonMiddle);
    AS_KeyDown(p,c_keyF,false);AS_KeyUp(p,c_keyF);AS_Log("input test: middle mouse and F (alt fire), "+AS_AutoHands(p));
    Wait(0.6,c_timeGame);
    AS_KeyDown(p,c_keySpace,false);AS_KeyUp(p,c_keySpace);AS_Log("input test: space (roll)");
    Wait(1.0,c_timeGame);
    AS_KeyDown(p,c_keyG,false);AS_KeyUp(p,c_keyG);AS_Log("input test: G (drop), "+AS_AutoHands(p));
    Wait(0.3,c_timeGame);
    AS_KeyDown(p,c_keyE,false);AS_KeyUp(p,c_keyE);AS_Log("input test: E (pick up), "+AS_AutoHands(p));
    AS_KeyDown(p,c_key1,false);Wait(0.3,c_timeGame);AS_KeyUp(p,c_key1);AS_Log("input test: 1 held (offhand: "+as_it[as_inv[p][2]].title+")");
    AS_KeyDown(p,c_keyTab,false);Wait(0.5,c_timeGame);AS_UiDump("fullmap",p);AS_KeyDown(p,c_keyTab,false);AS_Log("input test: Tab twice (map)");
    AS_KeyDown(p,c_keyH,false);Wait(0.5,c_timeGame);AS_UiDump("help",p);AS_KeyDown(p,c_keyH,false);AS_Log("input test: H twice (help)");
    AS_KeyDown(p,c_keyC,false);Wait(0.5,c_timeGame);AS_KeyDown(p,c_keyC,false);AS_Log("input test: C twice (camera)");
    AS_KeyDown(p,c_keyN,false);AS_KeyDown(p,c_keyN,false);
    AS_KeyDown(p,c_keyX,false);AS_Log("input test: X, bot 2 order "+IntToString(as_botOrder[2]));
    AS_KeyDown(p,c_keyV,false);AS_Log("input test: V, bot 2 order "+IntToString(as_botOrder[2]));
    AS_KeyDown(p,c_keyW,false);Wait(0.25,c_timeGame);AS_KeyUp(p,c_keyW);
    AS_KeyDown(p,c_keyF2,false);AS_Log("input test: F2, now "+AS_MarineNameS(p));
    Wait(0.5,c_timeGame);
    AS_KeyDown(p,c_keyF1,false);AS_Log("input test: F1, now "+AS_MarineNameS(p));
    AS_Log("input test: done, "+AS_AutoHands(p));
    return true;
}
// Early in Landing Bay the autopilot opens a PDA's mail for two seconds: the terminal's mail page.
int as_autoMailStep;
bool as_autoShotMail;
fixed as_autoMailRun;
fixed as_autoMailAt;
void AS_AutoMail () {
    int i;
    if(!as_auto || as_level!=AS_LV_BAY) {return;}
    if(as_autoMailRun!=as_missionStart) {as_autoMailRun=as_missionStart;as_autoMailStep=0;}
    if(as_autoMailStep==0 && as_now-as_missionStart>4.0 && as_using[1]<0) {
        for(i=0;i<as_cpN;i+=1) {
            if(as_cpPda[i]) {AS_UseStart(1,AS_USE_PDA,i);as_autoMailStep=1;as_autoMailAt=as_now;AS_Log("ui test: mail open, "+as_cpOwner[i]);return;}
        }
        as_autoMailStep=2;
    }
    if(as_autoMailStep==1 && !as_autoShotMail && as_now>as_autoMailAt+1.0) {as_autoShotMail=true;AS_UiDump("mail",1);}
    if(as_autoMailStep==1 && as_now>as_autoMailAt+2.0) {
        if(as_using[1]>=0) {AS_UseStop(1);}
        as_autoMailStep=2;AS_Log("ui test: mail closed");
    }
    if(!as_autoInputDone && as_level==AS_LV_BAY && as_autoMailStep==2) {as_autoInputDone=true;TriggerExecute(TriggerCreate("AS_AutoInputT"),false,false);}
}
bool AS_AutoTankDone () {
    int d=AS_DoorNamed("tank_s");
    if(as_level!=AS_LV_BAY || d<0) {return true;}
    return as_drSeal[d]<=0.0;
}
// The tank room door: fetch a welder from the bench, then cut the door facing it.
point AS_AutoTank () {
    int i;int best= -1;fixed bd=100.0;fixed dd;point here=UnitGetPosition(as_m[1]);int d=AS_DoorNamed("tank_s");
    if(as_inv[1][2]!=AS_IT_WELDER) {
        for(i=0;i<AS_DROPS;i+=1) {
            if(as_drop[i]==null || as_dropItem[i]!=AS_IT_WELDER) {continue;}
            dd=DistanceBetweenPoints(UnitGetPosition(as_drop[i]),here);
            if(dd<bd) {bd=dd;best=i;}
        }
        if(best<0) {return null;}
        if(bd<1.0) {AS_PickUp(1,best);return null;}
        return UnitGetPosition(as_drop[best]);
    }
    if(DistanceBetweenPoints(here,Point(AS_DoorCX(d)+1.2,AS_DoorCY(d)))>0.5) {as_extraHeld[1]=false;return Point(AS_DoorCX(d)+1.2,AS_DoorCY(d));}
    as_mouseDX[1]= -4.0;as_mouseDY[1]=0.0;as_aim[1]=180.0;
    if(!as_extraHeld[1]) {as_extraHeld[1]=true;AS_WelderStart(1);as_weldDir[1]= -1;}
    return null;
}
bool AS_AutoDataDone () {
    int d=AS_DoorNamed("control");
    if(as_level!=AS_LV_BAY) {return true;}
    return as_objState[1]==2 && (d<0 || as_drBroken[d]);
}
bool as_autoShotTumb;
bool as_autoShotDl;
// The terminal: the autopilot's tech hacks it and downloads the data at the screen; otherwise the squad's tech is sent.
point AS_AutoData () {
    int i=as_bayComputer;point pp;
    if(as_cpN<=0) {return null;}
    // Not a tech: the squad's tech hacks it; once it is hacked anyone may download (at half speed).
    if(!AS_IsTech(1) && !as_cpHacked[i]) {
        if(as_aiHackTech==0) {AS_OrderTechHack(1,AS_USE_TERMINAL,i);}
        return null;
    }
    if(as_aiHackTech>0 && as_cpHacked[i]) {return null;}
    if(as_cpDone[i]>=1.0) {return null;}
    pp=Point(as_tmX[i],as_tmY[i]);
    if(as_using[1]!=i) {
        if(DistanceBetweenPoints(UnitGetPosition(as_m[1]),pp)>1.3) {return pp;}
        AS_UseStart(1,AS_USE_TERMINAL,i);
        return null;
    }
    if(!as_cpHacked[i]) {
        if(!as_autoShotTumb) {as_autoShotTumb=true;AS_UiDump("tumblers",1);}
        AS_AutoTumblers(i);
    }
    else if(!as_autoShotDl && as_cpDone[i]>0.4) {as_autoShotDl=true;AS_UiDump("download",1);}
    return null;
}
// The autopilot's marine 1 is driven by the script; AI marines are added in the briefing (src/Briefing.galaxy).
void AS_BotsInit () {
    if(as_auto) {as_bot[1]=true;}
    as_botCount=0;
}
// A bot left far behind or wedged on a corner rejoins the leader, but only where no human sees it go.
// Whether q is on some player's screen, at least `margin` inside its edges: the top-down view's footprint on
// the deck round the point the camera centres on (src/Marine.galaxy AS_VIEW_*), or ahead of a third-person
// camera. The bottom edge looks down at the deck, so an alien's body shows there before its feet do: no margin.
bool AS_OnScreen (point q, fixed margin) {
    int h;point c;fixed d;fixed dx;fixed dy;unit u;
    for(h=1;h<=AS_PLAYERS;h+=1) {
        if(!AS_Person(h) || (as_bot[h] && !(as_auto && h==1))) {continue;}
        u=AS_ViewUnit(h);
        if(u==null) {continue;}
        if(as_view[h]==1) {
            c=UnitGetPosition(u);
            if(DistanceBetweenPoints(c,q)<12.0 && AbsF(AS_AngleDiff(AngleBetweenPoints(c,q),CameraGetYaw(h)))<40.0) {return true;}
            continue;
        }
        if(as_camUnit[h]!=null) {u=as_camUnit[h];}
        c=UnitGetPosition(u);d=AS_TopDist(h);
        dx=PointGetX(q)-PointGetX(c);dy=PointGetY(q)-PointGetY(c);
        if(AbsF(dx)<AS_VIEW_X*d-margin && dy<AS_VIEW_N*d-margin && dy>0.0-AS_VIEW_S*d) {return true;}
    }
    return false;
}
// The autopilot leads, so nobody's trail can fetch it: pinned on a corner for 4 s with somewhere to go, it steps
// to the free spot within a cell that is nearest its goal, and logs where it was caught (autopilot runs, 2026-10-24).
void AS_AutoUnstick (point here) {
    point goal=as_botGoalPt[1];point best=null;point q;fixed bd=1000.0;fixed d;int k;int r;string fr="inside a wall";
    if(as_botLast[1]==null || DistanceBetweenPoints(here,as_botLast[1])>0.3) {as_botLast[1]=here;as_botStuckAt[1]=as_now;return;}
    if(goal==null || as_using[1]>=0 || as_stage==AS_ST_RIDE || DistanceBetweenPoints(here,goal)<1.0) {as_botStuckAt[1]=as_now;return;}
    if(as_now-as_botStuckAt[1]<4.0) {return;}
    for(r=1;r<=4;r+=1) {
        for(k=0;k<16;k+=1) {
            q=PointWithOffsetPolar(here,0.25*IntToFixed(r),22.5*IntToFixed(k));
            d=DistanceBetweenPoints(q,goal);
            if(d<bd && AS_Free(PointGetX(q),PointGetY(q),AS_MARINE_R+0.05)) {bd=d;best=q;}
        }
    }
    as_botStuckAt[1]=as_now;
    if(AS_Free(PointGetX(here),PointGetY(here),AS_MARINE_R)) {fr="free";}
    AS_Log("autopilot pinned at "+FixedToString(PointGetX(here)-as_oxF,3)+","+FixedToString(PointGetY(here)-as_oyF,3)+" ("+fr+"), waypoint "+IntToString(as_routeAt+1));
    if(best==null) {return;}
    UnitSetPosition(as_m[1],best,false);as_mvX[1]=0.0;as_mvY[1]=0.0;as_botLast[1]=best;
}
bool AS_HumanSees (point q) {
    int h;point hq;
    for(h=1;h<=AS_PLAYERS;h+=1) {
        if(!AS_Person(h) || (as_bot[h] && !(as_auto && h==1)) || !as_alive[h]) {continue;}
        hq=UnitGetPosition(as_m[h]);
        if(DistanceBetweenPoints(hq,q)<15.0) {return true;}
    }
    return false;
}
void AS_BotCatchUp (int p, point here) {
    point lq;point to;bool far;
    if(as_auto && p==1) {AS_AutoUnstick(here);return;}
    if(as_leader==0 || as_leader==p || as_stage==AS_ST_RIDE) {as_botStuckAt[p]=as_now;return;}
    if(as_botLast[p]==null || DistanceBetweenPoints(here,as_botLast[p])>0.5) {as_botLast[p]=here;as_botStuckAt[p]=as_now;}
    lq=UnitGetPosition(as_m[as_leader]);
    far=DistanceBetweenPoints(here,lq)>22.0;
    if(!far && (as_now-as_botStuckAt[p]<6.0 || DistanceBetweenPoints(here,lq)<4.0)) {return;}
    if(as_crumbN<4) {return;}
    // A point a few steps back along the leader's trail, out of every human's sight.
    to=as_crumb[(as_crumbHead-3+48)%48];
    if(AS_HumanSees(here) || !AS_Free(PointGetX(to),PointGetY(to),AS_MARINE_R)) {return;}
    UnitSetPosition(as_m[p],to,false);as_mvX[p]=0.0;as_mvY[p]=0.0;
    as_botLast[p]=to;as_botStuckAt[p]=as_now;
    AS_Log("bot "+IntToString(p)+" caught up");
}
