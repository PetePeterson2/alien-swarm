// =====================================================================
// A level's placed things, after Alien Swarm's map entities (tools/<level>.py):
//   asw_spawner      aliens fed in by name when a trigger starts them, NumAliens
//                    in all, MaxLiveAliens at once, one every SpawnInterval +-25%,
//                    gated by skill and by marines standing near (NearDistance 740)
//   trigger_once     rectangles the squad walks into: start spawners, complete
//                    objectives, commander lines, hints, the odd random ambush
//   asw_door         doors that open for marines, lock until hacked, weld shut,
//                    are cut open with a welder, or are bashed down by aliens
//   outputs          named events (a spawner's last alien dead, a timer, a counter
//                    full, a mover passing a path node, a relay) and what they do,
//                    the map's OnX outputs (tools/<level>.py ONS)
//   logic_timer      random timers (TIMERS); math_counter counters (COUNTERS);
//   func_tracktrain  movers along path_track nodes (MOVERS); asw_info_message (INFO)
// The spawner rules are asw_spawner.cpp / asw_base_spawner.cpp's: CanSpawn refuses
// while MaxLiveAliens are alive, once the supply is spent (unless infinite), and,
// without SpawnIfMarinesAreNear, while a marine is within NearDistance; skill outside
// Min/MaxSkillLevel (Brutal counts as Insane) and the spawner never spawns; on Easy an
// infinite spawner becomes finite with at least 8.
// =====================================================================

// World units to cells: the levels are traced at about 80 Hammer units a cell.
const fixed AS_NEAR_DIST = 9.3;              // asw_spawner NearDistance 740

// ---- spawners -----------------------------------------------------------
const int AS_SPAWNERS = 192;
int as_spN;
string[AS_SPAWNERS] as_spName;
fixed[AS_SPAWNERS] as_spX;
fixed[AS_SPAWNERS] as_spY;
int[AS_SPAWNERS] as_spKind;
int[AS_SPAWNERS] as_spNum;
int[AS_SPAWNERS] as_spMaxLive;
fixed[AS_SPAWNERS] as_spInt;
bool[AS_SPAWNERS] as_spInf;
int[AS_SPAWNERS] as_spMin;
int[AS_SPAWNERS] as_spMax;
bool[AS_SPAWNERS] as_spIfNear;                        // SpawnIfMarinesAreNear
bool[AS_SPAWNERS] as_spBurrow;
int[AS_SPAWNERS] as_spState;                          // 1 waiting for inputs, 2 spawning, 3 finished
int[AS_SPAWNERS] as_spLive;
int[AS_SPAWNERS] as_spMade;
fixed[AS_SPAWNERS] as_spNext;
fixed[AS_SPAWNERS] as_spNear;                         // NearDistance in cells
fixed[AS_SPAWNERS] as_spJitter;                       // the interval varies by this fraction either way
int[AS_SPAWNERS] as_spOrder;                          // AlienOrders for what it spawns (as_aGoal), and the target
bool[AS_SPAWNERS] as_spLong;                          // LongRange: its aliens sense 1152 and see 1536 (asw_base_spawner.cpp 257)
fixed[AS_SPAWNERS] as_spTX;
fixed[AS_SPAWNERS] as_spTY;
bool[AS_SPAWNERS] as_spDeadFired;                     // OnAllSpawnedDead has fired
int[AS_SPAWNERS] as_spEnter;                          // how its aliens come out (Aliens.galaxy AS_AlienEnter), 0 the vents
int as_logEnterN;                                      // climb-ins and jump-downs logged this mission (the first six of each)
int as_logJumpN;
fixed[AS_SPAWNERS] as_spEnterAng;                     // and the way they face as they do

void AS_Spawner (string name, fixed x, fixed y, int kind, int num, int maxLive, fixed interval, int inf, int minSkill, int maxSkill, int ifNear, int burrow) {
    int i=as_spN;
    if(i>=AS_SPAWNERS) {return;}
    as_spN+=1;
    as_spName[i]=name;as_spX[i]=x;as_spY[i]=y;as_spKind[i]=kind;as_spNum[i]=num;as_spMaxLive[i]=maxLive;
    as_spInt[i]=MaxF(0.25,interval);as_spInf[i]=inf!=0;as_spMin[i]=minSkill;as_spMax[i]=maxSkill;
    as_spIfNear[i]=ifNear!=0;as_spBurrow[i]=burrow!=0;as_spState[i]=1;as_spLive[i]=0;as_spMade[i]=0;as_spNext[i]=0.0;
    as_spNear[i]=AS_NEAR_DIST;as_spJitter[i]=0.25;as_spOrder[i]=0;as_spTX[i]=0.0;as_spTY[i]=0.0;as_spDeadFired[i]=false;
    as_spEnter[i]=0;as_spEnterAng[i]=0.0;as_spLong[i]=false;
    // Easy: an infinite spawner runs dry after at least eight (asw_spawner.cpp MissionStart).
    if(as_skill==1 && as_spInf[i]) {as_spInf[i]=false;as_spNum[i]=MaxI(as_spNum[i],8);}
}
// The spawner made last, beyond the defaults: SpawnerState 0 (spawning from the start), its NearDistance in
// cells, its interval jitter, AlienOrders (iasw_spawnable_npc.h 7-14: 0 SpreadThenHibernate, 1 MoveTo,
// 2 MoveToIgnoringMarines, 3 MoveToNearestMarine) with the target, and LongRange.
void AS_SpawnerOpts (bool start, fixed nearDist, fixed jitter, int orders, fixed tx, fixed ty, bool longRange) {
    int i=as_spN-1;
    if(i<0) {return;}
    as_spNear[i]=nearDist;as_spJitter[i]=AS_Clamp(jitter,0.0,0.9);as_spOrder[i]=orders;as_spTX[i]=tx;as_spTY[i]=ty;as_spLong[i]=longRange;
    if(start) {
        if(AS_SpawnerValid(i)) {as_spState[i]=2;as_spNext[i]=as_now;}
        else {as_spState[i]=3;}
    }
}
// The spawner made last: its aliens climb in over a railing, out of a wall or drop from a ledge (AS_AlienEnter).
void AS_SpawnerEnter (int how, fixed ang) {
    if(as_spN<1) {return;}
    as_spEnter[as_spN-1]=how;as_spEnterAng[as_spN-1]=ang;
}
// The skill gate: Brutal is treated as Insane.
bool AS_SpawnerValid (int i) {
    int s=MinI(as_skill,4);
    if(as_spMin[i]>0 && s<as_spMin[i]) {return false;}
    if(as_spMax[i]>0 && as_spMax[i]<10 && s>as_spMax[i]) {return false;}
    return true;
}
void AS_SpawnerStart (string name) {
    int i;int n=0;
    for(i=0;i<as_spN;i+=1) {
        if(as_spName[i]!=name || as_spState[i]!=1) {continue;}
        if(!AS_SpawnerValid(i)) {as_spState[i]=3;continue;}
        as_spState[i]=2;as_spNext[i]=as_now;n+=1;
    }
    if(n>0) {AS_Log("spawner on: "+name+" x"+IntToString(n));}
}
// StopSpawning; a name ending in * stops every spawner whose name starts so (ElevatorSpawn_group*).
void AS_SpawnerStop (string name) {
    int i;int n=StringLength(name);bool wild=n>1 && StringSub(name,n,n)=="*";string head=StringSub(name,1,n-1);
    for(i=0;i<as_spN;i+=1) {
        if(as_spState[i]!=2) {continue;}
        if(as_spName[i]==name || (wild && StringSub(as_spName[i],1,n-1)==head)) {as_spState[i]=1;}
    }
}
bool AS_MarineWithin (fixed x, fixed y, fixed r) {
    int p;point q;
    for(p=1;p<=AS_PLAYERS;p+=1) {
        if(!AS_Person(p) || !as_alive[p]) {continue;}
        q=UnitGetPosition(as_m[p]);
        if((PointGetX(q)-x)*(PointGetX(q)-x)+(PointGetY(q)-y)*(PointGetY(q)-y)<r*r) {return true;}
    }
    return false;
}
// An alien leaves the level (killed, latched on, cleared): its spawner may send another.
void AS_AlienGone (int i) {
    int s=as_aSpawner[i];
    as_aSpawner[i]= -1;as_aGoal[i]=0;
    if(s>=0 && s<as_spN) {as_spLive[s]=MaxI(0,as_spLive[s]-1);AS_SpawnerDeadCheck(s);}
}
// OnAllSpawnedDead: a finite spawner has sent its last and every one of them is gone.
void AS_SpawnerDeadCheck (int i) {
    if(as_spDeadFired[i] || as_spState[i]!=3 || as_spLive[i]>0 || as_spMade[i]==0) {return;}
    as_spDeadFired[i]=true;
    AS_Fire("alldead:"+as_spName[i]);
}
// One alien out of spawner i now; -1 when none could be placed.
int AS_SpawnerSpawn (int i) {
    int j;
    if(as_alive2>=AS_MAXALIEN-8) {return -1;}
    j=AS_SpawnNear(as_spKind[i],as_spX[i],as_spY[i],true);
    if(j<0) {return -1;}
    as_aSpawner[j]=i;as_spLive[i]+=1;as_spMade[i]+=1;
    if(as_spOrder[i]>=1 && as_spOrder[i]<=3) {as_aGoal[j]=as_spOrder[i];as_aGoalX[j]=as_spTX[i];as_aGoalY[j]=as_spTY[i];}
    if(as_spLong[i]) {as_aSense[j]=14.4;as_aSight[j]=19.2;}
    // Climbers come in over the railings or out of the walls, burrowed aliens dig up out of the deck, the rest
    // come out of the vents.
    if(as_spEnter[i]>0) {
        AS_AlienEnter(j,as_spEnter[i],as_spEnterAng[i]);
        if(as_logEnterN<6) {as_logEnterN+=1;AS_Log("climb-in "+IntToString(as_spEnter[i])+" from "+as_spName[i]);}
    }
    else if(as_spBurrow[i]) {AS_AlienBurrow(j);}
    else {AS_Burst(as_aX[j],as_aY[j],0.5,0.5,"90,90,90",2);}
    AS_DirectorAlienAdded(j);
    AS_Fire("spawned:"+as_spName[i]);
    if(!as_spInf[i] && as_spMade[i]>=as_spNum[i]) {as_spState[i]=3;AS_SpawnerDeadCheck(i);}
    return j;
}
// SpawnOneAlien: one now from each spawner of the name that is valid on this skill and not spent.
void AS_SpawnerOne (string name) {
    int i;
    for(i=0;i<as_spN;i+=1) {
        if(as_spName[i]!=name || !AS_SpawnerValid(i) || as_spState[i]==3) {continue;}
        if(as_spMaxLive[i]>0 && as_spLive[i]>=as_spMaxLive[i]) {continue;}
        AS_SpawnerSpawn(i);
    }
}
void AS_SpawnerPulse () {
    int i;
    for(i=0;i<as_spN;i+=1) {
        if(as_spState[i]!=2 || as_now<as_spNext[i]) {continue;}
        as_spNext[i]=as_now+as_spInt[i]*RandomFixed(1.0-as_spJitter[i],1.0+as_spJitter[i]);
        if(!as_spInf[i] && as_spMade[i]>=as_spNum[i]) {as_spState[i]=3;AS_SpawnerDeadCheck(i);continue;}
        if(as_spMaxLive[i]>0 && as_spLive[i]>=as_spMaxLive[i]) {continue;}
        if(!as_spIfNear[i] && AS_MarineWithin(as_spX[i],as_spY[i],as_spNear[i])) {continue;}
        AS_SpawnerSpawn(i);
    }
}
// An alien under a spawner's order (asw_alien.cpp 1196-1306, 2245-2306): off to its goal until it is there. MoveTo
// and MoveToNearestMarine give way to the first marine it senses; MoveToIgnoringMarines ignores them all the way.
// MoveToNearestMarine heads for whichever marine is nearest, wherever, re-pathing as it moves on.
bool AS_AlienGoal (int i, point q) {
    point to=Point(as_aGoalX[i],as_aGoalY[i]);int p;
    if(as_aGoal[i]!=2 && AS_AlienSense(i,q)>0) {as_aGoal[i]=0;return false;}
    if(as_aGoal[i]==3) {
        p=AS_Nearest(q,1000.0);
        if(p==0) {as_aGoal[i]=0;return false;}
        to=UnitGetPosition(as_m[p]);
        if(DistanceBetweenPoints(q,to)<as_aSense[i]) {as_aGoal[i]=0;return false;}
    }
    else if(DistanceBetweenPoints(q,to)<1.5) {as_aGoal[i]=0;return false;}
    if(as_now>=as_aNextOrder[i]) {AS_Order(i,to);as_aNextOrder[i]=as_now+1.0;}
    return true;
}
void AS_SpawnersClear () {
    int i;
    as_spN=0;
    for(i=0;i<AS_MAXALIEN;i+=1) {as_aSpawner[i]= -1;}
}

// ---- trigger_asw_jump: drones that run into one leap down off the ledge to its destination ---------------
// (tools/<level>.py JUMPS). Each alien jumps once (CheckTriggerJumped); with a minimum distance, only while no
// marine is that close (closer ones get clawed instead); with CheckEnemyDirection, only toward its quarry.
const int AS_JUMPS = 8;
int as_jpN;
fixed[AS_JUMPS] as_jpX0;
fixed[AS_JUMPS] as_jpY0;
fixed[AS_JUMPS] as_jpX1;
fixed[AS_JUMPS] as_jpY1;
fixed[AS_JUMPS] as_jpTX;
fixed[AS_JUMPS] as_jpTY;
fixed[AS_JUMPS] as_jpMin;
bool[AS_JUMPS] as_jpDir;
void AS_JumpLink (fixed x0, fixed y0, fixed x1, fixed y1, fixed tx, fixed ty, fixed minDist, bool checkDir) {
    if(as_jpN>=AS_JUMPS) {return;}
    as_jpX0[as_jpN]=x0;as_jpY0[as_jpN]=y0;as_jpX1[as_jpN]=x1;as_jpY1[as_jpN]=y1;as_jpTX[as_jpN]=tx;as_jpTY[as_jpN]=ty;
    as_jpMin[as_jpN]=minDist;as_jpDir[as_jpN]=checkDir;as_jpN+=1;
}
void AS_JumpPulse () {
    int i;int k;int n;int p;fixed x;fixed y;fixed tx;fixed ty;fixed d;point mq;
    if(as_jpN==0 || as_tick%4!=1) {return;}
    for(i=0;i<AS_MAXALIEN;i+=1) {
        if(as_a[i]==null || as_aJumped[i] || !as_aAwake[i] || as_aMoveT1[i]>0.0 || as_aLeapUntil[i]>as_now) {continue;}
        n=as_aKind[i];
        if(n!=AS_DRONE && n!=AS_JUMPER && n!=AS_UBER) {continue;}
        x=as_aX[i];y=as_aY[i];
        for(k=0;k<as_jpN;k+=1) {
            if(x<as_jpX0[k] || x>as_jpX1[k] || y<as_jpY0[k] || y>as_jpY1[k]) {continue;}
            p=AS_Nearest(Point(x,y),1000.0);
            if(p==0) {break;}
            mq=UnitGetPosition(as_m[p]);
            if(DistanceBetweenPoints(Point(x,y),mq)<as_jpMin[k]) {break;}
            tx=as_jpTX[k]+RandomFixed(-0.4,0.4);ty=as_jpTY[k]+RandomFixed(-0.4,0.4);
            if(as_jpDir[k] && (tx-x)*(PointGetX(mq)-x)+(ty-y)*(PointGetY(mq)-y)<=0.0) {break;}
            // ForceSpeed 400: five cells a second, and the higher the longer the leap.
            d=SquareRoot((tx-x)*(tx-x)+(ty-y)*(ty-y));
            as_aJumped[i]=true;
            AS_AlienMoveStart(i,x,y,AS_GroundZ(x,y),tx,ty,AS_GroundZ(tx,ty),AS_Clamp(d*0.25,0.5,2.0),AS_Clamp(d/5.0,0.4,1.2));
            AS_Sound("Broodling_Attack",x,y,60.0,0.2);
            if(as_logJumpN<6) {as_logJumpN+=1;AS_Log("jump-down "+IntToString(k)+" over "+FixedToString(d,1));}
            break;
        }
    }
}

// ---- triggers -------------------------------------------------------------
const int AS_TRIGGERS = 96;
int as_trN;
fixed[AS_TRIGGERS] as_trX0;
fixed[AS_TRIGGERS] as_trY0;
fixed[AS_TRIGGERS] as_trX1;
fixed[AS_TRIGGERS] as_trY1;
bool[AS_TRIGGERS] as_trOnce;
fixed[AS_TRIGGERS] as_trChance;
bool[AS_TRIGGERS] as_trDone;
int[AS_TRIGGERS] as_trAct0;                           // first action, and how many
int[AS_TRIGGERS] as_trActN;
string[AS_TRIGGERS] as_trName;                        // for enable and disable
bool[AS_TRIGGERS] as_trOff;                           // StartDisabled, or disabled since
int[AS_TRIGGERS] as_trNeed;                           // marines inside it takes: 1 any; n (playersrequired, at most the living); -1 all living
bool[AS_TRIGGERS] as_trAliens;                        // fired by aliens instead of marines
const int AS_TRACTS = 384;
int as_actN;
string[AS_TRACTS] as_actDo;
string[AS_TRACTS] as_actArg;
fixed[AS_TRACTS] as_actDelay;
// Actions waiting for their delay.
const int AS_PENDING = 64;
string[AS_PENDING] as_pendDo;
string[AS_PENDING] as_pendArg;
fixed[AS_PENDING] as_pendAt;

void AS_Trigger (fixed x0, fixed y0, fixed x1, fixed y1, bool once, fixed chance) {
    int i=as_trN;
    if(i>=AS_TRIGGERS) {return;}
    as_trN+=1;
    as_trX0[i]=x0;as_trY0[i]=y0;as_trX1[i]=x1;as_trY1[i]=y1;as_trOnce[i]=once;as_trChance[i]=chance;as_trDone[i]=false;
    as_trAct0[i]=as_actN;as_trActN[i]=0;
    as_trName[i]="";as_trOff[i]=false;as_trNeed[i]=1;as_trAliens[i]=false;
}
// The trigger made last, beyond the defaults: its name, StartDisabled, marines needed inside, alien-only.
void AS_TriggerOpts (string name, bool off, int need, bool aliens) {
    int i=as_trN-1;
    if(i<0) {return;}
    as_trName[i]=name;as_trOff[i]=off;as_trNeed[i]=need;as_trAliens[i]=aliens;
}
// How many aliens (not things) stand in the rectangle.
int AS_AliensIn (fixed x0, fixed y0, fixed x1, fixed y1) {
    int i;int n=0;
    for(i=0;i<AS_MAXALIEN;i+=1) {
        if(as_a[i]==null || AS_IsThing(as_aKind[i])) {continue;}
        if(AS_InRect(UnitGetPosition(as_a[i]),x0,y0,x1,y1)) {n+=1;}
    }
    return n;
}
// Whether trigger i is touched now.
bool AS_TriggerTouched (int i) {
    int n;
    if(as_trAliens[i]) {return AS_AliensIn(as_trX0[i],as_trY0[i],as_trX1[i],as_trY1[i])>0;}
    n=AS_CountIn(as_trX0[i],as_trY0[i],as_trX1[i],as_trY1[i]);
    if(n<=0) {return false;}
    if(as_trNeed[i]<0) {return n>=AS_Living();}
    return n>=MinI(MaxI(1,as_trNeed[i]),AS_Living());
}
// An action of the trigger made last.
void AS_TriggerDo (string act, string arg, fixed delay) {
    if(as_actN>=AS_TRACTS || as_trN==0) {return;}
    as_actDo[as_actN]=act;as_actArg[as_actN]=arg;as_actDelay[as_actN]=delay;as_actN+=1;
    as_trActN[as_trN-1]+=1;
}
void AS_ActionLater (string act, string arg, fixed delay) {
    int k;
    if(delay<=0.0) {AS_Action(act,arg);return;}
    for(k=0;k<AS_PENDING;k+=1) {
        if(as_pendDo[k]=="") {as_pendDo[k]=act;as_pendArg[k]=arg;as_pendAt[k]=as_now+delay;return;}
    }
    AS_Action(act,arg);
}
// "a|b|c|": one of the options at random (an empty one does nothing), as logic_case PickRandomShuffle.
string AS_PickOne (string opts) {
    int n=1;int k;int pick;string s=opts;int at;
    for(k=1;k<=StringLength(opts);k+=1) {if(StringSub(opts,k,k)=="|") {n+=1;}}
    pick=RandomInt(0,n-1);
    for(k=0;k<pick;k+=1) {
        at=StringFind(s,"|",c_stringCase);
        if(at<1) {return "";}
        s=StringSub(s,at+1,StringLength(s));
    }
    at=StringFind(s,"|",c_stringCase);
    if(at>=1) {s=StringSub(s,1,at-1);}
    return s;
}
// The map's inputs: spawners (StartSpawning, StopSpawning, SpawnOneAlien, a random pick), triggers and timers
// (Enable, Disable), relays (fire an event), counters (Add), movers (forward, back, stop) and info messages;
// anything else is the mission's (src/Mission.galaxy AS_MissionAction).
void AS_Action (string act, string arg) {
    if(act=="spawn") {AS_SpawnerStart(arg);}
    else if(act=="stop") {AS_SpawnerStop(arg);}
    else if(act=="spawnone") {AS_SpawnerOne(arg);}
    else if(act=="pick") {arg=AS_PickOne(arg);if(arg=="") {AS_Log("random pick: nothing");}else {AS_Log("random pick: "+arg);AS_SpawnerStart(arg);}}
    else if(act=="enable") {AS_LogicEnable(arg,true);}
    else if(act=="disable") {AS_LogicEnable(arg,false);}
    else if(act=="fire") {AS_Fire(arg);}
    else if(act=="count") {AS_CounterAdd(arg);}
    else if(act=="move") {AS_MoverGo(arg,1);}
    else if(act=="moveback") {AS_MoverGo(arg,-1);}
    else if(act=="movestop") {AS_MoverGo(arg,0);}
    else if(act=="info") {AS_InfoMessage(arg);}
    // logic_case with outputs of its own: one of the named events at random ("" for none).
    else if(act=="pickfire") {arg=AS_PickOne(arg);if(arg!="") {AS_Fire(arg);}}
    else {AS_MissionAction(act,arg);}
}
void AS_TriggerPulse () {
    int i;int k;bool inside;
    for(k=0;k<AS_PENDING;k+=1) {
        if(as_pendDo[k]!="" && as_now>=as_pendAt[k]) {AS_Action(as_pendDo[k],as_pendArg[k]);as_pendDo[k]="";}
    }
    AS_TimerPulse();AS_MoverPulse();AS_JumpPulse();
    // Marine triggers every tick: AS's thin trigger_multiple strips (a unit wide, across a catwalk) are crossed in
    // under a quarter second at a run, so a slower check can miss one (Deima's bridge gate, autopilot run 4).
    // Alien triggers count every alien, so they keep the slower beat.
    for(i=0;i<as_trN;i+=1) {
        if(as_trDone[i] || as_trOff[i]) {continue;}
        if(as_trAliens[i] && as_tick%4!=1) {continue;}
        inside=AS_TriggerTouched(i);
        if(!inside) {continue;}
        if(as_trOnce[i]) {as_trDone[i]=true;}
        // trigger_asw_chance rolls once, on the first touch.
        if(as_trChance[i]<1.0 && RandomFixed(0.0,1.0)>=as_trChance[i]) {as_trDone[i]=true;continue;}
        for(k=as_trAct0[i];k<as_trAct0[i]+as_trActN[i];k+=1) {AS_ActionLater(as_actDo[k],as_actArg[k],as_actDelay[k]);}
    }
}
void AS_TriggersClear () {
    int k;
    as_trN=0;as_actN=0;
    for(k=0;k<AS_PENDING;k+=1) {as_pendDo[k]="";}
    AS_LogicClear();
}

// ---- outputs: named events and what they do ---------------------------------
// Events: "alldead:<spawner>", "spawned:<spawner>", "timer:<timer>", "max:<counter>", "pass:<path node>",
// "arrived:<mover>", "pressed:<button>", "hackstart:<door>", "hacked:<door>", "done:<objective>", or any name
// a relay fires.
const int AS_OUTPUTS = 256;
int as_onN;
string[AS_OUTPUTS] as_onEv;
string[AS_OUTPUTS] as_onDo;
string[AS_OUTPUTS] as_onArg;
fixed[AS_OUTPUTS] as_onDelay;
void AS_On (string ev, string act, string arg, fixed delay) {
    if(as_onN>=AS_OUTPUTS) {return;}
    as_onEv[as_onN]=ev;as_onDo[as_onN]=act;as_onArg[as_onN]=arg;as_onDelay[as_onN]=delay;as_onN+=1;
}
void AS_Fire (string ev) {
    int k;bool any=false;
    for(k=0;k<as_onN;k+=1) {
        if(as_onEv[k]!=ev) {continue;}
        any=true;AS_ActionLater(as_onDo[k],as_onArg[k],as_onDelay[k]);
    }
    if(any) {AS_Log("event "+ev);}
}

// ---- logic_timer: fires "timer:<name>" every lo .. hi seconds while on ---------
const int AS_TIMERS = 16;
int as_tiN;
string[16] as_tiName;
fixed[16] as_tiLo;
fixed[16] as_tiHi;
bool[16] as_tiOn;
fixed[16] as_tiNext;
void AS_Timer (string name, fixed lo, fixed hi, bool on) {
    int i=as_tiN;
    if(i>=AS_TIMERS) {return;}
    as_tiN+=1;
    as_tiName[i]=name;as_tiLo[i]=MaxF(0.1,lo);as_tiHi[i]=MaxF(as_tiLo[i],hi);as_tiOn[i]=on;
    as_tiNext[i]=as_now+RandomFixed(as_tiLo[i],as_tiHi[i]);
}
void AS_TimerPulse () {
    int i;
    for(i=0;i<as_tiN;i+=1) {
        if(!as_tiOn[i] || as_now<as_tiNext[i]) {continue;}
        as_tiNext[i]=as_now+RandomFixed(as_tiLo[i],as_tiHi[i]);
        AS_Fire("timer:"+as_tiName[i]);
    }
}
// Enable or Disable: triggers and timers of the name.
void AS_LogicEnable (string name, bool on) {
    int k;
    for(k=0;k<as_trN;k+=1) {if(as_trName[k]==name) {as_trOff[k]=!on;}}
    for(k=0;k<as_tiN;k+=1) {
        if(as_tiName[k]!=name) {continue;}
        if(on && !as_tiOn[k]) {as_tiNext[k]=as_now+RandomFixed(as_tiLo[k],as_tiHi[k]);}
        as_tiOn[k]=on;
    }
}

// ---- math_counter: "count" adds one; at its max it fires "max:<name>" ---------
const int AS_COUNTERS = 16;
int as_ctN;
string[16] as_ctName;
int[16] as_ctMax;
int[16] as_ctAt;
void AS_Counter (string name, int max) {
    if(as_ctN>=AS_COUNTERS) {return;}
    as_ctName[as_ctN]=name;as_ctMax[as_ctN]=max;as_ctAt[as_ctN]=0;as_ctN+=1;
}
void AS_CounterAdd (string name) {
    int k;
    for(k=0;k<as_ctN;k+=1) {
        if(as_ctName[k]!=name || as_ctAt[k]>=as_ctMax[k]) {continue;}
        as_ctAt[k]+=1;
        if(as_ctAt[k]==as_ctMax[k]) {AS_Fire("max:"+name);}
    }
}

// ---- movers: an actor along its path nodes (func_tracktrain, func_movelinear) --
// Forward runs it toward its last node, back toward its first; each node it reaches fires "pass:<node>",
// the end "arrived:<name>". Heights are over the ground.
const int AS_MOVERS = 8;
const int AS_MOVER_POINTS = 64;
int as_moN;
string[8] as_moName;
string[8] as_moModel;
actor[8] as_moA;
fixed[8] as_moSpeed;
int[8] as_moP0;                  // its first node, and how many
int[8] as_moPN;
int[8] as_moAt;                  // the node it last reached
int[8] as_moGo;                  // 1 forward, -1 back, 0 stopped
fixed[8] as_moX;
fixed[8] as_moY;
fixed[8] as_moZ;
fixed[8] as_moBase;              // the deck's height under its first node: node heights are above it
int as_mpN;
fixed[64] as_mpX;
fixed[64] as_mpY;
fixed[64] as_mpZ;
string[64] as_mpNode;
void AS_Mover (string name, string model, fixed speed) {
    int i=as_moN;
    if(i>=AS_MOVERS) {return;}
    as_moN+=1;
    as_moName[i]=name;as_moModel[i]=model;as_moA[i]=null;as_moSpeed[i]=MaxF(0.1,speed);as_moP0[i]=as_mpN;as_moPN[i]=0;as_moAt[i]=0;as_moGo[i]=0;
}
// A node of the mover made last; the first is where it starts.
void AS_MoverPoint (fixed x, fixed y, fixed z, string node) {
    int i=as_moN-1;
    if(i<0 || as_mpN>=AS_MOVER_POINTS) {return;}
    as_mpX[as_mpN]=x;as_mpY[as_mpN]=y;as_mpZ[as_mpN]=z;as_mpNode[as_mpN]=node;as_mpN+=1;as_moPN[i]+=1;
    if(as_moPN[i]==1) {as_moX[i]=x;as_moY[i]=y;as_moZ[i]=z;as_moBase[i]=AS_CellZ(x,y);}
}
// A mover shows up at its first node when it is first sent on its way (a point_template's ForceSpawn).
void AS_MoverGo (string name, int dir) {
    int k;
    for(k=0;k<as_moN;k+=1) {
        if(as_moName[k]!=name) {continue;}
        as_moGo[k]=dir;
        if(as_moA[k]==null && dir!=0) {
            as_moA[k]=libNtve_gf_CreateActorAtPoint(as_moModel[k],Point(as_moX[k],as_moY[k]));
            ActorSend(as_moA[k],libNtve_gf_SetPosition(as_moX[k],as_moY[k],as_moBase[k]+as_moZ[k]));
            AS_Log("mover out: "+name);
        }
    }
}
int AS_MoverNamed (string name) {
    int k;
    for(k=0;k<as_moN;k+=1) {if(as_moName[k]==name) {return k;}}
    return -1;
}
void AS_MoverPulse () {
    int i;int n;fixed step;fixed dx;fixed dy;fixed dz;fixed d;
    for(i=0;i<as_moN;i+=1) {
        if(as_moGo[i]==0 || as_moA[i]==null) {continue;}
        n=as_moAt[i]+as_moGo[i];
        if(n<0 || n>=as_moPN[i]) {as_moGo[i]=0;AS_Fire("arrived:"+as_moName[i]);continue;}
        n=as_moP0[i]+n;
        dx=as_mpX[n]-as_moX[i];dy=as_mpY[n]-as_moY[i];dz=as_mpZ[n]-as_moZ[i];
        d=SquareRoot(dx*dx+dy*dy+dz*dz);step=as_moSpeed[i]*AS_DT;
        if(d<=step) {
            as_moX[i]=as_mpX[n];as_moY[i]=as_mpY[n];as_moZ[i]=as_mpZ[n];as_moAt[i]+=as_moGo[i];
            if(as_mpNode[n]!="") {AS_Fire("pass:"+as_mpNode[n]);}
        }
        else {as_moX[i]+=dx/d*step;as_moY[i]+=dy/d*step;as_moZ[i]+=dz/d*step;}
        ActorSend(as_moA[i],libNtve_gf_SetPosition(as_moX[i],as_moY[i],as_moBase[i]+as_moZ[i]));
        if(dx*dx+dy*dy>0.0001) {AS_KitTurn(as_moA[i],ATan2(dy,dx)+90.0);}
    }
}
// With the level's triggers (AS_TriggersClear): its outputs, timers, counters and movers.
void AS_LogicClear () {
    int k;
    as_onN=0;as_tiN=0;as_ctN=0;as_jpN=0;as_logEnterN=0;as_logJumpN=0;
    for(k=0;k<as_moN;k+=1) {if(as_moA[k]!=null) {ActorSend(as_moA[k],"Destroy");as_moA[k]=null;}}
    as_moN=0;as_mpN=0;
}

// ---- asw_info_message: a titled message for the whole squad (tools/<level>.py INFO) --
void AS_InfoMessage (string key) {
    string s=AS_InfoText(key);int at=StringFind(s,"|",c_stringCase);
    if(s=="") {AS_Log("info message missing: "+key);return;}
    if(at<1) {AS_All(s,"");}
    else {AS_All(StringSub(s,1,at-1),StringSub(s,at+1,StringLength(s)));}
    AS_Log("info message "+key);
}
