// ---- small helpers ----------------------------------------------------
fixed AS_Clamp (fixed v, fixed lo, fixed hi) {
    if(v<lo) {return lo;}
    if(v>hi) {return hi;}
    return v;
}
fixed AS_AngleDiff (fixed a, fixed b) {
    fixed d=a-b;
    while(d>180.0) {d-=360.0;}
    while(d< -180.0) {d+=360.0;}
    return d;
}
bool AS_Person (int p) {return p>=1 && p<=AS_PLAYERS && as_on[p];}
playergroup AS_Me (int p) {return PlayerGroupSingle(p);}
