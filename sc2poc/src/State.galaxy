unit[5] as_camUnit;         // what the camera is following
fixed[5] as_meleeNext;
fixed[5] as_rollUntil;      // rolling (SPACE): faster, and projectiles pass by
fixed[5] as_rollX;
fixed[5] as_rollY;
fixed[5] as_rollNext;
int[5] as_spectate;         // a dead player's camera follows this marine (0 none)
int[5] as_using;            // the use spot a marine is working (a panel, a terminal), -1 none
fixed[5] as_elecUntil;      // electric charged armour
fixed[5] as_ampUntil;       // standing in a damage amp field
fixed[5] as_nvPower;        // night vision seconds left
bool[5] as_nvOn;
fixed[5] as_zoomScope;      // the marksman rifle's scope
int[5] as_meleeKills;
int[5] as_barrelKills;

int AS_Class (int p) {return AS_ProfileClass(as_prof[p]);}
int AS_Skill (int p, int sk) {
    if(p<1 || p>AS_PLAYERS || as_prof[p]<0) {return 0;}
    return as_pfSkill[as_prof[p]][sk];
}
bool AS_HasItem (int p, int it) {return as_inv[p][0]==it || as_inv[p][1]==it || as_inv[p][2]==it;}
string AS_MarineNameS (int p) {
    if(as_prof[p]<0) {return "Marine "+IntToString(p);}
    return as_pfName[as_prof[p]];
}

