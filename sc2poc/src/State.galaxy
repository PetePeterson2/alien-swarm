bool AS_IsExtra (int it) {return it>=AS_FIRST_EXTRA;}
bool AS_IsSentry (int it) {return it==AS_IT_SENTRY || it==AS_IT_SENTRYFREEZE || it==AS_IT_SENTRYFLAME || it==AS_IT_SENTRYCANNON;}
// Things you put down rather than fire: their clip is a count of uses.
bool AS_IsDeployable (int it) {return AS_IsSentry(it) || it==AS_IT_HEALBEACON || it==AS_IT_AMMOBAG;}

