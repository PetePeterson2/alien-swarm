int[5][39] as_reserve;
int[5][39] as_alt;          // secondary rounds carried, per weapon
fixed[5] as_nextShot;
fixed[5] as_nextAlt;
fixed[5] as_reloadEnd;      // 0 when not reloading
fixed[5] as_reloadStart;
fixed[5] as_fastFrom;       // the active reload window
fixed[5] as_fastTo;
bool[5] as_fastTried;
fixed[5] as_spin;           // minigun barrel spin 0..1
fixed[5] as_lastShot;
int[5] as_pistolSide;
fixed[5] as_slowHeal;       // health still to come back, 4 every 0.33 s
fixed[5] as_slowHealNext;
bool[5] as_lightOn;
unit[5] as_torch;           // flashlight unit
unit[5] as_glow;            // soft personal light
unit[5] as_muzzle;          // muzzle-flash light
unit[5] as_laser;           // laser sight
