void AS_KindSet (int k, string unitId, string die, string name, fixed hp, fixed radius, fixed dmg, fixed cooldown, fixed reach, fixed speed) {
    as_kindUnit[k]=unitId;as_kindDie[k]=die;as_kindName[k]=name;as_kindHp[k]=hp;as_kindRadius[k]=radius;as_kindDamage[k]=dmg;
    as_kindCooldown[k]=cooldown;as_kindReach[k]=reach;as_kindSpeed[k]=speed;
}
// Normal-difficulty numbers: asw_*_health and sk_asw_*_damage (the director report's table).
void AS_KindsInit () {
    AS_KindSet(AS_DRONE,"ASDrone","ASDieDrone","DRONE",40.0,0.40,15.0,0.9,0.55,3.4);
    AS_KindSet(AS_JUMPER,"ASDrone","ASDieDrone","DRONE",40.0,0.40,15.0,0.9,0.55,3.4);
    AS_KindSet(AS_PARASITE,"ASParasite","ASDieParasite","PARASITE",25.0,0.22,10.0,2.0,0.4,4.2);
    AS_KindSet(AS_XENOMITE,"ASParasite","ASDieParasite","XENOMITE",10.0,0.20,5.0,1.5,0.4,4.4);
    AS_KindSet(AS_SHIELDBUG,"ASShieldbug","ASDieShieldbug","SHIELDBUG",1000.0,0.95,25.0,1.6,0.75,1.7);
    AS_KindSet(AS_BOOMER,"ASBoomer","ASDieBoomer","BOOMER",800.0,0.75,30.0,1.0,1.2,1.3);
    AS_KindSet(AS_BUZZER,"ASBuzzer","ASDieBuzzer","BUZZER",30.0,0.30,8.0,0.8,0.5,3.2);
    AS_KindSet(AS_RANGER,"ASRanger","ASDieRanger","RANGER",101.0,0.40,10.0,2.0,6.5,2.5);
    AS_KindSet(AS_MORTAR,"ASMortarbug","ASDieMortar","MORTARBUG",350.0,0.55,20.0,3.5,10.0,1.6);
    AS_KindSet(AS_HARVESTER,"ASHarvester","ASDieHarvester","HARVESTER",200.0,0.70,5.0,4.0,7.0,1.0);
    AS_KindSet(AS_UBER,"ASUberDrone","ASDieUber","UBER DRONE",500.0,0.55,18.0,1.1,0.7,2.9);
    AS_KindSet(AS_RIPPER,"ASRipper","ASDieRipper","RIPPER",160.0,0.50,15.0,1.2,0.75,3.6);
    AS_KindSet(AS_EGG,"ASEgg","ASDieEgg","EGG",30.0,0.45,0.0,0.0,4.0,0.0);
    AS_KindSet(AS_BIOMASS,"ASBiomass","ASDieBiomass","BIOMASS",600.0,1.2,0.0,0.0,0.0,0.0);
    AS_KindSet(AS_BARREL,"ASBarrel","ASFxBoom","BARREL",30.0,0.35,0.0,0.0,0.0,0.0);
    AS_KindSet(AS_GRUB,"ASParasite","ASDieParasite","GRUB",5.0,0.18,0.0,9.0,0.0,1.5);
    AS_KindSet(AS_SHAMAN,"ASRanger","ASDieRanger","SHAMAN",59.0,0.40,0.0,2.0,4.0,2.4);
    AS_KindSet(AS_QUEEN,"ASShieldbug","ASDieShieldbug","QUEEN",3500.0,1.4,40.0,2.0,1.4,0.8);
}
// What a kind is born with on this difficulty (drones and rangers never below 25).
fixed AS_KindHealth (int k) {
    fixed h=as_kindHp[k];
    if(k==AS_EGG || k==AS_BIOMASS || k==AS_BARREL) {return h;}
    h*=AS_AlienHealthScale();
    if(k==AS_DRONE || k==AS_JUMPER || k==AS_RANGER || k==AS_BOOMER || k==AS_SHAMAN) {h=MaxF(25.0,h);}
    return h;
}
fixed AS_KindDamage (int k) {
    fixed d=MaxF(1.0,as_kindDamage[k]*AS_AlienDamageScale());
    if(k==AS_DRONE || k==AS_JUMPER) {d=MaxF(3.0,d);}
    return d;
}
// Drones, jumpers and parasites run faster on harder difficulties.
fixed AS_KindSpeed (int k) {
    if(k==AS_DRONE || k==AS_JUMPER || k==AS_PARASITE || k==AS_XENOMITE) {return as_kindSpeed[k]*AS_AlienSpeedScale();}
    return as_kindSpeed[k];
}
bool AS_IsThing (int k) {return k==AS_EGG || k==AS_BIOMASS || k==AS_BARREL;}

