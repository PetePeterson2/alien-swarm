const int AS_LV_CARGO = 1;             // mission 2, CARGO ELEVATOR (tools/cargo.py)
int as_level = -1;                     // the level being played, -1 in the briefing
bool as_levelReady;                    // a level is built and running (false in the briefing and between levels)
int as_startLevel = -1;                // QA builds start here without the briefing (build.py --start, --auto)
string as_bankName = "HalcyonDrift";   // each player's progress (build.py rewrites this line for QA builds)
string[8] as_levelTitle;
string[8] as_levelPlace;
string[8] as_levelBrief;
int[8] as_levelPar;                    // the speed-run time, seconds (the map's speedruntime: Landing Bay 85)
fixed as_spawnX;                       // where the level's squad deploys
fixed as_spawnY;
fixed as_spawnFacing;
int[5] as_deaths;
bool[5] as_bot;                        // an AI marine (src/Bots.galaxy)
bool as_auto = false;                  // autopilot QA run (build.py --auto rewrites this line)
bool as_autoWipe = false;              // with it, Landing Bay's death rules first (build.py --wipe rewrites this line)
fixed[5] as_botVX;                     // a bot's wanted walk, unit vector
fixed[5] as_botVY;
// AI marines and the QA log (src/Bots.galaxy): declared here, the mission reads them.
int as_botCount;
fixed[5] as_botNextLook;
fixed[5] as_botStuckAt;                // when a bot last made progress toward the squad
point[5] as_botLast;
point[5] as_botGoalPt;                 // where a bot is walking, refreshed every fourth step
int[5] as_botFoe;
int[5] as_botOrder;                    // 0 follow, 1 hold (V and X, as AS's single player)
point[5] as_botHoldAt;
point[48] as_crumb;                    // the leader's trail, newest at as_crumbHead
int as_crumbHead = -1;
int as_crumbN;
int as_leader;
int as_routeN;
fixed[48] as_routeX;
fixed[48] as_routeY;
int[48] as_routeWait;                  // 0 walk on, 1 the gate hacked, 2 the ride over, 3 the tank doors cut, 4 the download done
int as_routeAt;
int as_logN;
fixed[5] as_dmgTaken;
fixed[5] as_ffDealt;                   // damage a marine has done to the rest of the squad
fixed[5] as_healed;                    // health a marine has given back to the squad
int[5] as_fastHacks;
sound as_amb;                          // the ambience bed (Main starts it, the mission swaps it below the lift)
sound as_rideSnd;                      // the lift's running rumble

fixed as_now;
int as_tick;
int as_brHost;                         // the host: the first human, who runs the briefing (src/Briefing.galaxy)
int as_open = 1;                       // missions open to this squad: the most any player here has unlocked
bool as_lastWon;                       // the mission just ended was won (src/Campaign.galaxy)
bank[5] as_bank;                       // each player's progress (src/Progress.galaxy)
bool[5] as_bankOn;
bool[5] as_bankDirty;                  // changed since it was last saved

// ---- difficulty (asw_skill; difficulty.cfg and CAlienSwarm::OnSkillLevelChanged) ----
// 1 Easy, 2 Normal, 3 Hard, 4 Insane, 5 Brutal. The mission difficulty is 3/5/7/10/13, one less with three
// marines in the squad and two less with fewer (never below 2); alien health, alien damage and friendly
// fire scale by 1 + 0.2 a step away from 5. Drones, jumpers and parasites also run faster, and marines a
// touch faster. Marine damage to aliens never changes.
int as_skill = 2;
bool as_onslaught;                     // the director's hordes and wanderers (AS's Onslaught option)
int as_md = 5;
int as_squadSize = 4;
string AS_SkillName (int s) {
    if(s==1) {return "Easy";}if(s==2) {return "Normal";}if(s==3) {return "Hard";}if(s==4) {return "Insane";}
    return "Brutal";
}
void AS_DifficultySet (int skill, int squad) {
    int md=5;
    as_skill=MaxI(1,MinI(5,skill));as_squadSize=squad;
    if(as_skill==1) {md=3;}else if(as_skill==3) {md=7;}else if(as_skill==4) {md=10;}else if(as_skill==5) {md=13;}
    if(squad==3) {md-=1;}
    else if(squad<=2) {md-=2;}
    as_md=MaxI(2,md);
}
fixed AS_AlienHealthScale () {return 1.0+0.2*IntToFixed(as_md-5);}
fixed AS_AlienDamageScale () {return 1.0+0.2*IntToFixed(as_md-5);}
fixed AS_FFScale () {return 1.0+0.2*IntToFixed(as_md-5);}
fixed AS_AlienSpeedScale () {
    if(as_skill==1) {return 0.7;}if(as_skill==2) {return 1.0;}if(as_skill==3) {return 1.1;}
    return 1.2;
}
fixed AS_MarineSpeedScale () {
    if(as_skill==1) {return 0.96;}if(as_skill==2) {return 1.0;}if(as_skill==3) {return 1.024;}
    return 1.048;
}
// Parasite infestation in all, over 20 s (TotalInfestDamage).
fixed AS_InfestTotal () {
    if(as_skill==1) {return 175.0;}if(as_skill==2) {return 225.0;}if(as_skill==3) {return 270.0;}
    return 280.0;
}

