int as_dmgItem;                     // the item dealing the damage applied now, when not the gun in hand (a sentry)
struct AS_Item {
    string name;       // the loadout's name
    string title;      // the HUD's
    string notes;      // the loadout's "Notes" line
    string desc;
    int slot;          // 0 weapon (either of the first two slots), 1 extra
    int cls;           // -1 any class, else the only class that may carry it
    int unlock;        // the player level it unlocks at (1 from the start)
    bool unique;       // one per marine
    // Guns and deployables.
    int mag;           // clip, or uses for a deployable or an extra
    int reserve;       // carried beyond the clip (skill.cfg sk_max_*)
    fixed damage;      // per bullet or pellet, before the skill bonus
    fixed rate;        // seconds between shots, in whole 1/16 s steps
    fixed rateAS;      // Alien Swarm's own; damage is scaled by rate/rateAS so the damage a second is AS's
    fixed reload;      // the script's reload_time (x 1.4 - 0.14 a Reloading point)
    int pellets;
    fixed spread;      // degrees, full cone
    fixed range;       // cells
    bool semi;
    int pierce;        // extra aliens a shot passes through
    string tint;
    string snd;
    fixed slowFire;    // movement while firing or reloading
    fixed slowCarry;   // movement while it is in hand
    int dmgSkill;      // the skill that adds to its damage, -1 none
    fixed dmgStep;
    fixed autoaim;     // degrees of aim assist
    int alt;
    int altAmmo;       // secondary rounds carried (5 loaded + 8 spare)
};
AS_Item[39] as_it;
void AS_ItemSet (int i, string name, string title, string notes, int slot, int cls, int unlock) {
    as_it[i].name=name;as_it[i].title=title;as_it[i].notes=notes;as_it[i].slot=slot;as_it[i].cls=cls;as_it[i].unlock=unlock;
    as_it[i].unique=false;as_it[i].mag=1;as_it[i].reserve=0;as_it[i].damage=0.0;as_it[i].rate=0.5;as_it[i].rateAS=0.5;as_it[i].reload=2.0;
    as_it[i].pellets=1;as_it[i].spread=0.0;as_it[i].range=20.0;as_it[i].semi=false;as_it[i].pierce=0;as_it[i].tint="255,214,140";as_it[i].snd="Marine_AttackLaunch";
    as_it[i].slowFire=0.5;as_it[i].slowCarry=1.0;as_it[i].dmgSkill= -1;as_it[i].dmgStep=0.0;as_it[i].autoaim=4.0;as_it[i].alt=AS_ALT_NONE;as_it[i].altAmmo=0;
    as_it[i].desc="";
}
void AS_GunSet (int i, int mag, int reserve, fixed damage, fixed rate, fixed rateAS, fixed reload, int pellets, fixed spread, fixed range) {
    as_it[i].mag=mag;as_it[i].reserve=reserve;as_it[i].damage=damage;as_it[i].rate=rate;as_it[i].rateAS=rateAS;as_it[i].reload=reload;
    as_it[i].pellets=pellets;as_it[i].spread=spread;as_it[i].range=range;
}
