string[15] as_skName;
int[15] as_skMax;
string[4] as_clName;
string[4] as_clKey;                    // HUD medallion art

void AS_ProfileSet (int i, string name, string full, int cls, string face, int s0, int p0, int s1, int p1, int s2, int p2, int s3, int p3, int s4, int p4) {
    int k;
    as_pfName[i]=name;as_pfFull[i]=full;as_pfClass[i]=cls;as_pfFace[i]=face;
    for(k=0;k<AS_SKILLS;k+=1) {as_pfSkill[i][k]=0;}
    as_pfSkill[i][s0]=p0;as_pfSkill[i][s1]=p1;as_pfSkill[i][s2]=p2;as_pfSkill[i][s3]=p3;as_pfSkill[i][s4]=p4;
    as_pfSlot[i][0]=s0;as_pfSlot[i][1]=s1;as_pfSlot[i][2]=s2;as_pfSlot[i][3]=s3;as_pfSlot[i][4]=s4;
}
void AS_ProfilesInit () {
    as_clName[0]="Officer";as_clName[1]="Special Weapons";as_clName[2]="Medic";as_clName[3]="Tech";
    as_clKey[0]="officer";as_clKey[1]="sw";as_clKey[2]="medic";as_clKey[3]="tech";
    as_skName[0]="Leadership";as_skName[1]="Vindicator Damage";as_skName[2]="Autogun Damage";as_skName[3]="Piercing Bullets";
    as_skName[4]="Healing";as_skName[5]="Infestation Curing";as_skName[6]="Combat Drugs";as_skName[7]="Scanner";as_skName[8]="Engineering";
    as_skName[9]="Damage Bonus";as_skName[10]="Explosives Bonus";as_skName[11]="Health Bonus";as_skName[12]="Melee Damage Bonus";
    as_skName[13]="Reload Speed Bonus";as_skName[14]="Speed Bonus";
    as_skMax[0]=5;as_skMax[1]=5;as_skMax[2]=5;as_skMax[3]=5;as_skMax[4]=5;as_skMax[5]=3;as_skMax[6]=5;as_skMax[7]=3;as_skMax[8]=3;
    as_skMax[9]=5;as_skMax[10]=5;as_skMax[11]=5;as_skMax[12]=5;as_skMax[13]=5;as_skMax[14]=5;
    // In profile order: Sarge, Wildcat, Faith, Crash, Jaeger, Wolfe, Bastille, Vegas.
    AS_ProfileSet(0,"Sarge","Master Sergeant Joseph Conrad",AS_CL_OFFICER,"sarge",AS_SK_LEADERSHIP,5,AS_SK_VINDICATOR,2,AS_SK_GRENADES,2,AS_SK_HEALTH,4,AS_SK_ACCURACY,3);
    AS_ProfileSet(1,"Wildcat","Private First Class Adele Lyon",AS_CL_SW,"wildcat",AS_SK_AUTOGUN,4,AS_SK_PIERCING,2,AS_SK_ACCURACY,4,AS_SK_RELOADING,3,AS_SK_AGILITY,4);
    AS_ProfileSet(2,"Faith","Corporal Eva Jensen",AS_CL_MEDIC,"faith",AS_SK_HEALING,5,AS_SK_XENOWOUNDS,3,AS_SK_ACCURACY,1,AS_SK_RELOADING,2,AS_SK_AGILITY,3);
    AS_ProfileSet(3,"Crash","Private David Murphy",AS_CL_TECH,"crash",AS_SK_SCANNER,3,AS_SK_ENGINEERING,1,AS_SK_ACCURACY,3,AS_SK_RELOADING,4,AS_SK_GRENADES,2);
    AS_ProfileSet(4,"Jaeger","Corporal Karl Jaeger",AS_CL_OFFICER,"jaeger",AS_SK_LEADERSHIP,3,AS_SK_VINDICATOR,5,AS_SK_GRENADES,4,AS_SK_HEALTH,3,AS_SK_MELEE,2);
    AS_ProfileSet(5,"Wolfe","Private Thomas Wolfe",AS_CL_SW,"wolfe",AS_SK_AUTOGUN,5,AS_SK_PIERCING,3,AS_SK_ACCURACY,2,AS_SK_RELOADING,2,AS_SK_HEALTH,3);
    AS_ProfileSet(6,"Bastille","Private Leon Bastille",AS_CL_MEDIC,"bastille",AS_SK_HEALING,4,AS_SK_XENOWOUNDS,1,AS_SK_ACCURACY,3,AS_SK_RELOADING,3,AS_SK_DRUGS,3);
    AS_ProfileSet(7,"Vegas","Private Argento Guerra",AS_CL_TECH,"vegas",AS_SK_SCANNER,3,AS_SK_ENGINEERING,3,AS_SK_HEALTH,3,AS_SK_RELOADING,2,AS_SK_MELEE,4);
    as_pfBio[0]="A veteran who lived through one of the worst Swarm invasions on record. He drives his squad hard because he knows exactly what they are up against.";
    as_pfBio[1]="She was headed for a corporate career until the Swarm wiped out her home colony and her family with it. She volunteered for an elite unit the same year.";
    as_pfBio[2]="A devoted field medic who treats every marine in her care as family, and carries every one she loses.";
    as_pfBio[3]="A teenage hacker whose prank took down a starbase's systems. He is working off the sentence in the IAF, and he is very good with a door panel.";
    as_pfBio[4]="Born into a long line of soldiers, he is loud, fearless and fully expects to go down fighting.";
    as_pfBio[5]="Given the choice between a cell and the army, he took the army, excelled, and was moved up to special operations.";
    as_pfBio[6]="Raised on a prison world, where he taught himself medicine and philosophy. Wary of everyone, and an outstanding combat medic.";
    as_pfBio[7]="A card player with a memory like a vault who joined the IAF a step ahead of some very large debts.";
}
int AS_ProfileClass (int prof) {
    if(prof<0) {return -1;}
    return as_pfClass[prof];
}

