// =====================================================================
// HALCYON DRIFT -- an Alien Swarm combat proof of concept for SC2.
// Shared state. Every module is concatenated after this one by build.py,
// with forward declarations for every AS_ function in between.
// =====================================================================

const int AS_W = @W@;
const int AS_H = @H@;
const fixed AS_DT = 0.0625;
const int AS_PLAYERS = 4;
const int AS_HOSTILE = 15;
const int AS_MAXALIEN = 96;
const int AS_WEAPONS = 10;

// Build switches (build.py rewrites these lines).
bool as_qa = false;
bool as_demo = false;                  // scripted firing range for screenshots (build.py --demo)
string as_runId = "unset";
bool as_mission = true;                // every level is a mission now: src/Mission.galaxy runs it
bool as_lowerLevel;                    // the squad has ridden down: the director uses the lower level's vents

// ---- the campaign (src/Campaign.galaxy) -------------------------------
// Every level is in the map; one is built at a time from its strings (build.py LEVELS).
const int AS_LEVELS = @LEVELS@;
const int AS_LV_DECK = 0;              // mission 1, DISTRESS BEACON (tools/level.py)
const int AS_LV_CARGO = 1;             // mission 2, CARGO ELEVATOR (tools/cargo.py)
int as_level = -1;                     // the level being played, -1 in the level menu
bool as_levelReady;                    // a level is built and running (false in the menu and between levels)
int as_startLevel = -1;                // QA builds start here without the menu (build.py --start, --auto)
string as_bankName = "HalcyonDrift";   // each marine's progress (build.py rewrites this line for QA builds)
string[8] as_levelTitle;
string[8] as_levelPlace;
string[8] as_levelBrief;
fixed as_spawnX;                       // where the level's squad deploys
fixed as_spawnY;
fixed as_spawnFacing;
const fixed AS_RESPAWN = 10.0;         // a downed marine's wait in a mission
int[5] as_deaths;
bool[5] as_bot;                        // an AI marine (src/Bots.galaxy)
bool as_auto = false;                  // autopilot QA run (build.py --auto rewrites this line)
fixed[5] as_botVX;                     // a bot's wanted walk, unit vector
fixed[5] as_botVY;
// AI marines and the QA log (src/Bots.galaxy): declared here, the mission reads them.
int as_botCount;
fixed[5] as_botNextLook;
fixed[5] as_botStuckAt;                 // when a bot last made progress toward the squad
point[5] as_botLast;
point[5] as_botGoalPt;                 // where a bot is walking, refreshed every fourth step
int[5] as_botFoe;
point[48] as_crumb;                    // the leader's trail, newest at as_crumbHead
int as_crumbHead = -1;
int as_crumbN;
int as_leader;
int as_routeN;
fixed[48] as_routeX;
fixed[48] as_routeY;
int[48] as_routeWait;                  // 0 walk on, 1 until the door is open, 2 until the ride is over
int as_routeAt;
int as_logN;
fixed[5] as_dmgTaken;
fixed[5] as_ffDealt;                   // blast damage a marine has done to the rest of the squad
sound as_amb;                          // the ambience bed (Main starts it, the mission swaps it below the lift)
sound as_rideSnd;                      // the lift's running rumble

fixed as_now;
int as_tick;

// ---- the deck ---------------------------------------------------------
bool[@W@][@H@] as_wall;          // collision cells, from tools/level.py
fixed as_floorZ = 8.0;

// ---- marines ----------------------------------------------------------
bool[5] as_on;              // a person is in this slot
unit[5] as_m;               // the marine
fixed[5] as_hp;
fixed[5] as_hpMax;
bool[5] as_alive;
fixed[5] as_respawnAt;
bool[5][4] as_key;          // W A S D held
fixed[5] as_mvX;
fixed[5] as_mvY;
bool[5] as_walking;
fixed[5] as_walkRate;
fixed[5] as_aim;            // facing of the gun, degrees
fixed[5] as_mouseDX;        // cursor offset from the marine (top-down view)
fixed[5] as_mouseDY;
bool[5] as_mouseSeen;
int[5] as_view;             // 0 top-down, 1 third person
fixed[5] as_zoom;           // top-down camera distance
bool[5] as_trigger;         // left mouse held
bool[5] as_trigger2;        // right mouse held
bool[5] as_semiReady;       // a semi-automatic weapon wants the trigger let go first
int[5] as_slot;             // weapon in hand, 1..10
int[5][11] as_mag;
int[5][11] as_reserve;
fixed[5] as_nextShot;
fixed[5] as_reloadEnd;      // 0 when not reloading
fixed[5] as_reloadStart;
fixed[5] as_spin;           // minigun barrel spin 0..1
fixed[5] as_lastShot;
int[5] as_pistolSide;
int[5] as_grenades;         // rifle under-barrel grenades
int[5] as_sentries;
int[5] as_medkits;
int[5] as_flares;
bool[5] as_lightOn;
unit[5] as_torch;           // flashlight unit
unit[5] as_glow;            // soft personal light
unit[5] as_muzzle;          // muzzle-flash light
unit[5] as_laser;           // laser sight
fixed[5] as_infestUntil;    // parasite infestation damage over time
fixed[5] as_hurtFlash;
fixed[5] as_knockX;
fixed[5] as_knockY;
int[5] as_kills;
int[5] as_shotsFired;
int[5] as_shotsHit;
bool[5] as_god;
bool[5] as_help;
fixed[5] as_ammoMsgAt;
unit[5] as_camUnit;         // what the camera is following

// ---- weapons ----------------------------------------------------------
// Numbers from Alien Swarm's scripts/asw_weapon_*.txt (clip, base_damage,
// fire_rate, reload_time, num_pellets) and cfg/skill.cfg (sk_max_* reserves).
struct AS_Gun {
    string name;
    int mag;
    int reserve;
    fixed damage;
    fixed rate;        // seconds between shots
    fixed reload;
    int pellets;
    fixed spread;      // degrees, full cone
    fixed range;
    int kind;          // 0 hitscan, 1 flamer, 2 railgun, 3 grenade launcher, 4 tesla, 5 minigun
    bool semi;
    int pierce;        // extra aliens a shot passes through
    string tint;
    string snd;
    fixed recoilSlow;  // movement multiplier while firing
};
AS_Gun[11] as_gun;

