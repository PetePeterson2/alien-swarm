// =====================================================================
// The missions. Mission 1, LANDING BAY (tools/landingbay.py), after Alien
// Swarm's asi-jac1-landingbay_01: its doors, spawners and triggers come from
// the level's tables (src/Objects.galaxy, src/Doors.galaxy), its objectives
// and set pieces are below. Mission 2, CARGO ELEVATOR (tools/cargo.py):
// objectives, the security door, scripted moments, the elevator ride, the
// escape. Both share the stages and the extraction.
//
// Alien Swarm's rules on death: nobody comes back during a mission and there
// are no checkpoints. When the whole squad is down (0.6 s after the last), or
// the mission needs a tech and the last one dies before the hack is done, the
// mission is failed, and the squad restarts it from the briefing.
//
// The elevator never moves. The platform is fixed floor ringed by black;
// the shaft walls round it are units (tools/elevator.py panels) that hang
// below their origin and scroll upward, so they rise out of the floor line
// and leave the top of the screen: the platform reads as going down. The
// entrance lintel and gates ride up out of sight with the walls; near the
// bottom the exit lintel is swapped into the panel slot that will stop at
// the floor, and comes up into place as the lift brakes.
// =====================================================================

int as_stage;                    // AS_ST_*
fixed as_stageAt;
int as_checkpoint;
fixed as_missionStart;
fixed as_missionEnd;
fixed as_victoryAt;
const int AS_ST_LAND = 0;        // landing bay to the security door (the deck: to the reactor)
const int AS_ST_DOOR = 1;        // override the door (the deck: restore the power)
const int AS_ST_LIFT = 2;        // reach the elevator
const int AS_ST_BOARD = 3;       // everyone on the platform
const int AS_ST_RIDE = 4;        // going down
const int AS_ST_ESCAPE = 5;      // out through the junction
const int AS_ST_DONE = 6;

// ---- level tables (AS_MissionData, generated by build.py) ----------
int as_zoneCount;
string[16] as_zoneName;
fixed[16] as_zoneX0;
fixed[16] as_zoneY0;
fixed[16] as_zoneX1;
fixed[16] as_zoneY1;
bool[16] as_zoneHit;
int as_cpCount;
fixed[8] as_cpX;
fixed[8] as_cpY;
int as_winCount;
fixed[16] as_winX;
fixed[16] as_winY;
fixed as_liftX0;
fixed as_liftY0;
fixed as_liftX1;
fixed as_liftY1;
fixed as_extX0;
fixed as_extY0;
fixed as_extX1;
fixed as_extY1;
int as_doorX0;
int as_doorY0;
int as_doorX1;
int as_doorY1;
point as_doorPanel;
point as_liftPanel;
int[4] as_brIn;                  // entrance bridge cells x0 y0 x1 y1
int[4] as_brOut;
int as_colCount;
fixed[16] as_colX;
fixed[16] as_colY;
fixed[16] as_colW;
fixed[16] as_colFace;
string[16] as_colSide;

// ---- helpers --------------------------------------------------------
int AS_Humans () {
    int p;int n=0;
    for(p=1;p<=AS_PLAYERS;p+=1) {if(AS_Person(p)) {n+=1;}}
    return n;
}
int AS_Living () {
    int p;int n=0;
    for(p=1;p<=AS_PLAYERS;p+=1) {if(AS_Person(p) && as_alive[p]) {n+=1;}}
    return n;
}
bool AS_InRect (point q, fixed x0, fixed y0, fixed x1, fixed y1) {
    fixed x=PointGetX(q);fixed y=PointGetY(q);
    return x>=x0 && x<x1 && y>=y0 && y<y1;
}
// How many living marines stand in the rectangle.
int AS_CountIn (fixed x0, fixed y0, fixed x1, fixed y1) {
    int p;int n=0;
    for(p=1;p<=AS_PLAYERS;p+=1) {if(AS_Person(p) && as_alive[p] && AS_InRect(UnitGetPosition(as_m[p]),x0,y0,x1,y1)) {n+=1;}}
    return n;
}
void AS_All (string big, string small) {
    int p;
    for(p=1;p<=AS_PLAYERS;p+=1) {if(AS_Person(p)) {AS_Announce(p,big,small);}}
}
void AS_AllMsg (string s) {
    int p;
    for(p=1;p<=AS_PLAYERS;p+=1) {if(AS_Person(p)) {AS_Message(p,s);}}
}
void AS_AllSound (string id) {
    SoundPlay(SoundLink(id,-1),PlayerGroupAll(),100.0,0.0);
}
void AS_ShakeAll (fixed strength, fixed secs) {
    int p;
    for(p=1;p<=AS_PLAYERS;p+=1) {if(AS_Person(p)) {CameraShakeStart(p,c_cameraPositionBoth,c_cameraDirectionXYZ,strength,6.0,40.0,secs);}}
}
// More aliens for a bigger squad: the base count for one marine, scaled.
int AS_Scaled (int base) {
    int n=AS_Humans();
    return MaxI(1,FixedToInt(IntToFixed(base)*(0.55+0.3*IntToFixed(n))+0.5));
}
void AS_SetCell (int x0, int y0, int x1, int y1, bool solid) {
    int x;int y;
    for(x=x0;x<x1;x+=1) {for(y=y0;y<y1;y+=1) {as_wall[x][y]=solid;}}
}

// ---- objectives -------------------------------------------------------
string[5] as_objName;
int[5] as_objState;              // 0 hidden, 1 active, 2 done
int as_objCount = 4;
point as_objAt;
unit as_beacon;
unit as_beaconLight;
void AS_Objective (int k, int state) {
    if(as_objState[k]==state) {return;}
    as_objState[k]=state;
    if(state==2) {AS_AllSound("Alert_UniObjectiveCompleted");}
    else if(state==1) {AS_AllSound("Alert_UniObjectiveDiscovered");}
}
void AS_MarkAt (fixed x, fixed y) {
    as_objAt=Point(x,y);
    if(as_beacon==null) {
        UnitCreate(1,"ASObjBeacon",c_unitCreateIgnorePlacement,0,as_objAt,270.0);as_beacon=UnitLastCreated();
        UnitCreate(1,"ASLightGreen",c_unitCreateIgnorePlacement,0,as_objAt,270.0);as_beaconLight=UnitLastCreated();
        UnitSetHeight(as_beaconLight,1.4,0.0);
    }
    UnitSetPosition(as_beacon,as_objAt,false);UnitSetPosition(as_beaconLight,as_objAt,false);
    libNtve_gf_ShowHideUnit(as_beacon,true);libNtve_gf_ShowHideUnit(as_beaconLight,true);
}
void AS_MarkOff () {
    as_objAt=null;
    if(as_beacon!=null) {libNtve_gf_ShowHideUnit(as_beacon,false);libNtve_gf_ShowHideUnit(as_beaconLight,false);}
}
// "NE  34 m" from a marine to the objective, for the HUD.
string AS_ObjBearing (int p) {
    point here;fixed a;fixed d;string dir;int k;
    if(as_objAt==null || !as_alive[p]) {return "";}
    here=UnitGetPosition(as_m[p]);d=DistanceBetweenPoints(here,as_objAt);
    if(d<3.0) {return "<c val=\"8CFFA0\">HERE</c>";}
    a=ATan2(PointGetY(as_objAt)-PointGetY(here),PointGetX(as_objAt)-PointGetX(here));
    k=FixedToInt(ModF(a+22.5+360.0,360.0)/45.0)%8;
    dir="E";
    if(k==1) {dir="NE";}else if(k==2) {dir="N";}else if(k==3) {dir="NW";}else if(k==4) {dir="W";}
    else if(k==5) {dir="SW";}else if(k==6) {dir="S";}else if(k==7) {dir="SE";}
    return dir+"  "+IntToString(FixedToInt(d))+" m";
}

// ---- the security door ------------------------------------------------
unit[2] as_doorLeaf;
unit[4] as_doorBlock;
fixed as_hack;                   // 0..1 override progress
fixed as_doorOpenAt;             // leaves slide from this time
bool as_doorOpen;
bool as_hackHorde;
bool as_hackDone;                // the console's job is done (the door overridden, the power back)
string as_hackLabel;             // what the progress bar says while the console is held
void AS_DoorBuild () {
    int i;fixed cy=(IntToFixed(as_doorY0)+IntToFixed(as_doorY1))*0.5;fixed cx=(IntToFixed(as_doorX0)+IntToFixed(as_doorX1))*0.5;
    for(i=0;i<2;i+=1) {
        UnitCreate(1,"ASEDoor",c_unitCreateIgnorePlacement,0,Point(cx-1.0+2.0*IntToFixed(i),cy),270.0);as_doorLeaf[i]=UnitLastCreated();
    }
    AS_SetCell(as_doorX0,as_doorY0,as_doorX1,as_doorY1,true);
    for(i=0;i<as_doorX1-as_doorX0;i+=1) {
        UnitCreate(1,"PathingBlocker1x1",c_unitCreateIgnorePlacement,0,Point(IntToFixed(as_doorX0+i)+0.5,cy),0.0);as_doorBlock[i]=UnitLastCreated();
    }
}
void AS_DoorPulse () {
    fixed t;int i;fixed cy=(IntToFixed(as_doorY0)+IntToFixed(as_doorY1))*0.5;fixed cx=(IntToFixed(as_doorX0)+IntToFixed(as_doorX1))*0.5;
    if(as_doorOpenAt<=0.0 || as_doorOpen) {return;}
    t=AS_Clamp((as_now-as_doorOpenAt)/1.4,0.0,1.0);
    UnitSetPosition(as_doorLeaf[0],Point(cx-1.0-1.9*t,cy),true);
    UnitSetPosition(as_doorLeaf[1],Point(cx+1.0+1.9*t,cy),true);
    if(t>=0.6 && as_wall[as_doorX0][as_doorY0]) {
        AS_SetCell(as_doorX0,as_doorY0,as_doorX1,as_doorY1,false);
        for(i=0;i<4;i+=1) {if(as_doorBlock[i]!=null) {UnitRemove(as_doorBlock[i]);as_doorBlock[i]=null;}}
        AS_KitUnblock(as_doorX0,as_doorY0,as_doorX1,as_doorY1);
        AS_Log("door open");
    }
    if(t>=1.0) {as_doorOpen=true;}
}
// The hull kit lays its blockers a few ticks after the mission has shut the door and the exit bridge, so it
// shuts their cells too: take away every kit blocker lying wholly inside the rectangle when it opens.
void AS_KitUnblock (int x0, int y0, int x1, int y1) {
    int i;int n=0;point q;fixed x;fixed y;fixed r;
    for(i=0;i<as_kitUnitN;i+=1) {
        if(as_kitUnit[i]==null || UnitGetType(as_kitUnit[i])==null) {continue;}
        if(UnitGetType(as_kitUnit[i])=="PathingBlocker2x2") {r=1.0;}
        else if(UnitGetType(as_kitUnit[i])=="PathingBlocker1x1") {r=0.5;}
        else {continue;}
        q=UnitGetPosition(as_kitUnit[i]);x=PointGetX(q);y=PointGetY(q);
        if(x-r<IntToFixed(x0)-0.01 || x+r>IntToFixed(x1)+0.01 || y-r<IntToFixed(y0)-0.01 || y+r>IntToFixed(y1)+0.01) {continue;}
        UnitRemove(as_kitUnit[i]);as_kitUnit[i]=null;n+=1;
    }
    AS_Log("kit blockers cleared "+IntToString(n));
}
void AS_HackPulse () {
    int p;int at=0;string s;
    if(as_stage!=AS_ST_DOOR) {return;}
    for(p=1;p<=AS_PLAYERS;p+=1) {
        if(AS_Person(p) && as_alive[p] && DistanceBetweenPoints(UnitGetPosition(as_m[p]),as_doorPanel)<1.7) {at+=1;}
    }
    if(at>0) {
        // A second marine at the panel helps a little; the rest of the squad holds the corridor.
        as_hack=MinF(1.0,as_hack+AS_DT/(9.0-1.5*IntToFixed(MinI(at,2)-1)));
        if(!as_hackHorde && as_hack>0.15) {
            as_hackHorde=true;
            AS_ScriptedHorde(AS_Scaled(10));
        }
    }
    if(as_hack>=1.0) {AS_HackDone();}
}
void AS_HackDone () {
    as_hackDone=true;as_stageAt=as_now;
    AS_Objective(0,2);AS_Objective(1,1);
    as_stage=AS_ST_LIFT;as_doorOpenAt=as_now;
    SoundPlayAtPoint(SoundLink("Doodad_SecurityGateDiagonalOpen",-1),PlayerGroupAll(),as_doorPanel,0.5,100.0,0.0);
    AS_All("DOOR OVERRIDDEN","Push through the crew quarters to the cargo elevator");AS_Log("door overridden");
    as_checkpoint=1;
    AS_MarkAt(74.0,96.0);
}

// ---- scripted moments -------------------------------------------------
fixed[16] as_burstAt;            // gallery windows give way at these times
int as_burstNext;
void AS_GalleryStart () {
    int k;
    for(k=0;k<as_winCount;k+=2) {as_burstAt[k/2]=as_now+0.5+IntToFixed(k/2)*1.3;}
    as_burstNext=0;AS_Log("gallery windows");
    AS_Sound("Ultralisk_Attack",20.0,48.0,100.0,0.0);
}
void AS_GalleryPulse () {
    int k;fixed x;fixed y;int n;int i;
    if(as_burstNext<0 || as_burstNext*2>=as_winCount) {return;}
    if(as_now<as_burstAt[as_burstNext]) {return;}
    k=as_burstNext*2;as_burstNext+=1;
    x=as_winX[k]-0.6;y=(as_winY[k]+as_winY[k+1])*0.5+0.5;
    // Glass and sparks blown into the gallery, then whatever broke it.
    AS_Burst(x,y,1.2,1.4,"200,230,255",3);AS_Flash(x,y,1.2,1.8,"220,240,255");
    for(i=0;i<5;i+=1) {AS_Fx("ASFxSpark",x-RandomFixed(0.0,1.2),y+RandomFixed(-0.9,0.9),RandomFixed(0.4,1.6),RandomFixed(0.0,360.0));}
    AS_Sound("Doodad_SecurityGateDiagonalImpact",x,y,100.0,0.0);
    AS_ShakeAll(0.12,0.3);
    n=AS_Scaled(2);
    for(i=0;i<n;i+=1) {AS_SpawnNear(AS_DRONE,x-0.6-RandomFixed(0.0,1.0),y+RandomFixed(-0.8,0.8),true);}
    if(as_burstNext==3) {AS_SpawnNear(AS_PARASITE,x-1.0,y,true);}
}
fixed as_ventBlowAt;
actor as_ventFire;               // the fire the blast leaves, cleared with the level
void AS_VentBlow () {
    int p;point q;fixed x=17.5;fixed y=87.0;int i;
    AS_Log("vent blows");
    AS_Fx("ASFxBigBoom",x,y,0.6,0.0);AS_Fx("ASFxBoom",x+0.8,y+0.6,0.4,0.0);
    AS_Burst(x,y,1.0,3.0,"255,150,60",6);AS_Flash(x,y,1.0,3.2,"255,160,80");
    AS_Sound("Explosion_TrainEngineExplode",x,y,100.0,0.0);
    AS_ShakeAll(0.25,0.6);
    for(p=1;p<=AS_PLAYERS;p+=1) {
        if(!AS_Person(p) || !as_alive[p]) {continue;}
        q=UnitGetPosition(as_m[p]);
        if(DistanceBetweenPoints(q,Point(x,y))<3.0) {AS_HurtMarine(p,12.0,x,y,6.0);}
    }
    for(i=0;i<AS_Scaled(3);i+=1) {AS_SpawnNear(AS_PARASITE,x+RandomFixed(-0.5,0.5),y+RandomFixed(-0.5,0.5),true);}
    as_ventFire=libNtve_gf_CreateActorAtPoint("ASR_DOM_Fire_Large",Point(x,y));
    ActorSend(as_ventFire,libNtve_gf_SetPosition(x,y,as_floorZ));
}

// ---- the elevator -----------------------------------------------------
const int AS_SLOTS = 5;
const fixed AS_PANEL = 6.0;          // panel height (tools/elevator.py PANEL_H)
const fixed AS_CYCLE = 30.0;         // AS_SLOTS panels: the wall always reaches 24 up, above the top of the screen
const fixed AS_RIDE_V = 1.5;         // top speed, units a second
const fixed AS_RIDE_A = 0.55;        // braking and starting
const fixed AS_RIDE_LEN = 108.0;     // a multiple of AS_PANEL: the exit lintel then stops at the floor
unit[16][5] as_pan;
unit[16][5] as_panSpare;             // the door slots' plain panel, used once the lintel has gone by
fixed[16][5] as_panH;
int as_inCol = -1;
int as_outCol = -1;
int as_outSlot;
bool as_inGone;
bool as_outSet;
unit as_lintelIn;
unit as_lintelOut;
unit[2] as_gateIn;
unit[2] as_gateOut;
unit as_bridgeIn;
unit as_bridgeOut;
unit as_platform;
unit as_void;
unit[4] as_brBlock;
fixed as_scroll;
fixed as_scrollV;
int as_ride;                         // 0 waiting, 1 closing, 2 moving, 3 braking done / opening, 4 open
fixed as_rideAt;                     // when this ride phase began
fixed as_boardAt;                    // countdown start (everyone aboard)
unit[2] as_alarm;
unit[2] as_liftSpin;
unit[6] as_shaftLight;
fixed[6] as_shaftLightPhase;
int as_rideWave;
fixed as_rideClock;                  // seconds since the platform started moving
bool as_surge;

fixed AS_ColAlongX (int c) {return Cos(as_colFace[c]+90.0);}
fixed AS_ColAlongY (int c) {return Sin(as_colFace[c]+90.0);}
// Lay a mission piece's face the way its column looks (panels are authored facing south).
void AS_PieceTurn (unit u, fixed facing) {
    AS_KitTurn(libNtve_gf_MainActorofUnit(u),facing-270.0);
}
unit AS_Piece (string kind, fixed x, fixed y, fixed facing, fixed h) {
    unit u;
    UnitCreate(1,kind,c_unitCreateIgnorePlacement,0,Point(x,y),facing);
    u=UnitLastCreated();
    AS_PieceTurn(u,facing);
    UnitSetHeight(u,h,0.0);
    return u;
}
// A gate leaf of column c: i 0 the left leaf, 1 the right; open 0 shut .. 1 in the wall.
point AS_GatePoint (int c, int i, fixed open) {
    fixed s=IntToFixed(i*2-1);fixed off=s*(1.0+2.0*open);
    return Point(as_colX[c]+AS_ColAlongX(c)*off-Cos(as_colFace[c])*0.12,as_colY[c]+AS_ColAlongY(c)*off-Sin(as_colFace[c])*0.12);
}
void AS_LiftBuild () {
    int c;int k;string kind;fixed cx=(as_liftX0+as_liftX1)*0.5;fixed cy=(as_liftY0+as_liftY1)*0.5;
    UnitCreate(1,"ASEPlatform",c_unitCreateIgnorePlacement,0,Point(cx,cy),270.0);as_platform=UnitLastCreated();
    UnitCreate(1,"ASEVoid",c_unitCreateIgnorePlacement,0,Point(cx,cy),270.0);as_void=UnitLastCreated();
    for(c=0;c<as_colCount;c+=1) {
        if(as_colSide[c]=="W" && AbsF(as_colY[c]-cy)<0.1) {as_inCol=c;}
        if(as_colSide[c]=="E" && AbsF(as_colY[c]-cy)<0.1) {as_outCol=c;}
        for(k=0;k<AS_SLOTS;k+=1) {
            // Every third panel up the shaft carries lamps.
            kind="ASEShaftA";
            if((k+c)%3==0) {kind="ASEShaftB";}
            else if((k*3+c)%7==2 && as_colW[c]>3.0) {kind="ASEShaftC";}
            kind=kind+IntToString(FixedToInt(as_colW[c]));
            as_panH[c][k]=IntToFixed(k)*AS_PANEL;
            as_pan[c][k]=AS_Piece(kind,as_colX[c],as_colY[c],as_colFace[c],as_panH[c][k]);
        }
    }
    // The entrance: its lintel stands in slot 1 (bottom at the floor), the gates open in it, the bridge out.
    if(as_inCol>=0) {
        as_panSpare[as_inCol][1]=as_pan[as_inCol][1];libNtve_gf_ShowHideUnit(as_panSpare[as_inCol][1],false);
        as_lintelIn=AS_Piece("ASELintel",as_colX[as_inCol],as_colY[as_inCol],as_colFace[as_inCol],AS_PANEL);
        as_pan[as_inCol][1]=as_lintelIn;
        for(k=0;k<2;k+=1) {as_gateIn[k]=AS_Piece("ASEGate",PointGetX(AS_GatePoint(as_inCol,k,1.0)),PointGetY(AS_GatePoint(as_inCol,k,1.0)),as_colFace[as_inCol],AS_PANEL);}
    }
    // The exit lintel and gates wait hidden until the last slot that will stop at the floor comes round.
    if(as_outCol>=0) {
        as_lintelOut=AS_Piece("ASELintel",as_colX[as_outCol],as_colY[as_outCol],as_colFace[as_outCol],0.0);
        libNtve_gf_ShowHideUnit(as_lintelOut,false);
        for(k=0;k<2;k+=1) {as_gateOut[k]=AS_Piece("ASEGate",PointGetX(AS_GatePoint(as_outCol,k,0.0)),PointGetY(AS_GatePoint(as_outCol,k,0.0)),as_colFace[as_outCol],0.0);libNtve_gf_ShowHideUnit(as_gateOut[k],false);}
        // The slot whose height is one panel (bottom at the floor) when the ride ends.
        as_outSlot=FixedToInt(ModF(AS_PANEL-AS_RIDE_LEN+AS_CYCLE*10.0,AS_CYCLE)/AS_PANEL)%AS_SLOTS;
    }
    UnitCreate(1,"ASEBridge",c_unitCreateIgnorePlacement,0,Point((IntToFixed(as_brIn[0])+IntToFixed(as_brIn[2]))*0.5,(IntToFixed(as_brIn[1])+IntToFixed(as_brIn[3]))*0.5),270.0);as_bridgeIn=UnitLastCreated();
    UnitCreate(1,"ASEBridge",c_unitCreateIgnorePlacement,0,Point((IntToFixed(as_brOut[0])+IntToFixed(as_brOut[2]))*0.5+2.0,(IntToFixed(as_brOut[1])+IntToFixed(as_brOut[3]))*0.5),270.0);as_bridgeOut=UnitLastCreated();
    libNtve_gf_ShowHideUnit(as_bridgeOut,false);
    // The exit bridge is not there yet: shut to marines and aliens.
    AS_SetCell(as_brOut[0],as_brOut[1],as_brOut[2],as_brOut[3],true);
    as_brBlock[2]=AS_Blocker2(IntToFixed(as_brOut[0])+1.0,IntToFixed(as_brOut[1])+1.0);
    as_brBlock[3]=AS_Blocker2(IntToFixed(as_brOut[0])+1.0,IntToFixed(as_brOut[1])+3.0);
    // Alarm lamps on the north rail (they turn during the ride), two red lights circling.
    for(k=0;k<2;k+=1) {
        UnitCreate(1,"ASAlarmLamp",c_unitCreateIgnorePlacement,0,Point(as_liftX0+1.0+IntToFixed(k)*(as_liftX1-as_liftX0-2.0),as_liftY1-0.4),270.0);
        as_alarm[k]=UnitLastCreated();UnitSetHeight(as_alarm[k],1.05,0.0);libNtve_gf_ShowHideUnit(as_alarm[k],false);
        UnitCreate(1,"ASLightRedbig",c_unitCreateIgnorePlacement,0,Point(cx,cy),270.0);
        as_liftSpin[k]=UnitLastCreated();UnitSetHeight(as_liftSpin[k],3.0,0.0);libNtve_gf_ShowHideUnit(as_liftSpin[k],false);
    }
    // Lamps fixed in the shaft that sweep past as the lift goes down.
    for(k=0;k<6;k+=1) {
        c=(k*7)%as_colCount;
        if(k%2==0) {UnitCreate(1,"ASLightOrangebig",c_unitCreateIgnorePlacement,0,Point(as_colX[c]+Cos(as_colFace[c])*0.7,as_colY[c]+Sin(as_colFace[c])*0.7),270.0);}
        else {UnitCreate(1,"ASLightWhite",c_unitCreateIgnorePlacement,0,Point(as_colX[c]+Cos(as_colFace[c])*0.7,as_colY[c]+Sin(as_colFace[c])*0.7),270.0);}
        as_shaftLight[k]=UnitLastCreated();libNtve_gf_ShowHideUnit(as_shaftLight[k],false);
        as_shaftLightPhase[k]=IntToFixed(k)*3.7;
    }
}
unit AS_Blocker2 (fixed x, fixed y) {
    UnitCreate(1,"PathingBlocker2x2",c_unitCreateIgnorePlacement,0,Point(x,y),0.0);
    return UnitLastCreated();
}
// Move the shaft to s: every panel to its slot height; a panel going past the top drops to the bottom.
void AS_ShaftSet (fixed s) {
    int c;int k;fixed h;bool wrap;
    for(c=0;c<as_colCount;c+=1) {
        for(k=0;k<AS_SLOTS;k+=1) {
            h=ModF(IntToFixed(k)*AS_PANEL+s,AS_CYCLE);
            wrap=h<as_panH[c][k]-0.001;
            as_panH[c][k]=h;
            if(wrap) {
                if(c==as_inCol && k==1 && !as_inGone) {
                    // The entrance has gone up out of the shaft: the plain panel takes its slot.
                    as_inGone=true;
                    libNtve_gf_ShowHideUnit(as_lintelIn,false);libNtve_gf_ShowHideUnit(as_gateIn[0],false);libNtve_gf_ShowHideUnit(as_gateIn[1],false);
                    as_pan[c][k]=as_panSpare[c][k];libNtve_gf_ShowHideUnit(as_pan[c][k],true);
                }
                if(c==as_outCol && k==as_outSlot && !as_outSet && s>AS_RIDE_LEN-AS_PANEL*1.5) {
                    // The last time round: the exit comes up from below in this slot.
                    as_outSet=true;
                    as_panSpare[c][k]=as_pan[c][k];libNtve_gf_ShowHideUnit(as_panSpare[c][k],false);
                    as_pan[c][k]=as_lintelOut;libNtve_gf_ShowHideUnit(as_lintelOut,true);
                    libNtve_gf_ShowHideUnit(as_gateOut[0],true);libNtve_gf_ShowHideUnit(as_gateOut[1],true);
                }
                UnitSetHeight(as_pan[c][k],h,0.0);
                AS_PieceTurn(as_pan[c][k],as_colFace[c]);
            }
            else {UnitSetHeight(as_pan[c][k],h,AS_DT);}
            if(c==as_inCol && k==1 && !as_inGone) {UnitSetHeight(as_gateIn[0],h,AS_DT);UnitSetHeight(as_gateIn[1],h,AS_DT);}
            if(c==as_outCol && k==as_outSlot && as_outSet) {UnitSetHeight(as_gateOut[0],h,AS_DT);UnitSetHeight(as_gateOut[1],h,AS_DT);}
        }
    }
    // Shaft lamps: fixed to the rock, so they rise with the walls; lit while they are near the deck.
    for(k=0;k<6;k+=1) {
        h=ModF(s*1.0+as_shaftLightPhase[k],20.0)-1.0;
        if(h>0.2 && h<9.0 && as_ride==2) {
            libNtve_gf_ShowHideUnit(as_shaftLight[k],true);UnitSetHeight(as_shaftLight[k],h,AS_DT);
        }
        else {libNtve_gf_ShowHideUnit(as_shaftLight[k],false);UnitSetHeight(as_shaftLight[k],0.2,0.0);}
    }
}

// Boarding: everyone alive on the platform for five seconds starts the lift.
void AS_BoardPulse () {
    int on;int alive;int p;string s;
    if(as_stage!=AS_ST_BOARD || as_ride!=0) {return;}
    on=AS_CountIn(as_liftX0,as_liftY0,as_liftX1,as_liftY1);alive=AS_Living();
    if(alive==0) {return;}
    if(on<alive) {
        if(as_boardAt>0.0) {as_boardAt=0.0;AS_AllMsg("<c val=\"FF6050\">Lift start cancelled: the whole squad must be aboard</c>");}
        if(on>0 && as_tick%24==0) {
            for(p=1;p<=AS_PLAYERS;p+=1) {
                if(AS_Person(p) && as_alive[p]) {AS_Message(p,"<c val=\"FFBA40\">"+IntToString(on)+" / "+IntToString(alive)+"</c> marines on the cargo elevator");}
            }
        }
        return;
    }
    if(as_boardAt<=0.0) {
        as_boardAt=as_now;
        AS_AllSound("AC_UI_Countdown01");
    }
    s=IntToString(MaxI(1,5-FixedToInt(as_now-as_boardAt)));
    if(as_tick%8==0) {AS_AllMsg("<c val=\"8CFFA0\">SQUAD ABOARD</c>  -  lift starting in "+s);}
    if(as_now-as_boardAt>=5.0) {AS_RideStart();}
}
void AS_RideStart () {
    int p;int k;
    as_ride=1;as_rideAt=as_now;as_stage=AS_ST_RIDE;as_stageAt=as_now;as_checkpoint=4;
    as_director=false;as_hordeLeftN=0;
    AS_Objective(1,2);AS_Objective(2,1);
    AS_MarkOff();
    // Nothing follows them down the lobby side: the bridge lifts, the gates shut.
    AS_SetCell(as_brIn[0],as_brIn[1],as_brIn[2],as_brIn[3],true);
    as_brBlock[0]=AS_Blocker2(IntToFixed(as_brIn[0])+1.0,IntToFixed(as_brIn[1])+1.0);
    as_brBlock[1]=AS_Blocker2(IntToFixed(as_brIn[0])+1.0,IntToFixed(as_brIn[1])+3.0);
    for(k=0;k<AS_MAXALIEN;k+=1) {
        // Aliens left on the platform side of the lobby gates would ride along: send them off it.
        if(as_a[k]!=null && AS_InRect(UnitGetPosition(as_a[k]),IntToFixed(as_brIn[0]),IntToFixed(as_brIn[1]),IntToFixed(as_brIn[2]),IntToFixed(as_brIn[3]))) {
            UnitSetPosition(as_a[k],Point(IntToFixed(as_brIn[0])-1.0,PointGetY(UnitGetPosition(as_a[k]))),false);
        }
    }
    SoundPlayAtPoint(SoundLink("Doodad_SecurityGateDiagonalClose",-1),PlayerGroupAll(),as_liftPanel,0.5,100.0,0.0);
    AS_AllSound("Alert_BaseUnderAttackKlaxon");
    for(k=0;k<2;k+=1) {libNtve_gf_ShowHideUnit(as_alarm[k],true);ActorSend(libNtve_gf_MainActorofUnit(as_alarm[k]),"AnimPlay Spin Stand PlayForever");}
    AS_All("CARGO ELEVATOR","Going down. Hold the platform.");AS_Log("lift boarded, gates closing");
}
void AS_RideMove () {
    fixed left;fixed want;fixed t;int k;fixed cx=(as_liftX0+as_liftX1)*0.5;fixed cy=(as_liftY0+as_liftY1)*0.5;point q;
    if(as_ride==0) {return;}
    t=as_now-as_rideAt;
    if(as_ride==1) {
        // The bridge draws back into the lobby wall, then the gates roll shut.
        q=Point((IntToFixed(as_brIn[0])+IntToFixed(as_brIn[2]))*0.5-2.2*AS_Clamp(t/1.0,0.0,1.0),(IntToFixed(as_brIn[1])+IntToFixed(as_brIn[3]))*0.5);
        UnitSetPosition(as_bridgeIn,q,true);
        if(t>=1.0) {libNtve_gf_ShowHideUnit(as_bridgeIn,false);}
        for(k=0;k<2;k+=1) {q=AS_GatePoint(as_inCol,k,1.0-AS_Clamp((t-0.8)/1.2,0.0,1.0));UnitSetPosition(as_gateIn[k],q,true);}
        if(t>=2.4) {
            as_ride=2;as_rideAt=as_now;as_scrollV=0.0;as_rideClock=0.0;
            GameSetLighting("ASAlarm",1.0);
            for(k=0;k<2;k+=1) {libNtve_gf_ShowHideUnit(as_liftSpin[k],true);}
            AS_AllSound("Event_Space2_ElevatorDescend");AS_AllSound("Event_Space02_CameraQuake");
            // The running rumble under everything until the lift stops.
            SoundPlay(SoundLink("Ambience_Lab02Train",-1),PlayerGroupAll(),70.0,0.0);as_rideSnd=SoundLastPlayed();
            AS_ShakeAll(0.2,0.8);
        }
        return;
    }
    if(as_ride==2) {
        as_rideClock+=AS_DT;
        left=AS_RIDE_LEN-as_scroll;
        want=MinF(AS_RIDE_V,SquareRoot(MaxF(0.0,2.0*AS_RIDE_A*left)));
        if(want<0.06 && left>0.0) {want=MinF(left/AS_DT,0.06);}
        if(want>as_scrollV) {as_scrollV=MinF(want,as_scrollV+AS_RIDE_A*AS_DT);}
        else {as_scrollV=want;}
        as_scroll=MinF(AS_RIDE_LEN,as_scroll+as_scrollV*AS_DT);
        AS_ShaftSet(as_scroll);
        // A steady shudder while it runs.
        if(as_tick%24==0 && as_scrollV>0.5) {AS_ShakeAll(0.035,1.6);}
        if(as_tick%40==0 && as_scrollV>0.5) {AS_Sound("ArmoryElevator_Down_1",cx,cy,70.0,2.0);}
        // The platform's rollers grind in the guide rails: sparks off the shaft walls.
        if(as_tick%5==0 && as_scrollV>0.4) {
            k=RandomInt(0,as_colCount-1);
            q=Point(as_colX[k]+AS_ColAlongX(k)*as_colW[k]*0.45*IntToFixed((as_tick/5)%2*2-1)+Cos(as_colFace[k])*0.15,as_colY[k]+AS_ColAlongY(k)*as_colW[k]*0.45*IntToFixed((as_tick/5)%2*2-1)+Sin(as_colFace[k])*0.15);
            AS_Fx("ASFxSpark",PointGetX(q),PointGetY(q),RandomFixed(0.2,1.2),as_colFace[k]);
            if(RandomInt(0,3)==0) {AS_Flash(PointGetX(q),PointGetY(q),0.6,0.5,"255,170,80");}
        }
        AS_RideWaves();
        if(as_scroll>=AS_RIDE_LEN-0.0001) {AS_RideArrive();}
    }
    else if(as_ride==3) {
        // Arrived: the exit gates part, the bridge runs out over the drop.
        for(k=0;k<2;k+=1) {q=AS_GatePoint(as_outCol,k,AS_Clamp((t-0.6)/1.4,0.0,1.0));UnitSetPosition(as_gateOut[k],q,true);}
        q=Point((IntToFixed(as_brOut[0])+IntToFixed(as_brOut[2]))*0.5+2.2*(1.0-AS_Clamp((t-1.6)/1.0,0.0,1.0)),(IntToFixed(as_brOut[1])+IntToFixed(as_brOut[3]))*0.5);
        if(t>=1.6) {libNtve_gf_ShowHideUnit(as_bridgeOut,true);UnitSetPosition(as_bridgeOut,q,true);}
        if(t>=2.6) {
            as_ride=4;
            AS_SetCell(as_brOut[0],as_brOut[1],as_brOut[2],as_brOut[3],false);
            for(k=2;k<4;k+=1) {if(as_brBlock[k]!=null) {UnitRemove(as_brBlock[k]);as_brBlock[k]=null;}}
            AS_KitUnblock(as_brOut[0],as_brOut[1],as_brOut[2],as_brOut[3]);
            AS_All("LOWER LEVEL","Fight through the freight junction to the transit station");AS_Log("exit open, escape");
            AS_Objective(2,2);AS_Objective(3,1);
            as_stage=AS_ST_ESCAPE;as_stageAt=as_now;as_checkpoint=5;
            AS_MarkAt((as_extX0+as_extX1)*0.5,(as_extY0+as_extY1)*0.5);
            as_lowerLevel=true;
        }
    }
    // The red lights circle the platform while the alarm runs.
    if(as_ride>=2 && as_ride<4) {
        for(k=0;k<2;k+=1) {UnitSetPosition(as_liftSpin[k],Point(cx+Cos(as_now*200.0+IntToFixed(k)*180.0)*4.5,cy+Sin(as_now*200.0+IntToFixed(k)*180.0)*4.5),true);}
    }
}
void AS_RideArrive () {
    int k;
    as_ride=3;as_rideAt=as_now;as_scrollV=0.0;AS_Log("lift arrived after "+FixedToString(as_rideClock,1)+" s, exit lintel set "+IntToString(BoolToInt(as_outSet))+", entrance gone "+IntToString(BoolToInt(as_inGone)));
    AS_ShaftSet(AS_RIDE_LEN);
    AS_ShakeAll(0.35,0.9);
    AS_AllSound("Event_Space02_CameraQuake");
    SoundPlayAtPoint(SoundLink("Doodad_SecurityGateDiagonalOpen",-1),PlayerGroupAll(),Point(as_colX[as_outCol],as_colY[as_outCol]),0.5,100.0,0.0);
    GameSetLighting("ASDerelict",2.5);
    // The rumble stops; the lower level sounds alive.
    if(as_rideSnd!=null) {SoundStop(as_rideSnd,true);}
    if(as_amb!=null) {SoundStop(as_amb,true);}
    SoundPlay(SoundLink("Ambience_Leviathan_EggRoom",-1),PlayerGroupAll(),50.0,0.0);as_amb=SoundLastPlayed();
    for(k=0;k<2;k+=1) {libNtve_gf_ShowHideUnit(as_liftSpin[k],false);ActorSend(libNtve_gf_MainActorofUnit(as_alarm[k]),"AnimClear Spin");}
    for(k=0;k<6;k+=1) {libNtve_gf_ShowHideUnit(as_shaftLight[k],false);}
}

// ---- what comes down the shaft ----------------------------------------
// Climbers are a stock drone model crawling head-down down a shaft wall (a model actor,
// not the alien: nothing can be shot until it drops onto the deck), then the real alien
// is made at the platform's edge a little above the deck and falls onto it.
const int AS_CLIMB = 24;
actor[24] as_climbA;
int[24] as_climbKind;
fixed[24] as_climbX;
fixed[24] as_climbY;
fixed[24] as_climbZ;
fixed[24] as_climbFace;
fixed[24] as_climbV;
void AS_Climber (int kind) {
    int i;int c;fixed off;fixed x;fixed y;string model="ASClimbDrone";
    for(i=0;i<AS_CLIMB;i+=1) {if(as_climbA[i]==null) {break;}}
    if(i>=AS_CLIMB) {return;}
    c=RandomInt(0,as_colCount-1);
    if(c==as_outCol) {c=(c+1)%as_colCount;}
    off=RandomFixed(-0.4,0.4)*as_colW[c];
    x=as_colX[c]+AS_ColAlongX(c)*off+Cos(as_colFace[c])*0.35;y=as_colY[c]+AS_ColAlongY(c)*off+Sin(as_colFace[c])*0.35;
    if(kind==AS_PARASITE) {model="ASClimbParasite";}
    else if(kind==AS_RIPPER) {model="ASClimbRipper";}
    else if(kind==AS_UBER) {model="ASClimbUber";}
    as_climbA[i]=libNtve_gf_CreateActorAtPoint(model,Point(x,y));
    as_climbKind[i]=kind;as_climbX[i]=x;as_climbY[i]=y;as_climbZ[i]=RandomFixed(5.5,8.0);as_climbFace[i]=as_colFace[c];
    as_climbV[i]=RandomFixed(3.0,4.2);
    if(kind==AS_PARASITE) {as_climbV[i]=as_climbV[i]*1.3;}
    // Head down the wall: nose (minus forward, for stock models) toward the floor, back to the wall.
    ActorSend(as_climbA[i],libNtve_gf_SetRotation(0.0,0.0,1.0,Cos(as_climbFace[i]),Sin(as_climbFace[i]),0.0));
    ActorSend(as_climbA[i],libNtve_gf_SetPosition(x,y,as_floorZ+as_climbZ[i]));
}
void AS_ClimbPulse () {
    int i;int j;fixed x;fixed y;
    for(i=0;i<AS_CLIMB;i+=1) {
        if(as_climbA[i]==null) {continue;}
        // Down the wall, faster than the wall is rising.
        as_climbZ[i]-=as_climbV[i]*AS_DT;
        if(as_climbZ[i]>0.6) {ActorSend(as_climbA[i],libNtve_gf_SetPosition(as_climbX[i],as_climbY[i],as_floorZ+as_climbZ[i]));continue;}
        ActorSend(as_climbA[i],"Destroy");as_climbA[i]=null;
        // Over the rail and onto the deck.
        x=AS_Clamp(as_climbX[i]+Cos(as_climbFace[i])*1.6,as_liftX0+0.6,as_liftX1-0.6);y=AS_Clamp(as_climbY[i]+Sin(as_climbFace[i])*1.6,as_liftY0+0.6,as_liftY1-0.6);
        j=AS_SpawnAlien(as_climbKind[i],x,y,true);
        if(j>=0) {
            UnitSetHeight(as_a[j],1.3,0.0);UnitSetHeight(as_a[j],0.0,0.35);
            as_aNextOrder[j]=as_now+0.3;as_aNextAttack[j]=as_now+0.6;
            AS_Sound("Broodling_Attack",x,y,70.0,0.15);
        }
    }
}
// Buzzers come up out of the drop on the open south side.
void AS_FromDrop (int kind, int n) {
    int i;fixed x;
    for(i=0;i<n;i+=1) {
        x=RandomFixed(as_liftX0+1.0,as_liftX1-1.0);
        AS_SpawnAlien(kind,x,as_liftY0-1.2-RandomFixed(0.0,0.6),true);
    }
}
void AS_Climbers (int kind, int n) {
    int i;
    // Two in five more than asked: the first in-client run found the ride too easy.
    for(i=0;i<(n*7+2)/5;i+=1) {AS_Climber(kind);}
}
void AS_RideWaves () {
    int n=AS_Humans();fixed t=as_rideClock;int k;
    // Each wave once, at its time; climbers trickle, so a wave is a few seconds of contacts.
    if(as_rideWave==0 && t>5.0) {as_rideWave=1;AS_AllMsg("<c val=\"FF5040\">Movement on the shaft walls</c>");AS_Climbers(AS_DRONE,AS_Scaled(3));}
    if(as_rideWave==1 && t>9.0) {as_rideWave=2;AS_Climbers(AS_DRONE,AS_Scaled(3));}
    if(as_rideWave==2 && t>16.0) {as_rideWave=3;AS_FromDrop(AS_BUZZER,AS_Scaled(2));AS_Climbers(AS_DRONE,AS_Scaled(2));}
    if(as_rideWave==3 && t>23.0) {as_rideWave=4;AS_Climbers(AS_DRONE,AS_Scaled(4));AS_Climbers(AS_PARASITE,AS_Scaled(2));}
    if(as_rideWave==4 && t>31.0) {
        as_rideWave=5;AS_Climbers(AS_DRONE,AS_Scaled(3));
        if(n>=2) {AS_Climber(AS_UBER);}
    }
    if(as_rideWave==5 && t>38.0) {
        // Power surge: every light dies for a moment, sparks across the platform.
        as_rideWave=6;as_surge=true;
        GameSetLighting("ASBlackout",0.15);
        for(k=0;k<2;k+=1) {libNtve_gf_ShowHideUnit(as_liftSpin[k],false);}
        AS_AllMsg("<c val=\"FF5040\">POWER SURGE</c>");AS_AllSound("FX_Lab01DoorMalfunction");
        for(k=0;k<8;k+=1) {AS_Fx("ASFxSpark",RandomFixed(as_liftX0,as_liftX1),RandomFixed(as_liftY0,as_liftY1),RandomFixed(0.5,2.5),RandomFixed(0.0,360.0));}
        AS_ShakeAll(0.18,0.6);
    }
    if(as_rideWave==6 && t>40.5) {
        as_rideWave=7;as_surge=false;
        GameSetLighting("ASAlarm",0.4);
        for(k=0;k<2;k+=1) {libNtve_gf_ShowHideUnit(as_liftSpin[k],true);}
        AS_Climbers(AS_DRONE,AS_Scaled(4));AS_FromDrop(AS_BUZZER,AS_Scaled(2));
    }
    if(as_rideWave==7 && t>48.0) {
        as_rideWave=8;AS_Climbers(AS_PARASITE,AS_Scaled(4));
        if(n>=3) {AS_Climber(AS_RIPPER);}
    }
    if(as_rideWave==8 && t>55.0) {as_rideWave=9;AS_Climbers(AS_DRONE,AS_Scaled(5));if(n>=2) {AS_Climber(AS_UBER);}}
    if(as_rideWave==9 && t>62.0) {as_rideWave=10;AS_Climbers(AS_DRONE,AS_Scaled(4));AS_Climbers(AS_PARASITE,AS_Scaled(2));AS_FromDrop(AS_BUZZER,AS_Scaled(1));}
    if(as_rideWave==10 && t>67.0) {as_rideWave=11;AS_AllMsg("<c val=\"8CFFA0\">Braking - lower level coming up</c>");}
}

// ---- failure -------------------------------------------------------------
// The whole squad down: the mission is lost 0.6 s after the last marine fell (asw_last_marine_dead_delay).
// A mission that needs a tech (asw_tech_marine_req) is lost too if the last tech dies while it still does:
// "RESTARTING MISSION" for 5 s, then the failure screen (or a straight restart in the first 30 s).
bool as_needTech;                // the level's tech requirement is still on
fixed as_failAt;
string as_failWhy;
bool as_failed;
fixed as_techRestartAt;
void AS_WipePulse () {
    if(as_stage==AS_ST_DONE || as_failed) {return;}
    if(as_failAt==0.0 && AS_Living()==0 && AS_Humans()>0) {as_failAt=as_now+0.6;as_failWhy="";AS_Log("squad wiped");}
    // The last tech fell while the mission still needs one: AS restarts the mission in place, however far in
    // (asw_marine.cpp ScheduleTechFailureRestart, asw_gamerules.cpp CheckTechFailure); a full wipe fails it instead.
    if(as_techRestartAt>0.0 && as_now>=as_techRestartAt) {
        as_techRestartAt=0.0;
        if(AS_Living()>0) {AS_Log("no tech: restart");as_failed=true;as_stage=AS_ST_DONE;AS_MissionRestart();return;}
    }
    if(as_failAt>0.0 && as_now>=as_failAt) {
        as_failAt=0.0;as_failed=true;as_stage=AS_ST_DONE;as_missionEnd=as_now;
        as_director=false;
        AS_SpawnersClear();
        AS_Log("MISSION FAILED "+as_failWhy);AS_LogStatus();
        AS_MissionLost(as_failWhy);
    }
}
// A marine has died: is a tech still alive when the mission needs one?
void AS_MissionMarineDied (int p) {
    int q;bool tech=false;
    if(!as_needTech || as_stage==AS_ST_DONE || as_failed || AS_Living()==0) {return;}
    for(q=1;q<=AS_PLAYERS;q+=1) {if(AS_Person(q) && as_alive[q] && AS_IsTech(q)) {tech=true;}}
    if(tech || as_techRestartAt>0.0) {return;}
    as_techRestartAt=as_now+1.5+5.0;
    AS_All("RESTARTING MISSION","<c val=\"FF5040\">No live Tech Marine</c>  -  mission restart in 5 seconds");
    AS_AllSound("Alert_UniObjectiveFailed");
    AS_Log("last tech down");
}

// ---- zones and stages -------------------------------------------------
void AS_ZoneEnter (string z) {
    int k;
    if(z=="gallery") {AS_GalleryStart();}
    else if(z=="door") {
        if(as_stage==AS_ST_LAND) {
            as_stage=AS_ST_DOOR;as_stageAt=as_now;AS_Objective(0,1);
            AS_All("SECURITY DOOR","Hold position at the console to override it");AS_Log("at the security door");
            AS_MarkAt(PointGetX(as_doorPanel),PointGetY(as_doorPanel));
        }
    }
    else if(z=="vent") {as_ventBlowAt=as_now+0.4;}
    else if(z=="concourse") {as_scriptHordeAt=as_now+25.0;}
    else if(z=="lobby") {
        if(as_stage<=AS_ST_LIFT) {
            as_stage=AS_ST_BOARD;as_stageAt=as_now;as_checkpoint=3;
            AS_All("CARGO ELEVATOR","Get the whole squad onto the platform");AS_Log("lobby reached");
            AS_MarkAt((as_liftX0+as_liftX1)*0.5,(as_liftY0+as_liftY1)*0.5);
        }
    }
    else if(z=="quarters") {as_checkpoint=MaxI(as_checkpoint,1);}
    else if(z=="shaft") {as_checkpoint=MaxI(as_checkpoint,5);}
}
void AS_ZonePulse () {
    int z;
    for(z=0;z<as_zoneCount;z+=1) {
        if(as_zoneHit[z]) {continue;}
        if(AS_CountIn(as_zoneX0[z],as_zoneY0[z],as_zoneX1[z],as_zoneY1[z])>0) {as_zoneHit[z]=true;AS_ZoneEnter(as_zoneName[z]);}
    }
}
string as_extName;                // where the squad extracts, for the count messages
// The finale: the first marine on the transit platform calls the car; the squad holds until it comes.
const fixed AS_HOLD = 45.0;
fixed as_holdAt;
fixed as_holdWave;
bool AS_HoldPulse (int on) {
    if(as_holdAt==0.0) {
        if(on==0) {return true;}
        as_holdAt=as_now;as_holdWave=as_now+3.0;
        AS_All("TRANSIT CAR INBOUND","Hold the platform for "+IntToString(FixedToInt(AS_HOLD))+" seconds");AS_Log("hold starts");
        AS_AllSound("Event_Lab02_AlarmIncomingAttack");
        GameSetLighting("ASAlarm",1.0);
        AS_MarkOff();
        return true;
    }
    if(as_now<as_holdAt+AS_HOLD) {
        // A swarm every dozen seconds from the station's vents, heavier as the car gets close.
        if(as_now>=as_holdWave && as_hordeLeftN<=0) {
            // The director's own horde size grows wave on wave (30 and more by now): the hold's are sized to the squad.
            as_holdWave=as_now+12.0;AS_ScriptedHorde(AS_Scaled(6));
            if(as_now>as_holdAt+25.0) {AS_SpawnNear(AS_BOOMER,111.0,43.0,true);}
        }
        return true;
    }
    if(as_holdWave>0.0) {
        as_holdWave=0.0;
        AS_All("TRANSIT CAR ARRIVED","Everyone onto the platform");AS_Log("car arrived");
        // No more swarms: what is left is getting the squad aboard.
        as_director=false;as_hordeLeftN=0;
        SoundPlayAtPoint(SoundLink("Doodad_TrainDockingDoorOpen",-1),PlayerGroupAll(),Point(111.0,20.0),0.5,100.0,0.0);
        AS_Flash(111.0,20.0,1.5,6.0,"255,240,200");
        GameSetLighting("ASDerelict",2.0);
        AS_MarkAt((as_extX0+as_extX1)*0.5,(as_extY0+as_extY1)*0.5);
    }
    return false;
}
bool AS_InExtract (fixed x, fixed y) {return x>=as_extX0 && x<as_extX1 && y>=as_extY0 && y<as_extY1;}
bool AS_MissionOver () {return as_stage==AS_ST_DONE;}
void AS_ExtractPulse () {
    int on;int alive;int p;int i;
    if(as_stage!=AS_ST_ESCAPE) {return;}
    on=AS_CountIn(as_extX0,as_extY0,as_extX1,as_extY1);alive=AS_Living();
    if(as_level==AS_LV_CARGO && AS_HoldPulse(on)) {return;}
    if(as_level==AS_LV_BAY && (as_objState[0]!=2 || as_objState[1]!=2)) {return;}
    if(alive==0 || on<alive) {
        if(on>0 && as_tick%24==0) {AS_AllMsg("<c val=\"FFBA40\">"+IntToString(on)+" / "+IntToString(alive)+"</c> marines at "+as_extName);}
        as_victoryAt=0.0;return;
    }
    if(as_victoryAt==0.0) {as_victoryAt=as_now+2.0;AS_AllMsg("<c val=\"8CFFA0\">Squad at "+as_extName+"</c>");}
    if(as_now<as_victoryAt) {return;}
    as_stage=AS_ST_DONE;as_missionEnd=as_now;AS_Log("MISSION COMPLETE "+as_levelTitle[as_level]+" in "+FixedToString(as_now-as_missionStart,1)+" s");AS_LogStatus();
    AS_SpawnersClear();
    AS_Objective(as_objCount-1,2);AS_MarkOff();
    as_director=false;as_hordeLeftN=0;
    GameSetLighting("ASPowered",3.0);
    AS_AllSound("Alert_Victory");
    // God mode first: boomers bursting in the clean-up below would otherwise still down a marine.
    for(p=1;p<=AS_PLAYERS;p+=1) {if(AS_Person(p)) {as_god[p]=true;}}
    for(i=0;i<AS_MAXALIEN;i+=1) {if(as_a[i]!=null && as_aKind[i]!=AS_EGG && as_aKind[i]!=AS_BIOMASS) {AS_KillAlien(i,0,1);}}
    // Progress into every marine's bank, the debrief, then the next level (src/Campaign.galaxy).
    AS_MissionWon();
}

// The deck as the squad finds it: sleepers in the rooms, scaled to the squad.
void AS_MissionPopulate () {
    int r;
    if(as_level==AS_LV_BAY) {AS_BayPopulate();return;}
    for(r=0;r<as_roomCount;r+=1) {
        if(as_roomName[r]=="Bay Corridor") {AS_Populate(r,AS_DRONE,AS_Scaled(2));}
        if(as_roomName[r]=="Security Office") {AS_Populate(r,AS_DRONE,AS_Scaled(2));}
        if(as_roomName[r]=="Crew Quarters") {AS_Populate(r,AS_DRONE,AS_Scaled(5));AS_Populate(r,AS_BUZZER,AS_Scaled(1));AS_Populate(r,AS_PARASITE,AS_Scaled(2));}
        if(as_roomName[r]=="Upper Concourse") {AS_Populate(r,AS_DRONE,AS_Scaled(3));AS_Populate(r,AS_RANGER,1);}
        if(as_roomName[r]=="Cargo Office") {AS_Populate(r,AS_DRONE,AS_Scaled(2));if(AS_Humans()>=2) {AS_Populate(r,AS_BOOMER,1);}}
        if(as_roomName[r]=="Elevator Lobby") {AS_Populate(r,AS_DRONE,AS_Scaled(3));if(AS_Humans()>=3) {AS_Populate(r,AS_SHIELDBUG,1);} else {AS_Populate(r,AS_UBER,1);}}
        if(as_roomName[r]=="Freight Junction") {AS_Populate(r,AS_DRONE,AS_Scaled(5));AS_Populate(r,AS_RANGER,AS_Scaled(1));AS_Populate(r,AS_HARVESTER,1);}
        if(as_roomName[r]=="Service Shaft") {AS_Populate(r,AS_PARASITE,AS_Scaled(3));}
        if(as_roomName[r]=="Colony Concourse") {AS_Populate(r,AS_DRONE,AS_Scaled(4));AS_Populate(r,AS_RIPPER,1);AS_Populate(r,AS_MORTAR,1);}
        if(as_roomName[r]=="Transit Station") {AS_Populate(r,AS_DRONE,AS_Scaled(3));AS_Populate(r,AS_BOOMER,1);}
    }
}
// A level's mission from the start: every stage, beat and ride value back to the beginning
// (a level played after another finds what the last one left), then its own set pieces.
void AS_MissionInit () {
    int k;
    as_probeAuto=0.0;
    as_missionStart=as_now;as_missionEnd=0.0;as_checkpoint=0;as_stage=AS_ST_LAND;as_stageAt=as_now;
    as_failAt=0.0;as_failWhy="";as_failed=false;as_techRestartAt=0.0;as_victoryAt=0.0;as_objAt=null;as_needTech=false;
    as_hack=0.0;as_hackHorde=false;as_hackDone=false;as_doorOpenAt=0.0;as_doorOpen=false;
    as_burstNext= -1;as_ventBlowAt=0.0;
    as_inCol= -1;as_outCol= -1;as_outSlot=0;as_inGone=false;as_outSet=false;
    as_scroll=0.0;as_scrollV=0.0;as_ride=0;as_rideAt=0.0;as_boardAt=0.0;as_rideWave=0;as_rideClock=0.0;as_surge=false;
    as_holdAt=0.0;as_holdWave=0.0;as_lowerLevel=false;
    as_crumbHead= -1;as_crumbN=0;
    for(k=0;k<5;k+=1) {as_objState[k]=0;}
    if(as_level==AS_LV_BAY) {
        // All three objectives are on the list from the start, as AS shows them.
        as_objName[0]="Access the inner perimeter";as_objName[1]="Download the flight data";as_objName[2]="Get to the Landing Bay exit";as_objCount=3;
        as_extName="the escape lift";as_hackLabel="";as_needTech=true;
        as_director=false;
        AS_BayInit();
    }
    else {
        as_objName[0]="Override the security door";as_objName[1]="Reach the cargo elevator";
        as_objName[2]="Ride the elevator down";as_objName[3]="Escape to the transit station";as_objCount=4;
        as_hackLabel="OVERRIDING SECURITY DOOR";as_extName="the transit platform";
        as_director=false;
        AS_DoorBuild();AS_LiftBuild();AS_ShaftSet(0.0);
    }
    as_objState[0]=1;
    if(as_level==AS_LV_BAY) {as_objState[1]=1;as_objState[2]=1;}
    AS_MissionPopulate();
    if(as_level==AS_LV_BAY) {AS_MarkAt(30.0,42.0);}
    else {AS_MarkAt(PointGetX(as_doorPanel),PointGetY(as_doorPanel));}
    AS_Log("mission start "+as_levelTitle[as_level]+", marines "+IntToString(AS_Humans())+", bots "+IntToString(as_botCount));
}
void AS_UnitGone (unit u) {
    if(u!=null && UnitIsValid(u)) {UnitRemove(u);}
}
// Everything the mission put in the level, gone before the next one (src/Campaign.galaxy).
void AS_MissionClear () {
    int c;int k;
    AS_UnitGone(as_beacon);AS_UnitGone(as_beaconLight);as_beacon=null;as_beaconLight=null;
    for(k=0;k<2;k+=1) {
        AS_UnitGone(as_doorLeaf[k]);AS_UnitGone(as_gateIn[k]);AS_UnitGone(as_gateOut[k]);AS_UnitGone(as_alarm[k]);AS_UnitGone(as_liftSpin[k]);
        as_doorLeaf[k]=null;as_gateIn[k]=null;as_gateOut[k]=null;as_alarm[k]=null;as_liftSpin[k]=null;
    }
    for(k=0;k<4;k+=1) {AS_UnitGone(as_doorBlock[k]);AS_UnitGone(as_brBlock[k]);as_doorBlock[k]=null;as_brBlock[k]=null;}
    for(c=0;c<16;c+=1) {
        for(k=0;k<AS_SLOTS;k+=1) {AS_UnitGone(as_pan[c][k]);AS_UnitGone(as_panSpare[c][k]);as_pan[c][k]=null;as_panSpare[c][k]=null;}
    }
    AS_UnitGone(as_lintelIn);AS_UnitGone(as_lintelOut);AS_UnitGone(as_bridgeIn);AS_UnitGone(as_bridgeOut);AS_UnitGone(as_platform);AS_UnitGone(as_void);
    as_lintelIn=null;as_lintelOut=null;as_bridgeIn=null;as_bridgeOut=null;as_platform=null;as_void=null;
    for(k=0;k<6;k+=1) {AS_UnitGone(as_shaftLight[k]);as_shaftLight[k]=null;}
    for(k=0;k<AS_CLIMB;k+=1) {if(as_climbA[k]!=null) {ActorSend(as_climbA[k],"Destroy");as_climbA[k]=null;}}
    if(as_ventFire!=null) {ActorSend(as_ventFire,"Destroy");as_ventFire=null;}
    if(as_rideSnd!=null) {SoundStop(as_rideSnd,true);as_rideSnd=null;}
    as_colCount=0;as_zoneCount=0;
    AS_DoorsClear();AS_SpawnersClear();AS_TriggersClear();AS_UseClear();AS_BayClear();
}
void AS_MissionPulse () {
    if(as_tick%160==80) {AS_LogStatus();}
    AS_CrumbPulse();
    if(as_tick%4==0) {AS_ZonePulse();AS_ExtractPulse();}
    AS_HackPulse();AS_DoorPulse();AS_GalleryPulse();
    AS_DoorPulseAll();AS_SpawnerPulse();AS_TriggerPulse();AS_UsePulse();
    if(as_level==AS_LV_BAY) {AS_BayPulse();}
    if(as_ventBlowAt>0.0 && as_now>=as_ventBlowAt) {as_ventBlowAt=0.0;AS_VentBlow();}
    AS_BoardPulse();AS_RideMove();AS_ClimbPulse();AS_WipePulse();AS_CommanderPulse();
}

// ---- QA: Ctrl+L jumps the squad to the next beat (QA builds only) -----
void AS_SquadTo (fixed x, fixed y) {
    int p;
    for(p=1;p<=AS_PLAYERS;p+=1) {
        if(!AS_Person(p) || !as_alive[p]) {continue;}
        UnitSetPosition(as_m[p],Point(x+IntToFixed((p-1)%2)*1.2,y+IntToFixed((p-1)/2)*1.2),false);
        as_mvX[p]=0.0;as_mvY[p]=0.0;
    }
    as_crumbHead= -1;as_crumbN=0;
}
void AS_SkipAhead (int p) {
    if(!as_qa || !as_levelReady) {return;}
    AS_Log("QA skip from stage "+IntToString(as_stage));
    if(as_level==AS_LV_BAY) {AS_BaySkip();return;}
    if(as_stage<=AS_ST_DOOR) {
        if(as_stage==AS_ST_LAND) {AS_ZoneEnter("door");}
        as_hack=1.0;AS_HackPulse();AS_SquadTo(18.0,66.0);
    }
    else if(as_stage==AS_ST_LIFT) {AS_SquadTo(70.0,91.0);}
    else if(as_stage==AS_ST_BOARD) {AS_SquadTo(84.0,94.0);}
    else if(as_stage==AS_ST_RIDE) {if(as_ride==2) {as_scroll=MaxF(as_scroll,AS_RIDE_LEN-14.0);as_rideClock=MaxF(as_rideClock,60.0);}}
    else if(as_stage==AS_ST_ESCAPE && as_holdAt>0.0) {as_holdAt=MinF(as_holdAt,as_now-AS_HOLD+3.0);}
    else if(as_stage==AS_ST_ESCAPE) {AS_SquadTo(109.0,26.0);}
}

// =====================================================================
// LANDING BAY, after asi-jac1-landingbay_01's own logic:
//   the dropship Bloodhound pulls away from the clamps once the squad is off it,
//   and the commander checks in (co_m1_ob1, 6 s after the squad deploys);
//   the security gate's two doors are locked: a tech hacks either door panel
//   and that door opens; walking through completes "Access the inner perimeter";
//   the doors past the pump room are worth welding behind you, the tank room's
//   two doors are welded shut and the welders lie on the supply room's bench;
//   at flight control a tech hacks the escape pod's terminal: five seconds
//   later the drones start climbing out of the floor (dock_holdout_spawn_01, until
//   eight seconds after the hack is done) and more of them start on the control
//   door from the far side (breakdoor_spawn); once the data is down the commander
//   checks in again, and the squad leaves by the door the swarm broke down for
//   the escape lift; the whole living squad on it ends the mission.
// =====================================================================
int as_bayStage;                   // 0 deploying, 1 gate hacked, 2 inner perimeter, 3 hacking, 4 downloaded, 5 door open
fixed as_bayDropship;              // the dropship's departure began (0 not yet)
actor as_bayShip;
unit as_baySentrySpot;
fixed as_bayExitAt;
int as_bayComputer;                // the escape pod's terminal (the first terminal of the level)
fixed as_bayHoldStop;              // the holdout spawners stop at this time
fixed as_bayDoorForce;             // the control door opens by itself at this time if the swarm never breaks it
fixed as_sentrySpotX;              // the holo sentry (tools/landingbay.py SENTRY_SPOT)
fixed as_sentrySpotY;
string as_weldWatch;               // doors to suggest welding once the squad is past them
fixed as_weldWatchAt;
string[8] as_lineKey;
fixed[8] as_lineAt;
int as_lineN;
fixed as_lineUntil;

void AS_BayInit () {
    as_bayStage=0;as_bayDropship=0.0;as_bayExitAt=0.0;as_bayComputer=0;as_bayHoldStop=0.0;as_bayDoorForce=0.0;
    as_lineN=0;as_lineUntil=0.0;as_weldWatch="";
    // The Bloodhound at the clamps on the dock's east side.
    as_bayShip=libNtve_gf_CreateActorAtPoint("ASR_Hercules",Point(55.0,8.5));
    ActorSend(as_bayShip,libNtve_gf_SetPosition(55.0,8.5,as_floorZ));
    ActorSend(as_bayShip,"SetScale 0.8");
    AS_KitTurn(as_bayShip,180.0);
}
void AS_BayClear () {
    if(as_bayShip!=null) {ActorSend(as_bayShip,"Destroy");as_bayShip=null;}
    if(as_baySentrySpot!=null) {UnitRemove(as_baySentrySpot);as_baySentrySpot=null;}
    as_lineN=0;as_lineUntil=0.0;as_weldWatch="";
}
// The level's things on the deck at the start: drones asleep, barrels, pickups.
void AS_BayPopulate () {
    AS_LevelThings();
}
void AS_BayPulse () {
    fixed t;int d;
    // The dropship lifts off the clamps and away.
    if(as_bayDropship>0.0 && as_bayShip!=null) {
        t=as_now-as_bayDropship;
        ActorSend(as_bayShip,libNtve_gf_SetPosition(55.0+t*t*0.9,8.5+t*0.3,as_floorZ+t*t*0.25));
        if(t>6.0) {ActorSend(as_bayShip,"Destroy");as_bayShip=null;}
    }
    // The holdout spawners stop eight seconds after the hack is done.
    if(as_bayHoldStop>0.0 && as_now>=as_bayHoldStop) {
        as_bayHoldStop=0.0;AS_SpawnerStop("dock_holdout_spawn_01");AS_SpawnerStop("insane_ranger_spawn");
    }
    // If every drone sent at the control door died before it gave, the swarm still gets through in the end.
    if(as_bayDoorForce>0.0 && as_now>=as_bayDoorForce) {
        as_bayDoorForce=0.0;d=AS_DoorNamed("control");
        if(d>=0 && !as_drBroken[d]) {AS_DoorBreak(d);}
    }
    AS_WeldWatchPulse();
}
// A trigger's action that is the mission's own (src/Objects.galaxy passes the rest to the spawners).
void AS_MissionAction (string act, string arg) {
    if(act=="complete") {
        if(arg=="AccessBay" && as_objState[0]!=2) {
            AS_Objective(0,2);as_bayStage=MaxI(as_bayStage,2);
            AS_Log("objective: inner perimeter");
            AS_MarkAt(as_tmX[as_bayComputer],as_tmY[as_bayComputer]);
        }
        return;
    }
    if(act=="line") {AS_CommanderLater(arg,0.0);return;}
    if(act=="hint") {AS_HintMap(arg);return;}
    if(act=="dropship") {as_bayDropship=as_now;AS_AllSound("ColonistShip_LiftOff");AS_ShakeAll(0.08,1.2);return;}
    if(act=="music") {AS_AllSound("Event_Horner05sTerminalHack");return;}
    if(act=="sentry") {
        // The holo sentry: where the squad is shown it could set a sentry for the hold.
        if(as_baySentrySpot==null && as_sentrySpotX>0.0) {
            UnitCreate(1,"ASSentry",c_unitCreateIgnorePlacement,0,Point(as_sentrySpotX,as_sentrySpotY),180.0);
            as_baySentrySpot=UnitLastCreated();
            ActorSend(libNtve_gf_MainActorofUnit(as_baySentrySpot),"SetTintColor 90,200,255");
            ActorSend(libNtve_gf_MainActorofUnit(as_baySentrySpot),"SetOpacity 0.45");
            AS_HintSentrySpot();
        }
        return;
    }
    if(act=="weld") {as_weldWatch=arg;as_weldWatchAt=as_now;return;}
    if(act=="wall") {AS_WallBurst();return;}
}
// Weld suggestions: once the whole squad is past these doors (asw_marines_past_area), suggest welding one shut.
void AS_WeldWatchPulse () {
    int d;string first;int at;
    if(as_weldWatch=="" || as_tick%8!=3) {return;}
    at=StringFind(as_weldWatch,"|",c_stringCase);
    if(at>=1) {first=StringSub(as_weldWatch,1,at-1);}else {first=as_weldWatch;}
    d=AS_DoorNamed(first);
    if(d<0) {as_weldWatch="";return;}
    if(as_now-as_weldWatchAt>2.0) {
        as_weldWatch="";
        if(!as_drRecommend[d]) {as_drRecommend[d]=true;AS_HintWeld(d);}
    }
}
// The tank room's west wall gives way (a 10% chance as the squad passes): drone jumpers come through it.
void AS_WallBurst () {
    fixed x=12.0;fixed y=106.0;
    AS_Fx("ASFxBigBoom",x,y,1.0,0.0);AS_Burst(x,y,1.0,1.5,"200,190,170",5);
    AS_Sound("Doodad_SecurityGateDiagonalImpact",x,y,100.0,0.0);AS_ShakeAll(0.15,0.5);
    AS_Log("wall burst");
}
void AS_MissionDoorBroken (string name) {
    if(as_level!=AS_LV_BAY || name!="control") {return;}
    as_bayStage=MaxI(as_bayStage,5);as_bayDoorForce=0.0;
    AS_SpawnerStart("insane_buzz2_spawn");
    if(as_objState[1]==2) {AS_MarkAt((as_extX0+as_extX1)*0.5,(as_extY0+as_extY1)*0.5);}
}
void AS_WeldedEvent (int p, int d) {
    AS_AchieveEvent(p,"seal_of_quality");
    AS_HintEvent("door_welded",p);
}
void AS_MissionPanelHacked (int d, int p) {
    as_drLocked[d]=false;as_drHold[d]=as_now+2.0;
    AS_AllMsg("<c val=\"8CFFA0\">Access Granted</c>");
    // Hacking either gate panel opens its own door and switches the other panel off.
    if(as_level==AS_LV_BAY && as_bayStage<1) {
        as_bayStage=1;
        AS_Log("gate panel hacked: "+as_drName[d]);
        if(as_drName[d]=="gate_west" && AS_DoorNamed("gate_east")>=0) {as_drHasPanel[AS_DoorNamed("gate_east")]=false;}
        if(as_drName[d]=="gate_east" && AS_DoorNamed("gate_west")>=0) {as_drHasPanel[AS_DoorNamed("gate_west")]=false;}
        AS_MarkAt(AS_DoorCX(d),AS_DoorCY(d)+2.0);
    }
}
void AS_MissionHackStarted (int i, int p) {
    if(as_level!=AS_LV_BAY || i!=as_bayComputer) {return;}
    as_bayStage=MaxI(as_bayStage,3);
    AS_Log("flight data hack started");
    AS_AllSound("Event_Horner05sTerminalHack");
    AS_ActionLater("spawn","breakdoor_spawn",5.0);
    AS_ActionLater("spawn","dock_holdout_spawn_01",5.0);
    AS_ActionLater("spawn","insane_ranger_spawn",5.0);
    if(as_baySentrySpot!=null) {UnitRemove(as_baySentrySpot);as_baySentrySpot=null;}
    AS_MarkOff();
}
void AS_MissionHackDone (int i, int p) {
    if(as_level!=AS_LV_BAY || i!=as_bayComputer) {return;}
    // The tech requirement is lifted once the hack is through (Tech_req DisableTechMarineReq).
    as_needTech=false;as_techRestartAt=0.0;
    as_bayHoldStop=as_now+8.0;
    AS_ProtectTechCheck(i,p);
}
void AS_MissionDownloaded (int i, int p) {
    int d=AS_DoorNamed("control");
    if(as_level!=AS_LV_BAY || i!=as_bayComputer || as_objState[1]==2) {return;}
    AS_Objective(1,2);as_bayStage=MaxI(as_bayStage,4);
    // Out to the escape lift: the extraction check (AS_ExtractPulse) runs from here.
    as_stage=AS_ST_ESCAPE;as_stageAt=as_now;as_checkpoint=5;
    AS_Log("flight data downloaded");
    AS_CommanderLater("co_m1_ob2",14.0);
    as_bayDoorForce=as_now+40.0;
    if(d<0 || as_drBroken[d]) {AS_MarkAt((as_extX0+as_extX1)*0.5,(as_extY0+as_extY1)*0.5);}
    else {AS_MarkAt(AS_DoorCX(d),AS_DoorCY(d));}
}
void AS_MissionPdaRead (int i, int p) {AS_AchieveEvent(p,"read_mail");}
// Protect the Tech: the tech took no damage through the hack and the squad killed more than ten meanwhile.
void AS_ProtectTechCheck (int i, int p) {
    int q;
    if(p<1 || FixedToInt(as_dmgTaken[p])>as_cpHackTaken[i] || AS_SquadKills()-as_cpHackKills[i]<=10) {return;}
    for(q=1;q<=AS_PLAYERS;q+=1) {if(q!=p && AS_Person(q)) {AS_MedalEvent(q,"protect_tech");}}
}
// ---- the commander's lines, as subtitles ------------------------------------------------
void AS_CommanderLater (string key, fixed delay) {
    if(as_lineN>=8) {return;}
    as_lineKey[as_lineN]=key;as_lineAt[as_lineN]=as_now+delay;as_lineN+=1;
}
void AS_CommanderPulse () {
    int k;int p;string key;
    if(as_lineUntil>0.0 && as_now>as_lineUntil) {as_lineUntil=0.0;for(p=1;p<=AS_PLAYERS;p+=1) {if(AS_Person(p)) {AS_HudSubtitle(p,"");}}}
    for(k=0;k<as_lineN;k+=1) {
        if(as_lineKey[k]=="" || as_now<as_lineAt[k]) {continue;}
        key=as_lineKey[k];as_lineKey[k]="";
        for(p=1;p<=AS_PLAYERS;p+=1) {if(AS_Person(p)) {AS_HudSubtitle(p,"<c val=\"F0FFFF\">Commander:</c>  "+AS_LineText(key));}}
        AS_AllSound("AbathurA_Transmission");
        as_lineUntil=as_now+9.0;
        AS_Log("commander: "+key);
        return;
    }
}
// QA: Ctrl+L, the squad to the next beat.
void AS_BaySkip () {
    int d;
    if(as_bayStage==0) {
        d=AS_DoorNamed("gate_east");
        if(d>=0) {AS_PanelHacked(d,0);}
        AS_SquadTo(32.5,40.0);
    }
    else if(as_bayStage<=2) {
        d=AS_DoorNamed("tank_s");if(d>=0) {as_drSeal[d]=0.0;AS_DoorSeamShow(d);}
        d=AS_DoorNamed("tank_n");if(d>=0) {as_drSeal[d]=0.0;AS_DoorSeamShow(d);}
        as_bayStage=3;AS_Objective(0,2);
        AS_SquadTo(30.5,131.5);
    }
    else if(as_objState[1]!=2) {as_cpHacked[as_bayComputer]=true;as_cpLocked[as_bayComputer]=false;AS_MissionHackDone(as_bayComputer,0);as_cpDone[as_bayComputer]=1.0;AS_MissionDownloaded(as_bayComputer,0);}
    else {d=AS_DoorNamed("control");if(d>=0 && !as_drBroken[d]) {AS_DoorBreak(d);}AS_SquadTo(48.5,131.0);}
}
