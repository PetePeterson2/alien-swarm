// =====================================================================
// The missions. Mission 1, LANDING BAY (tools/landingbay.py), after Alien
// Swarm's asi-jac1-landingbay_01: its doors, spawners and triggers come from
// the level's tables (src/Objects.galaxy, src/Doors.galaxy), its objectives
// and set pieces are below. From mission 2 on (tools/cargo.py, tools/deima.py,
// tools/rydberg.py) a mission runs on its data alone: its objectives by key,
// completed by its triggers, buttons and panels (the SCRIPTED MISSIONS section
// below). CARGO ELEVATOR's lift is the one piece of machinery here: its ride
// fires "ride:go", "ride:<percent>", "ride:end" and "ride:open" for the
// level's outputs. They share the stages and the extraction.
//
// Alien Swarm's rules on death: nobody comes back during a mission and there
// are no checkpoints. When the whole squad is down (0.6 s after the last), or
// the mission needs a tech and the last one dies before the hack is done, the
// mission is failed, and the squad restarts it from the briefing.
//
// The elevator never moves, in AS or here. The platform is fixed floor
// ringed by the drop; the shaft's walls slide past it up an incline toward
// the camera (tools/elevator.py), so the platform reads as going down the
// tube. The console starts it once everyone alive (up to four) is aboard;
// the ride is relay_lift_but_succeed's, beat for beat (AS_RideMove).
// =====================================================================

int as_stage;                    // AS_ST_*
fixed as_stageAt;
int as_checkpoint;
fixed as_missionStart;
fixed as_missionEnd;
fixed as_victoryAt;
const int AS_ST_LAND = 0;        // under way
const int AS_ST_BOARD = 3;       // a lift level: the lift in sight, everyone onto the platform
const int AS_ST_RIDE = 4;        // going down
const int AS_ST_ESCAPE = 5;      // only the escape is left
const int AS_ST_DONE = 6;

// ---- level tables (AS_MissionData, generated by build.py) ----------
int as_zoneCount;
string[16] as_zoneName;
fixed[16] as_zoneX0;
fixed[16] as_zoneY0;
fixed[16] as_zoneX1;
fixed[16] as_zoneY1;
bool[16] as_zoneHit;
int as_cpCount;
fixed[8] as_cpX;
fixed[8] as_cpY;
fixed as_liftX0;
fixed as_liftY0;
fixed as_liftX1;
fixed as_liftY1;
fixed as_extX0;
fixed as_extY0;
fixed as_extX1;
fixed as_extY1;
point as_doorPanel;
point as_liftPanel;
fixed as_liftNotchY1;            // the console's notch in the platform's north edge reaches this far
int[4] as_brIn;                  // entrance bridge cells x0 y0 x1 y1
int[4] as_brOut;
bool as_hasLift;                 // the level has the cargo elevator
fixed as_shX;                    // the shaft (tools/elevator.py): its middle across, where the walls' top edge meets the deck
fixed as_shY;
fixed as_shLow;                  // where slot 0 starts along the travel when the ride begins
int as_shIn;                     // the slot with the entrance, and the one that brings the exit
int as_shOut;
int as_shN;
fixed as_shSeg;
fixed as_shV;                    // the walls' speed, cells a second
fixed as_shHalf;
fixed as_shLampU;
fixed as_shLampT;
fixed as_shDoorU;
fixed as_shBx;                   // the red beacons: across, how deep under the walls' top edge, where along the walls,
fixed as_shBt;                   // and how far the walls have gone when each hands on to the next
fixed[5] as_shBu;
fixed[4] as_shBs;

// ---- helpers --------------------------------------------------------
int AS_Humans () {
    int p;int n=0;
    for(p=1;p<=AS_PLAYERS;p+=1) {if(AS_Person(p)) {n+=1;}}
    return n;
}
int AS_Living () {
    int p;int n=0;
    for(p=1;p<=AS_PLAYERS;p+=1) {if(AS_Person(p) && as_alive[p]) {n+=1;}}
    return n;
}
bool AS_InRect (point q, fixed x0, fixed y0, fixed x1, fixed y1) {
    fixed x=PointGetX(q);fixed y=PointGetY(q);
    return x>=x0 && x<x1 && y>=y0 && y<y1;
}
// How many living marines stand in the rectangle.
int AS_CountIn (fixed x0, fixed y0, fixed x1, fixed y1) {
    int p;int n=0;
    for(p=1;p<=AS_PLAYERS;p+=1) {if(AS_Person(p) && as_alive[p] && AS_InRect(UnitGetPosition(as_m[p]),x0,y0,x1,y1)) {n+=1;}}
    return n;
}
void AS_All (string big, string small) {
    int p;
    for(p=1;p<=AS_PLAYERS;p+=1) {if(AS_Person(p)) {AS_Announce(p,big,small);}}
}
void AS_AllMsg (string s) {
    int p;
    for(p=1;p<=AS_PLAYERS;p+=1) {if(AS_Person(p)) {AS_Message(p,s);}}
}
void AS_AllSound (string id) {
    SoundPlay(SoundLink(id,-1),PlayerGroupAll(),100.0,0.0);
}
void AS_ShakeAll (fixed strength, fixed secs) {
    int p;
    for(p=1;p<=AS_PLAYERS;p+=1) {if(AS_Person(p)) {CameraShakeStart(p,c_cameraPositionBoth,c_cameraDirectionXYZ,strength,6.0,40.0,secs);}}
}
// More aliens for a bigger squad: the base count for one marine, scaled.
int AS_Scaled (int base) {
    int n=AS_Humans();
    return MaxI(1,FixedToInt(IntToFixed(base)*(0.55+0.3*IntToFixed(n))+0.5));
}
void AS_SetCell (int x0, int y0, int x1, int y1, bool solid) {
    int x;int y;
    for(x=x0;x<x1;x+=1) {for(y=y0;y<y1;y+=1) {as_wall[x-as_ox][y-as_oy]=solid;}}
}

// ---- objectives -------------------------------------------------------
const int AS_LV_SCRIPT = 1;      // the first mission that runs on its data alone (CARGO ELEVATOR)
const int AS_LV_DEIMA = 2;
const int AS_LV_RYDBERG = 3;
const int AS_LV_RESIDENTIAL = 4;
const int AS_LV_SEWER = 5;
string[5] as_objName;
int[5] as_objState;              // 0 hidden, 1 active, 2 done
int as_objCount = 4;
point as_objAt;
unit as_beacon;
unit as_beaconLight;
void AS_Objective (int k, int state) {
    if(as_objState[k]==state) {return;}
    as_objState[k]=state;
    if(state==2) {AS_AllSound("Alert_UniObjectiveCompleted");}
    else if(state==1) {AS_AllSound("Alert_UniObjectiveDiscovered");}
}
void AS_MarkAt (fixed x, fixed y) {
    as_objAt=Point(x,y);
    if(as_beacon==null) {
        UnitCreate(1,"ASObjBeacon",c_unitCreateIgnorePlacement,0,as_objAt,270.0);as_beacon=UnitLastCreated();
        UnitCreate(1,"ASLightGreen",c_unitCreateIgnorePlacement,0,as_objAt,270.0);as_beaconLight=UnitLastCreated();
        UnitSetHeight(as_beaconLight,1.4,0.0);
    }
    UnitSetPosition(as_beacon,as_objAt,false);UnitSetPosition(as_beaconLight,as_objAt,false);
    libNtve_gf_ShowHideUnit(as_beacon,true);libNtve_gf_ShowHideUnit(as_beaconLight,true);
}
void AS_MarkOff () {
    as_objAt=null;
    if(as_beacon!=null) {libNtve_gf_ShowHideUnit(as_beacon,false);libNtve_gf_ShowHideUnit(as_beaconLight,false);}
}
// "NE  34 m" from a marine to the objective, for the HUD.
string AS_ObjBearing (int p) {
    point here;point to;fixed a;fixed d;string dir;int k;string more="";
    if(as_objAt==null || !as_alive[p]) {return "";}
    here=UnitGetPosition(as_m[p]);
    // Through a seam (src/Seams.galaxy): the way to the seam, and the rest beyond it.
    to=AS_SeamWay(here,as_objAt);if(to!=as_objAt) {more="+";}
    d=DistanceBetweenPoints(here,to);
    if(d<3.0 && more=="") {return "<c val=\"8CFFA0\">HERE</c>";}
    a=ATan2(PointGetY(to)-PointGetY(here),PointGetX(to)-PointGetX(here));
    k=FixedToInt(ModF(a+22.5+360.0,360.0)/45.0)%8;
    dir="E";
    if(k==1) {dir="NE";}else if(k==2) {dir="N";}else if(k==3) {dir="NW";}else if(k==4) {dir="W";}
    else if(k==5) {dir="SW";}else if(k==6) {dir="S";}else if(k==7) {dir="SE";}
    return dir+"  "+IntToString(FixedToInt(d))+more+" m";
}

// The hull kit lays its blockers a few ticks after the mission has shut the door and the exit bridge, so it
// shuts their cells too: take away every kit blocker lying wholly inside the rectangle when it opens.
void AS_KitUnblock (int x0, int y0, int x1, int y1) {
    int i;int n=0;point q;fixed x;fixed y;fixed r;
    for(i=0;i<as_kitUnitN;i+=1) {
        if(as_kitUnit[i]==null || UnitGetType(as_kitUnit[i])==null) {continue;}
        if(UnitGetType(as_kitUnit[i])=="PathingBlocker2x2") {r=1.0;}
        else if(UnitGetType(as_kitUnit[i])=="PathingBlocker1x1") {r=0.5;}
        else {continue;}
        q=UnitGetPosition(as_kitUnit[i]);x=PointGetX(q);y=PointGetY(q);
        if(x-r<IntToFixed(x0)-0.01 || x+r>IntToFixed(x1)+0.01 || y-r<IntToFixed(y0)-0.01 || y+r>IntToFixed(y1)+0.01) {continue;}
        UnitRemove(as_kitUnit[i]);as_kitUnit[i]=null;n+=1;
    }
    AS_Log("kit blockers cleared "+IntToString(n));
}
// ---- the elevator -----------------------------------------------------
// AS's FreightElevatorWalls: a tracktrain running 2655 units at 25 a second up an incline toward the camera, starting
// and stopping dead. Here the walls are a train of segments (tools/elevator.py) along the same incline, model actors
// set down each tick where the walls have got to; one that leaves past the camera drops to the bottom of the train
// under the deck. The segment at the platform has the entrance in its west wall when the ride begins; five segments
// on, the one that stops there brings the exit in its east wall (it takes that shape as it comes round, unseen).
const fixed AS_RIDE_LEN = 33.19;     // tools/elevator.py RIDE, cells (2655 units)
const fixed AS_TRAVEL_Y = -0.6604;   // TRAVEL: up and south, a cell of it
const fixed AS_TRAVEL_Z = 0.7509;
const fixed AS_INTO_Y = -0.7509;     // INTO: from the walls' top edge into the tube
const fixed AS_INTO_Z = -0.6604;
const int AS_SEGS = 8;
actor[8] as_seg;                     // the wall segments, slot by slot
int[8] as_segKind;                   // 0 plain, 1 the entrance's, 2 the exit's
fixed[8] as_segU;                    // where each slot starts along the travel
unit[16] as_cageLight;               // the orange lamps in the walls' cages, two a slot
actor[2] as_gateIn;                  // the doorways' leaves, riding with their slots
actor[2] as_gateOut;
unit as_bridgeIn;
unit as_bridgeOut;
unit as_platform;
unit as_void;
unit as_screenR;
unit as_screenG;
unit[4] as_brBlock;
fixed as_liftZ;                      // the deck's height under the platform
fixed as_scroll;                     // how far the walls have gone (cells)
string as_extName;                   // where the squad extracts, for the count messages
int as_ride;                         // 0 waiting, 1 started (doors shutting), 2 moving, 3 stopped (exit opening), 4 open
int as_rideStep;                     // relay_lift_but_succeed's one-shots done so far
fixed as_rideGo;                     // when the console started it
fixed as_rideAt;                     // when this ride phase began
fixed as_rideClock;                  // seconds the walls have been moving
fixed as_boardAt;                    // when the squad was last all aboard (0 when not)
fixed as_denyAt;                     // msg_lift_deny again no sooner than this
int as_rideWave;                     // the walls' path_tracks passed so far (AS_RidePass)
int[5] as_ridePct;                   // where they stand along the ride, in percent
// The lights: light_spin_ele_0 .. 4 (red, handed down the west wall as the walls pass their path_tracks),
// light_spin_ele_top (amber, over the entrance while the lift waits) and light_spin_ele_bottom (amber, by the exit).
unit as_redLamp;
unit as_redLight;
unit as_redSweep;
actor as_redGlow;
int as_redOn;
unit[2] as_waitLight;
actor as_topGlow;
unit as_botLight;
unit as_botSweep;
actor as_botGlow;
fixed[3] as_railSpark;               // env_spark on the guide rails: the next spark of each
fixed as_steamNext;

// Lay a mission piece's face the way it looks (pieces are authored facing south); src/Doors.galaxy uses these too.
void AS_PieceTurn (unit u, fixed facing) {
    AS_KitTurn(libNtve_gf_MainActorofUnit(u),facing-270.0);
}
unit AS_Piece (string kind, fixed x, fixed y, fixed facing, fixed h) {
    unit u;
    UnitCreate(1,kind,c_unitCreateIgnorePlacement,0,Point(x,y),facing);
    u=UnitLastCreated();
    AS_PieceTurn(u,facing);
    UnitSetHeight(u,h,0.0);
    return u;
}
unit AS_LiftUnit (string kind, fixed x, fixed y, fixed h) {
    UnitCreate(1,kind,c_unitCreateIgnorePlacement,0,Point(x,y),270.0);
    UnitSetHeight(UnitLastCreated(),h,0.0);
    return UnitLastCreated();
}
// A model actor of the lift's (tools/elevator.py shaft_models), at height z over the deck.
actor AS_LiftActor (string kind, fixed x, fixed y, fixed z) {
    actor a=libNtve_gf_CreateActorAtPoint(kind,Point(x,y));
    ActorSend(a,libNtve_gf_SetPosition(x,y,as_liftZ+z));
    AS_KitTurn(a,0.0);
    return a;
}
void AS_ActorGone (actor a) {
    if(a!=null) {ActorSend(a,"Destroy");}
}
unit AS_Blocker2 (fixed x, fixed y) {
    UnitCreate(1,"PathingBlocker2x2",c_unitCreateIgnorePlacement,0,Point(x,y),0.0);
    return UnitLastCreated();
}
// A doorway's leaf: side 0 the entrance in the west wall, 1 the exit in the east; leaf 0 the south one, 1 the north;
// open 0 shut .. 1 slid behind the wall; u where its slot starts along the travel (the doorway is DOOR_U along).
void AS_LeafSet (actor a, int side, int leaf, fixed open, fixed u) {
    fixed x=as_shX-as_shHalf-0.06;fixed y=IntToFixed(as_brIn[1])+1.0;fixed d=u-as_shDoorU;
    if(a==null) {return;}
    if(side==1) {x=as_shX+as_shHalf+0.06;y=IntToFixed(as_brOut[1])+1.0;}
    y+=2.0*IntToFixed(leaf)+IntToFixed(leaf*2-1)*2.0*open;
    ActorSend(a,libNtve_gf_SetPosition(x,y+d*AS_TRAVEL_Y,as_liftZ+d*AS_TRAVEL_Z));
}
// A slot's segment, of its kind, where the slot stands.
void AS_SegMake (int k, int kind) {
    string model="ASESeg";
    AS_ActorGone(as_seg[k]);
    if(kind==1) {model="ASESegIn";}else if(kind==2) {model="ASESegOut";}
    as_seg[k]=AS_LiftActor(model,as_shX,as_shY,0.0);as_segKind[k]=kind;
}
void AS_LiftBuild () {
    int k;fixed cx=(as_liftX0+as_liftX1)*0.5;fixed cy=(as_liftY0+as_liftY1)*0.5;
    as_liftZ=AS_GroundZ(cx,cy);
    UnitCreate(1,"ASEPlatform",c_unitCreateIgnorePlacement,0,Point(cx,cy),270.0);as_platform=UnitLastCreated();
    UnitCreate(1,"ASEVoid",c_unitCreateIgnorePlacement,0,Point(cx,cy),270.0);as_void=UnitLastCreated();
    // The console's screen (lift_buttonpanel's skins): red, green once the squad is aboard.
    as_screenR=AS_LiftUnit("ASEScreenR",PointGetX(as_liftPanel),PointGetY(as_liftPanel),0.0);
    as_screenG=AS_LiftUnit("ASEScreenG",PointGetX(as_liftPanel),PointGetY(as_liftPanel),0.0);
    libNtve_gf_ShowHideUnit(as_screenG,false);
    for(k=0;k<as_shN;k+=1) {
        if(k==as_shIn) {AS_SegMake(k,1);}else {AS_SegMake(k,0);}
        as_segU[k]= -1000.0;
        UnitCreate(1,"ASLightOrange",c_unitCreateIgnorePlacement,0,Point(as_shX,as_shY),270.0);as_cageLight[2*k]=UnitLastCreated();
        UnitCreate(1,"ASLightOrange",c_unitCreateIgnorePlacement,0,Point(as_shX,as_shY),270.0);as_cageLight[2*k+1]=UnitLastCreated();
    }
    // The entrance's leaves stand open behind the west wall; the exit's come round with its segment.
    for(k=0;k<2;k+=1) {as_gateIn[k]=AS_LiftActor("ASEGateLeaf",as_shX,as_shY,0.0);}
    UnitCreate(1,"ASEBridge",c_unitCreateIgnorePlacement,0,Point((IntToFixed(as_brIn[0])+IntToFixed(as_brIn[2]))*0.5,(IntToFixed(as_brIn[1])+IntToFixed(as_brIn[3]))*0.5),270.0);as_bridgeIn=UnitLastCreated();
    UnitCreate(1,"ASEBridge",c_unitCreateIgnorePlacement,0,Point((IntToFixed(as_brOut[0])+IntToFixed(as_brOut[2]))*0.5+2.0,(IntToFixed(as_brOut[1])+IntToFixed(as_brOut[3]))*0.5),270.0);as_bridgeOut=UnitLastCreated();
    libNtve_gf_ShowHideUnit(as_bridgeOut,false);
    // The exit bridge is not there yet: shut to marines and aliens.
    AS_SetCell(as_brOut[0],as_brOut[1],as_brOut[2],as_brOut[3],true);
    as_brBlock[2]=AS_Blocker2(IntToFixed(as_brOut[0])+1.0,IntToFixed(as_brOut[1])+1.0);
    as_brBlock[3]=AS_Blocker2(IntToFixed(as_brOut[0])+1.0,IntToFixed(as_brOut[1])+3.0);
    // The red beacon (a turning alarm lamp, its light and the beam it throws round), dark until the walls move.
    as_redLamp=AS_LiftUnit("ASAlarmLamp",as_shBx,as_shY,0.0);libNtve_gf_ShowHideUnit(as_redLamp,false);
    as_redLight=AS_LiftUnit("ASLightRedbig",as_shBx,as_shY,0.0);libNtve_gf_ShowHideUnit(as_redLight,false);
    as_redSweep=AS_LiftUnit("ASLightRedbig",as_shBx,as_shY,1.4);libNtve_gf_ShowHideUnit(as_redSweep,false);
    ActorSend(libNtve_gf_MainActorofUnit(as_redSweep),"SetScale 1.8");
    as_redOn= -1;
    // While it waits, light_spin_ele_top's amber over the entrance, and the pool it throws onto the deck.
    as_waitLight[0]=AS_LiftUnit("ASLightYellowbig",as_liftX0-0.6,as_liftY1-1.3,2.0);
    as_waitLight[1]=AS_LiftUnit("ASLightYellowbig",cx-1.5,cy,2.6);
    ActorSend(libNtve_gf_MainActorofUnit(as_waitLight[0]),"SetScale 2.0");ActorSend(libNtve_gf_MainActorofUnit(as_waitLight[1]),"SetScale 2.4");
    as_topGlow=AS_LiftActor("ASEGlowAmber",as_liftX0-1.6,as_liftY1-1.2,1.85);
}
// Lay the walls where they are at s: every slot's segment, its doorway's leaves and its cage lamps. A slot that has
// gone past the camera comes back in at the bottom of the train, under the deck; the doorway slots change shape then.
void AS_ShaftSet (fixed s) {
    int k;int i;fixed u;fixed span=IntToFixed(as_shN)*as_shSeg;fixed lu;fixed z;
    for(k=0;k<as_shN;k+=1) {
        u=as_shLow+ModF(IntToFixed(k)*as_shSeg+s,span);
        if(u<as_segU[k]-0.01) {
            if(as_segKind[k]==1) {
                // The entrance has gone up out of the shaft: a plain segment, the leaves gone with it.
                AS_SegMake(k,0);
                for(i=0;i<2;i+=1) {AS_ActorGone(as_gateIn[i]);as_gateIn[i]=null;}
            }
            if(k==as_shOut && as_segKind[k]==0) {
                // The last time round: the exit comes up from below, shut.
                AS_SegMake(k,2);
                for(i=0;i<2;i+=1) {as_gateOut[i]=AS_LiftActor("ASEGateLeaf",as_shX,as_shY,0.0);}
            }
        }
        as_segU[k]=u;
        ActorSend(as_seg[k],libNtve_gf_SetPosition(as_shX,as_shY+u*AS_TRAVEL_Y,as_liftZ+u*AS_TRAVEL_Z));
        if(as_segKind[k]==1) {for(i=0;i<2;i+=1) {AS_LeafSet(as_gateIn[i],0,i,1.0-AS_Clamp((as_now-as_rideGo-0.2)/1.4,0.0,1.0)*IntToFixed(BoolToInt(as_ride>=1)),u);}}
        if(as_segKind[k]==2 && as_ride<3) {for(i=0;i<2;i+=1) {AS_LeafSet(as_gateOut[i],1,i,0.0,u);}}
        // The cage lamps light the walls round them while they are above the deck.
        lu=u+as_shLampU;z=lu*AS_TRAVEL_Z+as_shLampT*AS_INTO_Z;
        for(i=0;i<2;i+=1) {
            if(z>0.3 && z<9.0) {
                libNtve_gf_ShowHideUnit(as_cageLight[2*k+i],true);
                UnitSetPosition(as_cageLight[2*k+i],Point(as_shX+IntToFixed(i*2-1)*(as_shHalf-0.6),as_shY+lu*AS_TRAVEL_Y+as_shLampT*AS_INTO_Y),true);
                UnitSetHeight(as_cageLight[2*k+i],z,AS_DT);
            }
            else {libNtve_gf_ShowHideUnit(as_cageLight[2*k+i],false);}
        }
    }
    AS_RedSet(s);
}
// light_spin_ele_0 .. 4: one red beacon at a time turning on the west wall's top, fixed to the walls; as they pass
// each path_track the next one down the wall takes over (AS's 13, 35, 57 and 75%).
void AS_RedSet (fixed s) {
    int k=0;fixed u;fixed x=as_shBx;fixed y;fixed z;fixed a;bool jump;
    if(as_ride!=2) {
        if(as_redOn>=0) {
            as_redOn= -1;
            libNtve_gf_ShowHideUnit(as_redLamp,false);libNtve_gf_ShowHideUnit(as_redLight,false);libNtve_gf_ShowHideUnit(as_redSweep,false);
            AS_ActorGone(as_redGlow);as_redGlow=null;
        }
        return;
    }
    while(k<4 && s>=as_shBs[k]) {k+=1;}
    jump=k!=as_redOn;
    if(jump) {
        as_redOn=k;
        libNtve_gf_ShowHideUnit(as_redLamp,true);libNtve_gf_ShowHideUnit(as_redLight,true);libNtve_gf_ShowHideUnit(as_redSweep,true);
        ActorSend(libNtve_gf_MainActorofUnit(as_redLamp),"AnimPlay Spin Stand PlayForever");
        if(as_redGlow==null) {as_redGlow=AS_LiftActor("ASEGlowRed",x,as_shY,0.0);}
        AS_Log("lift beacon "+IntToString(k)+" at "+FixedToString(s,2));
    }
    u=as_shBu[k]+s;y=as_shY+u*AS_TRAVEL_Y+as_shBt*AS_INTO_Y;z=u*AS_TRAVEL_Z+as_shBt*AS_INTO_Z;
    UnitSetPosition(as_redLamp,Point(x,y),!jump);UnitSetHeight(as_redLamp,MaxF(0.0,z-0.35),AS_DT);
    UnitSetPosition(as_redLight,Point(x+0.4,y),!jump);UnitSetHeight(as_redLight,MaxF(0.2,z),AS_DT);
    ActorSend(as_redGlow,libNtve_gf_SetPosition(x+0.15,y-0.2,as_liftZ+z));
    // Its beam goes round at 400 degrees a second, over the deck and the walls.
    a=as_now*400.0;
    UnitSetPosition(as_redSweep,Point(x+2.6+Cos(a)*3.5,y-2.5+Sin(a)*3.5),!jump);
}
void AS_LiftScreen (bool green) {
    if(as_screenR==null) {return;}
    libNtve_gf_ShowHideUnit(as_screenR,!green);libNtve_gf_ShowHideUnit(as_screenG,green);
}
// The ride's look: AS's red under the beacons while the walls move, the level's own again at the bottom.
void AS_LiftLighting (bool riding) {
    if(riding) {GameSetLighting("ASLiftRide",1.0);}
    else {GameSetLighting(as_lightId[as_light],2.5);}
}
// AS's part_lift_start_dust: the shaft's grime shaken down onto the platform as it lurches off.
void AS_LiftDust () {
    int k;unit u;fixed cx=(as_liftX0+as_liftX1)*0.5;fixed cy=(as_liftY0+as_liftY1)*0.5;fixed s;
    for(k=0;k<10;k+=1) {
        s=RandomFixed(1.6,3.2);
        u=AS_FxUnit("ASFxSmoke",cx+RandomFixed(-4.0,4.0),cy+RandomFixed(-3.0,3.5),RandomFixed(2.5,4.3),0.0,s,s,"70,60,46",24);
        if(u!=null) {ActorSend(libNtve_gf_MainActorofUnit(u),"SetOpacity 0 1.5");UnitSetHeight(u,RandomFixed(0.3,1.2),1.4);}
    }
}
// AS's landingbay_lift_steam_jet: a pipe on a shaft wall venting across the drop now and then.
void AS_LiftSteam () {
    int k;int side=RandomInt(0,1);unit u;fixed y=RandomFixed(as_liftY0+0.5,as_liftY1+2.0);fixed z=RandomFixed(1.0,3.5);fixed x;fixed s;
    fixed dir=IntToFixed(1-2*side);
    for(k=0;k<4;k+=1) {
        x=as_shX+IntToFixed(side*2-1)*(as_shHalf-0.3)+dir*0.45*IntToFixed(k);
        s=0.5+0.3*IntToFixed(k);
        u=AS_FxUnit("ASFxSmoke",x,y,z+0.1*IntToFixed(k),0.0,s,s,"84,86,86",10+3*k);
        if(u!=null) {ActorSend(libNtve_gf_MainActorofUnit(u),"SetOpacity 0 "+FixedToString(0.6+0.2*IntToFixed(k),2));}
    }
}
// AS's relay_lift_exit_lights: green lamps along the way out, on both rails, lit one after another 0.3 s apart,
// round and round.
void AS_LiftExitLights () {
    int k=(as_tick/5)%3;fixed x=as_liftX1+0.05+0.8*IntToFixed(k);
    if(as_tick%5!=0) {return;}
    AS_Burst(x,as_liftY1-1.0,0.08,0.5,"71,183,23",4);AS_Burst(x,as_liftY0+0.85,0.08,0.5,"71,183,23",4);
}
// env_spark: where the platform's rollers grind (the motor at 2.5 s, the guide rails from 3 s, rarer as it settles).
void AS_LiftSparks (fixed t) {
    int k;fixed gap;fixed x;fixed y;
    if(t>=2.5 && t<5.0 && as_tick%3==0) {
        if(RandomInt(0,1)==0) {x=as_liftX0-0.1;y=as_liftY0+0.7;}else {x=as_liftX1-0.1;y=as_liftY0+0.5;}
        AS_Fx("ASFxSpark",x,y,0.1,RandomFixed(0.0,360.0));
        if(RandomInt(0,2)==0) {AS_Flash(x,y,0.3,0.5,"255,170,80");}
    }
    if(t<3.0 || t>=16.5) {return;}
    gap=0.3;
    if(t>=9.0) {gap=2.5;}else if(t>=6.0) {gap=1.0;}else if(t>=4.0) {gap=0.5;}
    for(k=0;k<3;k+=1) {
        if(as_now<as_railSpark[k]) {continue;}
        as_railSpark[k]=as_now+RandomFixed(0.05,gap);
        x=as_liftX0+1.6+IntToFixed(k)*2.3+RandomFixed(-0.1,0.1);y=as_liftY0-0.2;
        AS_Fx("ASFxSpark",x,y,0.1,RandomFixed(200.0,340.0));
        if(RandomInt(0,3)==0) {AS_Flash(x,y,0.3,0.5,"255,170,80");}
    }
}

// AS's env_slomo (ElevatorSlomo, duration 16): an adrenaline stim for everyone (asw_env_slomo.cpp calls StartStim),
// so the whole game runs at asw_stim_time_scale 0.35 for 16 game seconds as the swarm first comes for the platform.
bool as_slomoDone;
void AS_Slomo () {
    if(as_slomoDone) {return;}
    as_slomoDone=true;
    as_slowMo=MaxF(as_slowMo,as_now+16.0);AS_HudSlowMo(true);
    AS_Log("slomo: adrenaline for 16 s");
}
// The shaft's brown haze (AS's landingbay_lift_fog_volume) drifting over the deck while it runs.
void AS_LiftHaze () {
    unit u;fixed s=RandomFixed(5.0,8.0);
    u=AS_FxUnit("ASFxSmoke",RandomFixed(as_liftX0,as_liftX1),RandomFixed(as_liftY0,as_liftY1+2.0),RandomFixed(1.5,3.5),0.0,s,s,"26,21,16",40);
    if(u!=null) {ActorSend(libNtve_gf_MainActorofUnit(u),"SetOpacity 0 0");ActorSend(libNtve_gf_MainActorofUnit(u),"SetOpacity 1 0.8");}
}

// The lift's rule (asw_use_area's playersrequired 4): everyone alive, up to four, on the platform.
int AS_LiftNeed () {return MinI(4,AS_Living());}
int AS_LiftAboard () {return AS_CountIn(as_liftX0,as_liftY0,as_liftX1,as_liftNotchY1);}
// Waiting at the top: the console's screen shows whether the squad is aboard; the autopilot's marine presses it.
void AS_BoardPulse () {
    int on;int need;
    if(!as_hasLift || as_ride!=0) {return;}
    on=AS_LiftAboard();need=AS_LiftNeed();
    AS_LiftScreen(need>0 && on>=need);
    if(need==0 || on<need) {
        as_boardAt=0.0;
        if(as_stage==AS_ST_BOARD && on>0 && as_tick%32==0) {AS_AllMsg("<c val=\"FFBA40\">"+IntToString(on)+" / "+IntToString(need)+"</c> marines on the cargo elevator");}
        return;
    }
    if(as_boardAt<=0.0) {as_boardAt=as_now;AS_AllMsg("<c val=\"8CFFA0\">SQUAD ABOARD</c>  -  activate the lift's panel");}
    if(as_auto && as_now-as_boardAt>1.5) {AS_ButtonPress(1,AS_ButtonNamed("lift"));}
}
// trigger_lift_button pressed ("liftbutton"): the lift starts if the squad is aboard; if not, msg_lift_deny, and the
// panel can be pressed again.
void AS_LiftButton () {
    int i=AS_ButtonNamed("lift");int on;int need;
    if(!as_hasLift || as_ride!=0) {return;}
    on=AS_LiftAboard();need=AS_LiftNeed();
    if(need>0 && on>=need) {AS_RideStart();return;}
    if(i>=0) {as_btDone[i]=false;}
    AS_Log("lift denied: "+IntToString(on)+" of "+IntToString(need)+" aboard");
    if(as_now<as_denyAt) {return;}
    as_denyAt=as_now+3.0;
    AS_InfoMessage("msg_lift_deny");
    SoundPlayAtPoint(SoundLink("UI_BnetError",-1),PlayerGroupAll(),as_liftPanel,0.5,100.0,0.0);
}
// relay_lift_but_succeed, from the press: the entrance ramp and doors shut at once, the motor starts at 1 s, the
// platform lurches at 2 s (shake, dust, sparks off the motor), the walls move at 3 s.
void AS_RideStart () {
    int k;
    as_ride=1;as_rideStep=0;as_rideGo=as_now;as_rideAt=as_now;as_stage=AS_ST_RIDE;as_stageAt=as_now;as_checkpoint=4;
    as_director=false;as_hordeLeftN=0;
    AS_MarkOff();AS_LiftScreen(true);
    AS_Fire("ride:go");
    // Nothing follows them down from the lobby: the ramp lifts, the doors shut.
    AS_SetCell(as_brIn[0],as_brIn[1],as_brIn[2],as_brIn[3],true);
    as_brBlock[0]=AS_Blocker2(IntToFixed(as_brIn[0])+1.0,IntToFixed(as_brIn[1])+1.0);
    as_brBlock[1]=AS_Blocker2(IntToFixed(as_brIn[0])+1.0,IntToFixed(as_brIn[1])+3.0);
    for(k=0;k<AS_MAXALIEN;k+=1) {
        // Aliens on the entrance ramp would ride along: send them off it.
        if(as_a[k]!=null && AS_InRect(UnitGetPosition(as_a[k]),IntToFixed(as_brIn[0]),IntToFixed(as_brIn[1]),IntToFixed(as_brIn[2]),IntToFixed(as_brIn[3]))) {
            UnitSetPosition(as_a[k],Point(IntToFixed(as_brIn[0])-1.0,PointGetY(UnitGetPosition(as_a[k]))),false);
        }
    }
    SoundPlayAtPoint(SoundLink("Doodad_SecurityGateDiagonalClose",-1),PlayerGroupAll(),Point(IntToFixed(as_brIn[0]),IntToFixed(as_brIn[1]+2)),0.5,100.0,0.0);
    AS_All("CARGO ELEVATOR","Going down. Hold the platform.");AS_Log("lift started, "+IntToString(AS_LiftAboard())+" aboard");
}
void AS_RideMove () {
    fixed t;int k;point q;fixed a;
    if(as_ride==0) {return;}
    t=as_now-as_rideGo;
    AS_LiftSparks(t);
    if(as_ride==1) {
        // The ramp draws back into the lobby wall as the doors roll shut.
        q=Point((IntToFixed(as_brIn[0])+IntToFixed(as_brIn[2]))*0.5-2.2*AS_Clamp(t/1.0,0.0,1.0),(IntToFixed(as_brIn[1])+IntToFixed(as_brIn[3]))*0.5);
        UnitSetPosition(as_bridgeIn,q,true);
        if(t>=1.0) {libNtve_gf_ShowHideUnit(as_bridgeIn,false);}
        AS_ShaftSet(0.0);
        if(as_rideStep==0 && t>=1.0) {as_rideStep=1;AS_AllSound("Event_Space2_ElevatorDescend");}
        if(as_rideStep==1 && t>=2.0) {as_rideStep=2;AS_ShakeAll(0.2,1.0);AS_LiftDust();AS_AllSound("Event_Space02_CameraQuake");}
        if(t>=3.0) {
            // The walls go: the alarm's red has the platform, the amber over the entrance goes out.
            as_ride=2;as_rideAt=as_now;as_rideClock=0.0;as_rideStep=3;
            AS_LiftLighting(true);
            for(k=0;k<2;k+=1) {libNtve_gf_ShowHideUnit(as_waitLight[k],false);}
            AS_ActorGone(as_topGlow);as_topGlow=null;
            SoundPlay(SoundLink("Ambience_Lab02Train",-1),PlayerGroupAll(),70.0,0.0);as_rideSnd=SoundLastPlayed();
            as_steamNext=as_now+RandomFixed(2.0,4.0);
        }
        return;
    }
    if(as_ride==2) {
        as_rideClock+=AS_DT;
        as_scroll=MinF(AS_RIDE_LEN,as_scroll+as_shV*AS_DT);
        AS_ShaftSet(as_scroll);
        if(as_tick%32==0) {AS_ShakeAll(0.03,2.1);}
        if(as_now>=as_steamNext) {as_steamNext=as_now+RandomFixed(2.0,4.5);AS_LiftSteam();}
        if(as_tick%20==0) {AS_LiftHaze();}
        AS_RidePass();
        if(as_scroll>=AS_RIDE_LEN-0.0001) {AS_RideArrive();}
    }
    else if(as_ride==3) {
        t=as_now-as_rideAt;
        // At the bottom (relay_block_elevator_exit, a second after the walls stop): the exit's doors part, its ramp
        // runs out over the drop, and its clip goes 2 s after that, so it can be walked at 3 s.
        for(k=0;k<2;k+=1) {AS_LeafSet(as_gateOut[k],1,k,AS_Clamp((t-1.3)/1.4,0.0,1.0),as_segU[as_shOut]);}
        q=Point((IntToFixed(as_brOut[0])+IntToFixed(as_brOut[2]))*0.5+2.2*(1.0-AS_Clamp((t-1.8)/1.0,0.0,1.0)),(IntToFixed(as_brOut[1])+IntToFixed(as_brOut[3]))*0.5);
        if(t>=1.8) {libNtve_gf_ShowHideUnit(as_bridgeOut,true);UnitSetPosition(as_bridgeOut,q,true);}
        if(t>=3.0) {
            as_ride=4;
            AS_SetCell(as_brOut[0],as_brOut[1],as_brOut[2],as_brOut[3],false);
            for(k=2;k<4;k+=1) {if(as_brBlock[k]!=null) {UnitRemove(as_brBlock[k]);as_brBlock[k]=null;}}
            AS_KitUnblock(as_brOut[0],as_brOut[1],as_brOut[2],as_brOut[3]);
            AS_All("THE BOTTOM","Get off the lift and out to "+as_extName);AS_Log("exit open, escape");
            // Off the ride: back to boarding (the console wants ride 0, so it stays quiet) until the escape opens.
            as_checkpoint=5;as_lowerLevel=true;as_stage=AS_ST_BOARD;
            AS_Fire("ride:open");
            AS_GenEscapeCheck();
            AS_GenMark();
        }
    }
    // light_spin_ele_bottom turns at 450 degrees a second by the exit, and the way out's lamps chase for good.
    if(as_ride>=3) {
        AS_LiftExitLights();
        a=as_now*450.0;
        UnitSetPosition(as_botSweep,Point(as_liftX1+0.3-1.8+Cos(a)*2.6,as_liftY1-0.9+Sin(a)*2.6),true);
    }
}
void AS_RideArrive () {
    as_ride=3;as_rideAt=as_now;as_rideStep=4;AS_Fire("ride:end");
    AS_Log("lift arrived after "+FixedToString(as_rideClock,1)+" s, exit segment "+IntToString(as_segKind[as_shOut])+" at "+FixedToString(as_segU[as_shOut],2));
    AS_ShaftSet(AS_RIDE_LEN);
    // shake_elevator_stop: three times shake_elevator_start's amplitude (12 against 4), for 2 s.
    AS_ShakeAll(0.6,2.0);
    AS_AllSound("Event_Space02_CameraQuake");
    // The red goes out; the bottom's amber beacon comes on by the exit, and the level's own light comes back.
    AS_LiftLighting(false);
    as_botLight=AS_LiftUnit("ASLightYellowbig",as_liftX1+0.3,as_liftY1-0.9,1.9);ActorSend(libNtve_gf_MainActorofUnit(as_botLight),"SetScale 2.0");
    as_botSweep=AS_LiftUnit("ASLightYellowbig",as_liftX1-1.5,as_liftY1-0.9,1.2);ActorSend(libNtve_gf_MainActorofUnit(as_botSweep),"SetScale 1.6");
    as_botGlow=AS_LiftActor("ASEGlowAmber",as_liftX1+0.3,as_liftY1-1.1,1.9);
    SoundPlayAtPoint(SoundLink("Doodad_SecurityGateDiagonalOpen",-1),PlayerGroupAll(),Point(IntToFixed(as_brOut[0]),IntToFixed(as_brOut[1]+2)),0.5,100.0,0.0);
    // The rumble stops; the lower level sounds alive.
    if(as_rideSnd!=null) {SoundStop(as_rideSnd,true);as_rideSnd=null;}
    if(as_amb!=null) {SoundStop(as_amb,true);}
    SoundPlay(SoundLink("Ambience_Leviathan_EggRoom",-1),PlayerGroupAll(),50.0,0.0);as_amb=SoundLastPlayed();
}
// ---- what comes down the shaft ----------------------------------------
// The crawlers (AS's npc_template_maker drones on path_drone_climb_*): a stock model crawling along the shaft's
// ceiling with the walls, from deep down the tube toward the platform (a model actor, not the alien: nothing can be
// shot until it drops), then the named spawner (ElevatorSpawn_crawl_1 or _2) makes its alien, falling onto the deck.
// The climb counts as one of the spawner's live aliens from the start, so its MaxLiveAliens holds the climbers back too.
const int AS_CLIMB = 24;
const fixed AS_CLIMB_FROM = -25.0;   // the path along the walls (where it stood when the ride began, cells)
const fixed AS_CLIMB_TO = -2.84;
const fixed AS_CLIMB_V = 1.0;        // 80 units a second along the walls
actor[24] as_climbA;
int[24] as_climbSp;
fixed[24] as_climbX;
fixed[24] as_climbU;
// "crawl": one of the named spawners ("a|b", one picked) sends an alien along the ceiling, if it may.
void AS_Crawl (string names) {
    int i;int s;string name=AS_PickOne(names);string model="ASClimbDrone";
    for(s=0;s<as_spN;s+=1) {
        if(as_spName[s]==name && AS_SpawnerValid(s) && (as_spMaxLive[s]<=0 || as_spLive[s]<as_spMaxLive[s])) {break;}
    }
    if(s>=as_spN || !as_hasLift) {return;}
    for(i=0;i<AS_CLIMB;i+=1) {if(as_climbA[i]==null) {break;}}
    if(i>=AS_CLIMB) {AS_Log("crawl "+name+": no climber slot");return;}
    if(as_spKind[s]==AS_PARASITE) {model="ASClimbParasite";}
    else if(as_spKind[s]==AS_UBER) {model="ASClimbUber";}
    as_climbSp[i]=s;as_spLive[s]+=1;
    as_climbX[i]=as_shX+RandomFixed(-3.0,4.0);as_climbU[i]=AS_CLIMB_FROM;
    as_climbA[i]=libNtve_gf_CreateActorAtPoint(model,Point(as_climbX[i],as_shY));
    // Belly to the ceiling, nose along the walls' travel (stock models face minus forward).
    ActorSend(as_climbA[i],libNtve_gf_SetRotation(0.0,0.0-AS_TRAVEL_Y,0.0-AS_TRAVEL_Z,0.0,AS_INTO_Y,AS_INTO_Z));
    AS_ClimbPlace(i);
    if(as_climbA[i]==null) {AS_Log("crawl "+name+": no actor for "+model);}
    else {AS_Log("crawl "+name+": climber "+IntToString(i)+" on the ceiling");}
}
void AS_ClimbPlace (int i) {
    fixed u=as_climbU[i]+as_scroll;fixed t=0.13;
    ActorSend(as_climbA[i],libNtve_gf_SetPosition(as_climbX[i],as_shY+u*AS_TRAVEL_Y+t*AS_INTO_Y,as_liftZ+u*AS_TRAVEL_Z+t*AS_INTO_Z));
}
void AS_ClimbPulse () {
    int i;int j;int s;fixed x;fixed y;
    for(i=0;i<AS_CLIMB;i+=1) {
        if(as_climbA[i]==null) {continue;}
        as_climbU[i]+=AS_CLIMB_V*AS_DT;
        if(as_climbU[i]<AS_CLIMB_TO) {AS_ClimbPlace(i);continue;}
        ActorSend(as_climbA[i],"Destroy");as_climbA[i]=null;
        s=as_climbSp[i];
        if(s<0 || s>=as_spN) {continue;}
        // Off the ceiling and down onto the deck at the spawner (SpawnOneAlien).
        x=as_spX[s];y=as_spY[s];
        j=AS_SpawnAlien(as_spKind[s],x,y,true);
        if(j<0) {as_spLive[s]=MaxI(0,as_spLive[s]-1);AS_Log("crawl drop refused at "+as_spName[s]);continue;}
        AS_Log("crawl drop at "+as_spName[s]);
        as_aSpawner[j]=s;as_spMade[s]+=1;
        AS_DirectorAlienAdded(j);
        AS_Fire("spawned:"+as_spName[s]);
        UnitSetHeight(as_a[j],2.4,0.0);UnitSetHeight(as_a[j],0.0,0.45);
        as_aNextOrder[j]=as_now+0.4;as_aNextAttack[j]=as_now+0.7;
        AS_Sound("Broodling_Attack",x,y,70.0,0.15);
    }
}
// The walls' path_tracks (elevator_walls_start1 .. 5 in AS) as parts of the ride: "ride:<percent>" as the walls go
// past each, for the level's outputs.
void AS_RidePass () {
    int at=FixedToInt(as_scroll*100.0/AS_RIDE_LEN);int k;
    for(k=as_rideWave;k<5;k+=1) {
        if(at<as_ridePct[k]) {break;}
        AS_Fire("ride:"+IntToString(as_ridePct[k]));as_rideWave=k+1;
    }
}
// The lift and its lights, gone before the next level (AS_MissionClear).
void AS_LiftClear () {
    int k;
    for(k=0;k<AS_SEGS;k+=1) {AS_ActorGone(as_seg[k]);as_seg[k]=null;as_segKind[k]=0;}
    for(k=0;k<16;k+=1) {AS_UnitGone(as_cageLight[k]);as_cageLight[k]=null;}
    for(k=0;k<2;k+=1) {
        AS_ActorGone(as_gateIn[k]);AS_ActorGone(as_gateOut[k]);as_gateIn[k]=null;as_gateOut[k]=null;
        AS_UnitGone(as_waitLight[k]);as_waitLight[k]=null;
    }
    for(k=0;k<4;k+=1) {AS_UnitGone(as_brBlock[k]);as_brBlock[k]=null;}
    AS_UnitGone(as_bridgeIn);AS_UnitGone(as_bridgeOut);AS_UnitGone(as_platform);AS_UnitGone(as_void);AS_UnitGone(as_screenR);AS_UnitGone(as_screenG);
    as_bridgeIn=null;as_bridgeOut=null;as_platform=null;as_void=null;as_screenR=null;as_screenG=null;
    AS_UnitGone(as_redLamp);AS_UnitGone(as_redLight);AS_UnitGone(as_redSweep);AS_UnitGone(as_botLight);AS_UnitGone(as_botSweep);
    as_redLamp=null;as_redLight=null;as_redSweep=null;as_botLight=null;as_botSweep=null;
    AS_ActorGone(as_redGlow);AS_ActorGone(as_topGlow);AS_ActorGone(as_botGlow);as_redGlow=null;as_topGlow=null;as_botGlow=null;
    for(k=0;k<AS_CLIMB;k+=1) {AS_ActorGone(as_climbA[k]);as_climbA[k]=null;}
    if(as_rideSnd!=null) {SoundStop(as_rideSnd,true);as_rideSnd=null;}
    as_hasLift=false;
}

// ---- failure -------------------------------------------------------------
// The whole squad down: the mission is lost 0.6 s after the last marine fell (asw_last_marine_dead_delay).
// A mission that needs a tech (asw_tech_marine_req) is lost too if the last tech dies while it still does:
// "RESTARTING MISSION" for 5 s, then the failure screen (or a straight restart in the first 30 s).
bool as_needTech;                // the level's tech requirement is still on
fixed as_failAt;
string as_failWhy;
bool as_failed;
fixed as_techRestartAt;
void AS_WipePulse () {
    if(as_stage==AS_ST_DONE || as_failed) {return;}
    if(as_failAt==0.0 && AS_Living()==0 && AS_Humans()>0) {as_failAt=as_now+0.6;as_failWhy="";AS_Log("squad wiped");}
    // The last tech fell while the mission still needs one: AS restarts the mission in place, however far in
    // (asw_marine.cpp ScheduleTechFailureRestart, asw_gamerules.cpp CheckTechFailure); a full wipe fails it instead.
    if(as_techRestartAt>0.0 && as_now>=as_techRestartAt) {
        as_techRestartAt=0.0;
        if(AS_Living()>0) {AS_Log("no tech: restart");as_failed=true;as_stage=AS_ST_DONE;AS_MissionRestart();return;}
    }
    if(as_failAt>0.0 && as_now>=as_failAt) {
        as_failAt=0.0;as_failed=true;as_stage=AS_ST_DONE;as_missionEnd=as_now;
        as_director=false;
        AS_SpawnersClear();
        AS_Log("MISSION FAILED "+as_failWhy);AS_LogStatus();
        AS_MissionLost(as_failWhy);
    }
}
// A marine has died: is a tech still alive when the mission needs one?
void AS_MissionMarineDied (int p) {
    int q;bool tech=false;
    if(!as_needTech || as_stage==AS_ST_DONE || as_failed || AS_Living()==0) {return;}
    for(q=1;q<=AS_PLAYERS;q+=1) {if(AS_Person(q) && as_alive[q] && AS_IsTech(q)) {tech=true;}}
    if(tech || as_techRestartAt>0.0) {return;}
    as_techRestartAt=as_now+1.5+5.0;
    AS_All("RESTARTING MISSION","<c val=\"FF5040\">No live Tech Marine</c>  -  mission restart in 5 seconds");
    AS_AllSound("Alert_UniObjectiveFailed");
    AS_Log("last tech down");
}

// ---- zones and stages -------------------------------------------------
// A zone the squad walks into (tools/<level>.py ZONES): "zone:<name>" for the level's outputs.
void AS_ZoneEnter (string z) {AS_Fire("zone:"+z);}
// The lift is in sight ("board"): the squad gets aboard and someone works the console (AS_LiftButton).
void AS_BoardArm () {
    if(!as_hasLift || as_stage>=AS_ST_BOARD) {return;}
    as_stage=AS_ST_BOARD;as_stageAt=as_now;as_checkpoint=MaxI(as_checkpoint,3);
    AS_All("CARGO ELEVATOR","Get the whole squad onto the platform and activate the panel");AS_Log("lobby reached");
    AS_MarkAt(PointGetX(as_liftPanel),PointGetY(as_liftPanel)-0.4);
}
void AS_ZonePulse () {
    int z;
    for(z=0;z<as_zoneCount;z+=1) {
        if(as_zoneHit[z]) {continue;}
        if(AS_CountIn(as_zoneX0[z],as_zoneY0[z],as_zoneX1[z],as_zoneY1[z])>0) {as_zoneHit[z]=true;AS_ZoneEnter(as_zoneName[z]);}
    }
}
bool AS_InExtract (fixed x, fixed y) {return x>=as_extX0 && x<as_extX1 && y>=as_extY0 && y<as_extY1;}
bool AS_MissionOver () {return as_stage==AS_ST_DONE;}
void AS_ExtractPulse () {
    int on;int alive;int p;int i;
    if(as_stage!=AS_ST_ESCAPE) {return;}
    on=AS_CountIn(as_extX0,as_extY0,as_extX1,as_extY1);alive=AS_Living();
    if(as_level==AS_LV_BAY && (as_objState[0]!=2 || as_objState[1]!=2)) {return;}
    if(alive==0 || on<alive) {
        if(on>0 && as_tick%24==0) {AS_AllMsg("<c val=\"FFBA40\">"+IntToString(on)+" / "+IntToString(alive)+"</c> marines at "+as_extName);}
        as_victoryAt=0.0;return;
    }
    if(as_victoryAt==0.0) {as_victoryAt=as_now+2.0;AS_AllMsg("<c val=\"8CFFA0\">Squad at "+as_extName+"</c>");}
    if(as_now<as_victoryAt) {return;}
    as_stage=AS_ST_DONE;as_missionEnd=as_now;AS_Log("MISSION COMPLETE "+as_levelTitle[as_level]+" in "+FixedToString(as_now-as_missionStart,1)+" s");AS_LogStatus();
    AS_SpawnersClear();
    AS_Objective(as_objCount-1,2);AS_MarkOff();
    as_director=false;as_hordeLeftN=0;
    GameSetLighting("ASPowered",3.0);
    AS_AllSound("Alert_Victory");
    // God mode first: boomers bursting in the clean-up below would otherwise still down a marine.
    for(p=1;p<=AS_PLAYERS;p+=1) {if(AS_Person(p)) {as_god[p]=true;}}
    for(i=0;i<AS_MAXALIEN;i+=1) {if(as_a[i]!=null && as_aKind[i]!=AS_EGG && as_aKind[i]!=AS_BIOMASS) {AS_KillAlien(i,0,1);}}
    // Progress into every marine's bank, the debrief, then the next level (src/Campaign.galaxy).
    AS_MissionWon();
}

// The level as the squad finds it: Landing Bay's own, the scripted levels' sleepers, barrels and pickups.
void AS_MissionPopulate () {
    if(as_level==AS_LV_BAY) {AS_BayPopulate();return;}
    AS_LevelThings();
}
// A level's mission from the start: every stage, beat and ride value back to the beginning
// (a level played after another finds what the last one left), then its own set pieces.
void AS_MissionInit () {
    int k;
    as_probeAuto=0.0;
    as_missionStart=as_now;as_missionEnd=0.0;as_checkpoint=0;as_stage=AS_ST_LAND;as_stageAt=as_now;
    as_failAt=0.0;as_failWhy="";as_failed=false;as_techRestartAt=0.0;as_victoryAt=0.0;as_objAt=null;as_needTech=false;
    as_scroll=0.0;as_ride=0;as_rideStep=0;as_rideGo=0.0;as_rideAt=0.0;as_boardAt=0.0;as_denyAt=0.0;as_rideWave=0;as_rideClock=0.0;
    as_ridePct[0]=0;as_ridePct[1]=13;as_ridePct[2]=35;as_ridePct[3]=57;as_ridePct[4]=75;
    for(k=0;k<3;k+=1) {as_railSpark[k]=0.0;}
    as_slomoDone=false;
    as_lowerLevel=false;
    as_crumbHead= -1;as_crumbN=0;
    for(k=0;k<5;k+=1) {as_objState[k]=0;}
    if(as_level>=AS_LV_SCRIPT) {
        // A level with a lift (tools/cargo.py LIFT): its platform, drop and shaft walls, at the top.
        if(as_hasLift) {AS_LiftBuild();AS_ShaftSet(0.0);}
        AS_GenInit();return;
    }
    // Landing Bay: all three objectives are on the list from the start, as AS shows them.
    as_objName[0]="Access the inner perimeter";as_objName[1]="Download the flight data";as_objName[2]="Get to the Landing Bay exit";as_objCount=3;
    as_extName="the escape lift";as_needTech=true;
    AS_BayInit();
    as_objState[0]=1;as_objState[1]=1;as_objState[2]=1;
    AS_MissionPopulate();
    AS_MarkAt(as_oxF+30.0,as_oyF+42.0);
    AS_Log("mission start "+as_levelTitle[as_level]+", marines "+IntToString(AS_Humans())+", bots "+IntToString(as_botCount));
}
void AS_UnitGone (unit u) {
    if(u!=null && UnitIsValid(u)) {UnitRemove(u);}
}
// Everything the mission put in the level, gone before the next one (src/Campaign.galaxy).
void AS_MissionClear () {
    int c;int k;
    AS_UnitGone(as_beacon);AS_UnitGone(as_beaconLight);as_beacon=null;as_beaconLight=null;
    AS_LiftClear();
    as_camWide=0.0;as_camBiasY=0.0;
    as_zoneCount=0;
    AS_DoorsClear();AS_SpawnersClear();AS_TriggersClear();AS_UseClear();AS_BayClear();AS_GenClear();
}
void AS_MissionPulse () {
    if(as_tick%160==80) {AS_LogStatus();}
    AS_CrumbPulse();
    if(as_tick%4==0) {AS_ZonePulse();AS_ExtractPulse();}
    AS_DoorPulseAll();AS_SpawnerPulse();AS_TriggerPulse();AS_UsePulse();
    if(as_level==AS_LV_BAY) {AS_BayPulse();}
    else if(as_level>=AS_LV_SCRIPT) {AS_GenPulse();}
    AS_BoardPulse();AS_RideMove();AS_ClimbPulse();AS_WipePulse();AS_CommanderPulse();
}

// ---- QA: Ctrl+L jumps the squad to the next beat (QA builds only) -----
void AS_SquadTo (fixed x, fixed y) {
    int p;
    for(p=1;p<=AS_PLAYERS;p+=1) {
        if(!AS_Person(p) || !as_alive[p]) {continue;}
        UnitSetPosition(as_m[p],Point(x+IntToFixed((p-1)%2)*1.2,y+IntToFixed((p-1)/2)*1.2),false);
        as_mvX[p]=0.0;as_mvY[p]=0.0;
    }
    as_crumbHead= -1;as_crumbN=0;
}
void AS_SkipAhead (int p) {
    if(!as_qa || !as_levelReady) {return;}
    AS_Log("QA skip from stage "+IntToString(as_stage));
    if(as_level==AS_LV_BAY) {AS_BaySkip();return;}
    // A lift level: onto the platform, then most of the ride skipped, before its objectives are.
    if(as_level>=AS_LV_SCRIPT && as_hasLift && as_ride<4) {
        if(as_ride==0 && AS_LiftAboard()>=AS_LiftNeed()) {AS_RideStart();}
        else if(as_ride==0) {AS_BoardArm();AS_SquadTo((as_liftX0+as_liftX1)*0.5-1.0,(as_liftY0+as_liftY1)*0.5-1.0);}
        else if(as_ride==2) {as_scroll=MaxF(as_scroll,AS_RIDE_LEN-4.0);as_rideClock=MaxF(as_rideClock,90.0);}
        return;
    }
    AS_GenSkip();
}

// =====================================================================
// LANDING BAY, after asi-jac1-landingbay_01's own logic:
//   the dropship Bloodhound pulls away from the clamps once the squad is off it,
//   and the commander checks in (co_m1_ob1, 6 s after the squad deploys);
//   the security gate's two doors are locked: a tech hacks either door panel
//   and that door opens; walking through completes "Access the inner perimeter";
//   the doors past the pump room are worth welding behind you, the tank room's
//   two doors are welded shut and the welders lie on the supply room's bench;
//   at flight control a tech hacks the escape pod's terminal: five seconds
//   later the drones start climbing out of the floor (dock_holdout_spawn_01, until
//   eight seconds after the hack is done) and more of them start on the control
//   door from the far side (breakdoor_spawn); once the data is down the commander
//   checks in again, and the squad leaves by the door the swarm broke down for
//   the escape lift; the whole living squad on it ends the mission.
// =====================================================================
int as_bayStage;                   // 0 deploying, 1 gate hacked, 2 inner perimeter, 3 hacking, 4 downloaded, 5 door open
fixed as_bayDropship;              // the dropship's departure began (0 not yet)
actor as_bayShip;
unit as_baySentrySpot;
fixed as_bayExitAt;
int as_bayComputer;                // the escape pod's terminal (the first terminal of the level)
fixed as_bayHoldStop;              // the holdout spawners stop at this time
fixed as_bayDoorForce;             // the control door opens by itself at this time if the swarm never breaks it
fixed as_sentrySpotX;              // the holo sentry (tools/landingbay.py SENTRY_SPOT)
fixed as_sentrySpotY;
string as_weldWatch;               // doors to suggest welding once the squad is past them
fixed as_weldWatchAt;
string[8] as_lineKey;
fixed[8] as_lineAt;
int as_lineN;
fixed as_lineUntil;
fixed as_lineBusy;          // he is speaking until then: the next line waits
fixed as_lineTalk;          // his clip ends then: his face stops talking

void AS_BayInit () {
    as_bayStage=0;as_bayDropship=0.0;as_bayExitAt=0.0;as_bayComputer=0;as_bayHoldStop=0.0;as_bayDoorForce=0.0;
    as_lineN=0;as_lineUntil=0.0;as_lineBusy=0.0;as_lineTalk=0.0;as_weldWatch="";AS_CommanderHush();
    // The Bloodhound at the clamps on the dock's east side.
    as_bayShip=libNtve_gf_CreateActorAtPoint("ASR_Hercules",Point(as_oxF+55.0,as_oyF+8.5));
    ActorSend(as_bayShip,libNtve_gf_SetPosition(as_oxF+55.0,as_oyF+8.5,AS_GroundZ(as_oxF+55.0,as_oyF+8.5)));
    ActorSend(as_bayShip,"SetScale 0.8");
    AS_KitTurn(as_bayShip,180.0);
}
void AS_BayClear () {
    if(as_bayShip!=null) {ActorSend(as_bayShip,"Destroy");as_bayShip=null;}
    if(as_baySentrySpot!=null) {UnitRemove(as_baySentrySpot);as_baySentrySpot=null;}
    as_lineN=0;as_lineUntil=0.0;as_lineBusy=0.0;as_lineTalk=0.0;as_weldWatch="";AS_CommanderHush();
    AS_SnowClear();
}
// The level's things on the deck at the start: drones asleep, barrels, pickups.
void AS_BayPopulate () {
    AS_LevelThings();
}
void AS_BayPulse () {
    fixed t;int d;
    // The dropship lifts off the clamps and away.
    if(as_bayDropship>0.0 && as_bayShip!=null) {
        t=as_now-as_bayDropship;
        ActorSend(as_bayShip,libNtve_gf_SetPosition(as_oxF+55.0+t*t*0.9,as_oyF+8.5+t*0.3,AS_GroundZ(as_oxF+55.0,as_oyF+8.5)+t*t*0.25));
        if(t>6.0) {ActorSend(as_bayShip,"Destroy");as_bayShip=null;}
    }
    // The holdout spawners stop eight seconds after the hack is done.
    if(as_bayHoldStop>0.0 && as_now>=as_bayHoldStop) {
        as_bayHoldStop=0.0;AS_SpawnerStop("dock_holdout_spawn_01");AS_SpawnerStop("insane_ranger_spawn");
    }
    // If every drone sent at the control door died before it gave, the swarm still gets through in the end.
    if(as_bayDoorForce>0.0 && as_now>=as_bayDoorForce) {
        as_bayDoorForce=0.0;d=AS_DoorNamed("control");
        if(d>=0 && !as_drBroken[d]) {AS_DoorBreak(d);}
    }
    AS_WeldWatchPulse();
    AS_SnowPulse();
}
// A trigger's action that is the mission's own (src/Objects.galaxy passes the rest to the spawners).
void AS_MissionAction (string act, string arg) {
    if(as_level>=AS_LV_SCRIPT && AS_GenAction(act,arg)) {return;}
    if(act=="complete") {
        if(arg=="AccessBay" && as_objState[0]!=2) {
            AS_Objective(0,2);as_bayStage=MaxI(as_bayStage,2);
            AS_Log("objective: inner perimeter");
            AS_MarkAt(as_tmX[as_bayComputer],as_tmY[as_bayComputer]);
        }
        return;
    }
    if(act=="line") {AS_CommanderLater(arg,0.0);return;}
    if(act=="hint") {AS_HintMap(arg);return;}
    if(act=="dropship") {as_bayDropship=as_now;AS_AllSound("ColonistShip_LiftOff");AS_ShakeAll(0.08,1.2);return;}
    if(act=="music") {AS_AllSound("Event_Horner05sTerminalHack");return;}
    if(act=="sentry") {
        // The holo sentry: where the squad is shown it could set a sentry for the hold.
        if(as_baySentrySpot==null && as_sentrySpotX>0.0) {
            UnitCreate(1,"ASSentry",c_unitCreateIgnorePlacement,0,Point(as_sentrySpotX,as_sentrySpotY),180.0);
            as_baySentrySpot=UnitLastCreated();
            ActorSend(libNtve_gf_MainActorofUnit(as_baySentrySpot),"SetTintColor 90,200,255");
            ActorSend(libNtve_gf_MainActorofUnit(as_baySentrySpot),"SetOpacity 0.45");
            AS_HintSentrySpot();
        }
        return;
    }
    if(act=="weld") {as_weldWatch=arg;as_weldWatchAt=as_now;return;}
    if(act=="wall") {AS_WallBurst();return;}
}
// Weld suggestions: once the whole squad is past these doors (asw_marines_past_area), suggest welding one shut.
void AS_WeldWatchPulse () {
    int d;string first;int at;
    if(as_weldWatch=="" || as_tick%8!=3) {return;}
    at=StringFind(as_weldWatch,"|",c_stringCase);
    if(at>=1) {first=StringSub(as_weldWatch,1,at-1);}else {first=as_weldWatch;}
    d=AS_DoorNamed(first);
    if(d<0) {as_weldWatch="";return;}
    if(as_now-as_weldWatchAt>2.0) {
        as_weldWatch="";
        if(!as_drRecommend[d]) {as_drRecommend[d]=true;AS_HintWeld(d);}
    }
}
// The tank room's west wall gives way (a 10% chance as the squad passes): drone jumpers come through it.
void AS_WallBurst () {
    fixed x=as_oxF+12.0;fixed y=as_oyF+106.0;
    AS_Fx("ASFxBigBoom",x,y,1.0,0.0);AS_Burst(x,y,1.0,1.5,"200,190,170",5);
    AS_Sound("Doodad_SecurityGateDiagonalImpact",x,y,100.0,0.0);AS_ShakeAll(0.15,0.5);
    AS_Log("wall burst");
}
void AS_MissionDoorBroken (string name) {
    if(as_level!=AS_LV_BAY || name!="control") {return;}
    as_bayStage=MaxI(as_bayStage,5);as_bayDoorForce=0.0;
    AS_SpawnerStart("insane_buzz2_spawn");
    if(as_objState[1]==2) {AS_MarkAt((as_extX0+as_extX1)*0.5,(as_extY0+as_extY1)*0.5);}
}
void AS_WeldedEvent (int p, int d) {
    AS_AchieveEvent(p,"seal_of_quality");
    AS_HintEvent("door_welded",p);
}
void AS_MissionPanelHacked (int d, int p) {
    as_drLocked[d]=false;as_drHold[d]=as_now+2.0;
    AS_AllMsg("<c val=\"8CFFA0\">Access Granted</c>");
    AS_Fire("hacked:"+as_drName[d]);
    // Hacking either gate panel opens its own door and switches the other panel off.
    if(as_level==AS_LV_BAY && as_bayStage<1) {
        as_bayStage=1;
        AS_Log("gate panel hacked: "+as_drName[d]);
        if(as_drName[d]=="gate_west" && AS_DoorNamed("gate_east")>=0) {as_drHasPanel[AS_DoorNamed("gate_east")]=false;}
        if(as_drName[d]=="gate_east" && AS_DoorNamed("gate_west")>=0) {as_drHasPanel[AS_DoorNamed("gate_west")]=false;}
        AS_MarkAt(AS_DoorCX(d),AS_DoorCY(d)+2.0);
    }
}
void AS_MissionHackStarted (int i, int p) {
    if(as_level>=AS_LV_SCRIPT && i==as_bayComputer && !as_cpPda[i]) {AS_Fire("hackstart:terminal");return;}
    if(as_level!=AS_LV_BAY || i!=as_bayComputer) {return;}
    as_bayStage=MaxI(as_bayStage,3);
    AS_Log("flight data hack started");
    AS_AllSound("Event_Horner05sTerminalHack");
    AS_ActionLater("spawn","breakdoor_spawn",5.0);
    AS_ActionLater("spawn","dock_holdout_spawn_01",5.0);
    AS_ActionLater("spawn","insane_ranger_spawn",5.0);
    if(as_baySentrySpot!=null) {UnitRemove(as_baySentrySpot);as_baySentrySpot=null;}
    AS_MarkOff();
}
void AS_MissionHackDone (int i, int p) {
    if(as_level>=AS_LV_SCRIPT && i==as_bayComputer && !as_cpPda[i]) {AS_Fire("hacked:terminal");return;}
    if(as_level!=AS_LV_BAY || i!=as_bayComputer) {return;}
    // The tech requirement is lifted once the hack is through (Tech_req DisableTechMarineReq).
    as_needTech=false;as_techRestartAt=0.0;
    as_bayHoldStop=as_now+8.0;
    AS_ProtectTechCheck(i,p);
}
void AS_MissionDownloaded (int i, int p) {
    int d=AS_DoorNamed("control");
    if(as_level>=AS_LV_SCRIPT && i==as_bayComputer && !as_cpPda[i]) {AS_Fire("downloaded:terminal");return;}
    if(as_level!=AS_LV_BAY || i!=as_bayComputer || as_objState[1]==2) {return;}
    AS_Objective(1,2);as_bayStage=MaxI(as_bayStage,4);
    // Out to the escape lift: the extraction check (AS_ExtractPulse) runs from here.
    as_stage=AS_ST_ESCAPE;as_stageAt=as_now;as_checkpoint=5;
    AS_Log("flight data downloaded");
    AS_CommanderLater("co_m1_ob2",14.0);
    as_bayDoorForce=as_now+40.0;
    if(d<0 || as_drBroken[d]) {AS_MarkAt((as_extX0+as_extX1)*0.5,(as_extY0+as_extY1)*0.5);}
    else {AS_MarkAt(AS_DoorCX(d),AS_DoorCY(d));}
}
void AS_MissionPdaRead (int i, int p) {AS_AchieveEvent(p,"read_mail");}
// Protect the Tech: the tech took no damage through the hack and the squad killed more than ten meanwhile.
void AS_ProtectTechCheck (int i, int p) {
    int q;
    if(p<1 || FixedToInt(as_dmgTaken[p])>as_cpHackTaken[i] || AS_SquadKills()-as_cpHackKills[i]<=10) {return;}
    for(q=1;q<=AS_PLAYERS;q+=1) {if(q!=p && AS_Person(q)) {AS_MedalEvent(q,"protect_tech");}}
}
// ---- the commander's lines, as subtitles ------------------------------------------------
void AS_CommanderLater (string key, fixed delay) {
    if(as_lineN>=8) {return;}
    as_lineKey[as_lineN]=key;as_lineAt[as_lineN]=as_now+delay;as_lineN+=1;
}
// A line he has a voice clip for (tools/voice.py) is spoken over the radio, his face talking on the comm screen,
// and its subtitle stays up for the clip; a line not voiced yet is the subtitle and his still face, under the stock blip.
// A line due while he is still speaking waits for him to finish.
// Mission over or restarted: he stops mid-word and his line leaves the screen.
void AS_CommanderHush () {
    int p;
    for(p=1;p<=AS_PLAYERS;p+=1) {if(AS_Person(p)) {AS_HudSubtitle(p,"");}}
}
void AS_CommanderPulse () {
    int k;int p;string key;fixed secs;
    if(as_lineUntil>0.0 && as_now>as_lineUntil) {as_lineUntil=0.0;for(p=1;p<=AS_PLAYERS;p+=1) {if(AS_Person(p)) {AS_HudSubtitle(p,"");}}}
    if(as_lineTalk>0.0 && as_now>as_lineTalk) {as_lineTalk=0.0;for(p=1;p<=AS_PLAYERS;p+=1) {if(AS_Person(p)) {AS_HudTalk(p,false);}}}
    if(as_now<as_lineBusy) {return;}
    for(k=0;k<as_lineN;k+=1) {
        if(as_lineKey[k]=="" || as_now<as_lineAt[k]) {continue;}
        key=as_lineKey[k];as_lineKey[k]="";
        secs=AS_LineVoice(key);
        for(p=1;p<=AS_PLAYERS;p+=1) {
            if(!AS_Person(p)) {continue;}
            AS_HudSubtitle(p,"<c val=\"F0FFFF\">Commander:</c>  "+AS_LineText(key));
            if(secs>0.0) {AS_HudCommander(p,"ASVo_"+key);}
        }
        if(secs>0.0) {as_lineUntil=as_now+secs+1.5;as_lineBusy=as_now+secs+0.6;as_lineTalk=as_now+secs;}
        else {AS_AllSound("AbathurA_Transmission");as_lineUntil=as_now+9.0;as_lineBusy=0.0;}
        AS_Log("commander: "+key+" ("+FixedToString(secs,2)+" s voiced)");
        return;
    }
}
// QA: Ctrl+L, the squad to the next beat.
void AS_BaySkip () {
    int d;
    if(as_bayStage==0) {
        d=AS_DoorNamed("gate_east");
        if(d>=0) {AS_PanelHacked(d,0);}
        AS_SquadTo(as_oxF+32.5,as_oyF+40.0);
    }
    else if(as_bayStage<=2) {
        d=AS_DoorNamed("tank_s");if(d>=0) {as_drSeal[d]=0.0;AS_DoorSeamShow(d);}
        d=AS_DoorNamed("tank_n");if(d>=0) {as_drSeal[d]=0.0;AS_DoorSeamShow(d);}
        as_bayStage=3;AS_Objective(0,2);
        AS_SquadTo(as_oxF+30.5,as_oyF+131.5);
    }
    else if(as_objState[1]!=2) {as_cpHacked[as_bayComputer]=true;as_cpLocked[as_bayComputer]=false;AS_MissionHackDone(as_bayComputer,0);as_cpDone[as_bayComputer]=1.0;AS_MissionDownloaded(as_bayComputer,0);}
    else {d=AS_DoorNamed("control");if(d>=0 && !as_drBroken[d]) {AS_DoorBreak(d);}AS_SquadTo(as_oxF+48.5,as_oyF+131.0);}
}

// =====================================================================
// SCRIPTED MISSIONS (mission 3 on): the mission is its data. tools/<level>.py gives its objectives by key
// (OBJECTIVES, each with the spot its marker shows), its buttons (BUTTONS) and the map's own logic as
// triggers, outputs, timers and movers (src/Objects.galaxy); every action that is not the map's logic
// comes here. An objective is completed by 'complete <key>' (asw_objective_triggered SetComplete); once
// every one but the last is done, the last (the escape) is shown and the extraction is open.
//   complete <key>, show <key>        an objective done, or shown (Visible 0 until then)
//   open <door>                       a gate's movelinear opening: unlocked for good
//   power <button>                    a button with no power gets some
//   notech                            the tech requirement lifted (asw_tech_marine_req DisableTechMarineReq)
//   boom <x,y>                        a charge going off there (level cells)
//   lightning                         the storm lights the whole sky for a moment
//   shipguns <mover>                  the mover's two turrets cover the squad ('' stops them)
//   mark <key,x,y>                    the objective's marker moves on (a marker of AS's enabled for the next step)
//   countdown <secs>                  the escape against the clock (asw_objective_countdown): its time left by the
//                                     escape's name; at nothing the mission is lost (relay_fail_effects)
//   rockfall <x,y>                    the roof gives way there: dust, falling rock, a shudder (rocks_fall_*_relay)
// A terminal's hack and download (COMPUTER) fire "hackstart:terminal", "hacked:terminal" and "downloaded:terminal".
// =====================================================================
string[5] as_objKey;
bool[5] as_objShown;             // shown from the start (Visible 1)
fixed[5] as_objMX;               // where its marker stands, 0 none
fixed[5] as_objMY;
int as_genObjN;
string as_genExtName;
bool as_genTech;                 // the mission needs a tech until 'notech'
string as_genShip;               // the mover whose turrets are firing, "" none
sound as_genMusic;               // the hold's music bed ("musicloop"), stopped by "musicstop"
string as_genBroken="|";         // the windows already broken, "|x,y|" each: a window breaks once (never "": that is null to StringFind)
fixed as_genShipNext;
unit as_genShipLamp;
unit as_genShipLamp2;
fixed as_genFlashEnd;
fixed as_genCountEnd;            // the countdown's end, 0 none
string as_genCountBase;          // the escape's name without the time
// The level's own (build.py mission_galaxy, AS_MissionData<n>): where it extracts, whether it needs a tech,
// then its objectives in order, the last the escape.
void AS_GenLevel (string extName, bool tech) {as_genObjN=0;as_genExtName=extName;as_genTech=tech;}
void AS_GenObjective (string key, string name, bool shown, fixed mx, fixed my) {
    int k=as_genObjN;
    if(k>=5) {return;}
    as_genObjN+=1;
    as_objKey[k]=key;as_objName[k]=name;as_objShown[k]=shown;as_objMX[k]=mx;as_objMY[k]=my;
}
void AS_GenInit () {
    int k;
    as_objCount=as_genObjN;as_extName=as_genExtName;as_needTech=as_genTech;
    as_genShip="";as_genShipNext=0.0;as_genFlashEnd=0.0;as_lineN=0;as_lineUntil=0.0;as_lineBusy=0.0;as_lineTalk=0.0;as_weldWatch="";AS_CommanderHush();
    for(k=0;k<as_objCount;k+=1) {if(as_objShown[k]) {as_objState[k]=1;}}
    AS_MissionPopulate();
    AS_HiveEquip();
    AS_GenMark();
    AS_Log("mission start "+as_levelTitle[as_level]+", marines "+IntToString(AS_Humans())+", bots "+IntToString(as_botCount));
}
int AS_GenObj (string key) {
    int k;
    for(k=0;k<as_objCount;k+=1) {if(as_objKey[k]==key) {return k;}}
    return -1;
}
// The marker on the first objective still to do that has a spot; the extraction once only the escape is left.
void AS_GenMark () {
    int k;
    if(as_stage==AS_ST_ESCAPE) {AS_MarkAt((as_extX0+as_extX1)*0.5,(as_extY0+as_extY1)*0.5);return;}
    for(k=0;k<as_objCount-1;k+=1) {
        if(as_objState[k]==2) {continue;}
        if(as_objMX[k]>0.0) {AS_MarkAt(as_objMX[k],as_objMY[k]);return;}
    }
    AS_MarkOff();
}
void AS_GenComplete (string key) {
    int k=AS_GenObj(key);
    if(k<0 || as_objState[k]==2) {return;}
    AS_Objective(k,2);
    AS_Log("objective: "+key);
    AS_Fire("done:"+key);
    // A lift still riding down keeps its stage: the escape opens when its gates part (AS_RideMove).
    if(as_stage!=AS_ST_RIDE) {AS_GenEscapeCheck();}
    AS_GenMark();
}
// Only the escape left: AS_ExtractPulse checks the squad from here.
void AS_GenEscapeCheck () {
    int j;bool left=false;
    for(j=0;j<as_objCount-1;j+=1) {if(as_objState[j]!=2) {left=true;}}
    if(left || as_stage==AS_ST_ESCAPE) {return;}
    as_stage=AS_ST_ESCAPE;as_stageAt=as_now;as_checkpoint=MaxI(as_checkpoint,3);
    AS_Objective(as_objCount-1,1);
}
bool AS_GenAction (string act, string arg) {
    int i;int at;fixed x;fixed y;
    if(act=="complete") {AS_GenComplete(arg);return true;}
    if(act=="show") {i=AS_GenObj(arg);if(i>=0 && as_objState[i]==0) {AS_Objective(i,1);AS_GenMark();}return true;}
    if(act=="open") {
        i=AS_DoorNamed(arg);
        if(i<0) {AS_Log("open: no door "+arg);return true;}
        as_drLocked[i]=false;as_drSeal[i]=0.0;as_drHasPanel[i]=false;as_drHold[i]=as_now+2.0;
        if(as_drKind[i]==3) {as_drKind[i]=0;}
        AS_DoorSeamShow(i);
        AS_Log("door opened: "+arg);
        return true;
    }
    if(act=="power") {i=AS_ButtonNamed(arg);if(i>=0) {as_btOn[i]=true;}return true;}
    if(act=="kill") {AS_HiveKill(arg);return true;}
    // A wall blown out for good (AS's func_breakable): the door breaks and stays open.
    if(act=="blow") {i=AS_DoorNamed(arg);if(i>=0 && !as_drBroken[i]) {AS_DoorBreak(i);AS_Log("door blown: "+arg);}return true;}
    if(act=="notech") {as_needTech=false;as_techRestartAt=0.0;AS_Log("tech requirement lifted");return true;}
    if(act=="boom") {
        at=StringFind(arg,",",c_stringCase);
        x=as_oxF+StringToFixed(StringSub(arg,1,at-1));y=as_oyF+StringToFixed(StringSub(arg,at+1,StringLength(arg)));
        AS_Fx("ASFxBigBoom",x,y,0.5,0.0);AS_Burst(x,y,1.0,2.4,"255,190,110",6);AS_Flash(x,y,1.0,4.0,"255,200,140");
        AS_Fx("ASFxBoom",x+1.5,y-0.8,0.3,0.0);AS_Fx("ASFxBoom",x-1.2,y+1.0,0.3,0.0);
        AS_Sound("Doodad_SecurityGateDiagonalImpact",x,y,100.0,0.0);
        AS_ShakeAll(0.35,1.2);
        AS_Log("boom at "+arg);
        return true;
    }
    // A window gives way at a level cell: glass and sparks blown out, the crash, a shudder.
    if(act=="shatter") {
        if(StringFind(as_genBroken,"|"+arg+"|",c_stringCase)>0) {return true;}
        as_genBroken=as_genBroken+"|"+arg+"|";
        at=StringFind(arg,",",c_stringCase);
        x=as_oxF+StringToFixed(StringSub(arg,1,at-1));y=as_oyF+StringToFixed(StringSub(arg,at+1,StringLength(arg)));
        AS_Burst(x,y,1.2,1.4,"200,230,255",3);AS_Flash(x,y,1.2,1.8,"220,240,255");
        for(i=0;i<5;i+=1) {AS_Fx("ASFxSpark",x+RandomFixed(-1.0,1.0),y+RandomFixed(-1.0,1.0),RandomFixed(0.4,1.6),RandomFixed(0.0,360.0));}
        AS_Sound("Doodad_SecurityGateDiagonalImpact",x,y,100.0,0.0);
        AS_ShakeAll(0.12,0.3);
        AS_Log("window broke at "+arg);
        return true;
    }
    // The hold's music: a stinger, then the bed under the fight until "musicstop" fades it.
    if(act=="musicloop") {
        if(as_genMusic!=null) {SoundStop(as_genMusic,true);}
        AS_AllSound("Event_Horner05sTerminalHack");
        SoundPlay(SoundLink(arg,-1),PlayerGroupAll(),80.0,0.0);as_genMusic=SoundLastPlayed();
        return true;
    }
    // A floor vent bursts open under the drone coming up through it (relay_vent_explo_01): once per vent.
    if(act=="vent") {
        if(StringFind(as_genBroken,"|"+arg+"|",c_stringCase)>0) {return true;}
        as_genBroken=as_genBroken+"|"+arg+"|";
        at=StringFind(arg,",",c_stringCase);
        x=as_oxF+StringToFixed(StringSub(arg,1,at-1));y=as_oyF+StringToFixed(StringSub(arg,at+1,StringLength(arg)));
        AS_Burst(x,y,0.3,1.0,"110,105,95",4);AS_Fx("ASFxBoom",x,y,0.1,0.0);
        for(i=0;i<3;i+=1) {AS_Fx("ASFxSpark",x+RandomFixed(-0.5,0.5),y+RandomFixed(-0.5,0.5),RandomFixed(0.2,1.0),RandomFixed(0.0,360.0));}
        AS_Sound("Doodad_SecurityGateDiagonalImpact",x,y,80.0,0.0);
        return true;
    }
    // The lift: in sight ("board"), its console pressed ("liftbutton"), a crawler along its ceiling ("crawl"), the
    // breath of slow motion ("slomo").
    if(act=="board") {AS_BoardArm();return true;}
    if(act=="liftbutton") {AS_LiftButton();return true;}
    if(act=="crawl") {AS_Crawl(arg);return true;}
    if(act=="slomo") {AS_Slomo();return true;}
    if(act=="musicstop") {if(as_genMusic!=null) {SoundStop(as_genMusic,true);as_genMusic=null;}return true;}
    if(act=="lightning") {AS_Lightning();return true;}
    if(act=="shipguns") {as_genShip=arg;return true;}
    // The level's lighting preset by number (src/Main.galaxy as_lightId), eased in: the power back on.
    if(act=="lights") {as_light=StringToInt(arg);GameSetLighting(as_lightId[as_light],3.0);AS_Log("lights: "+as_lightId[as_light]);return true;}
    if(act=="mark") {
        at=StringFind(arg,",",c_stringCase);i=AS_GenObj(StringSub(arg,1,at-1));
        arg=StringSub(arg,at+1,StringLength(arg));at=StringFind(arg,",",c_stringCase);
        if(i>=0) {as_objMX[i]=as_oxF+StringToFixed(StringSub(arg,1,at-1));as_objMY[i]=as_oyF+StringToFixed(StringSub(arg,at+1,StringLength(arg)));AS_GenMark();}
        return true;
    }
    if(act=="countdown") {
        as_genCountEnd=as_now+StringToFixed(arg);as_genCountBase=as_objName[as_objCount-1];
        AS_AllSound("Alert_UniObjectiveDiscovered");
        AS_Log("countdown: "+arg+" s");
        return true;
    }
    if(act=="rockfall") {
        at=StringFind(arg,",",c_stringCase);
        x=as_oxF+StringToFixed(StringSub(arg,1,at-1));y=as_oyF+StringToFixed(StringSub(arg,at+1,StringLength(arg)));
        AS_Burst(x,y,1.4,2.6,"150,135,115",6);
        for(i=0;i<4;i+=1) {AS_Fx("ASFxSpark",x+RandomFixed(-1.2,1.2),y+RandomFixed(-1.2,1.2),RandomFixed(0.6,2.0),RandomFixed(0.0,360.0));}
        AS_Sound("Doodad_SecurityGateDiagonalImpact",x,y,90.0,0.0);
        AS_ShakeAll(0.25,1.4);
        AS_Log("rockfall at "+arg);
        return true;
    }
    return false;
}
// The escape's clock: the time left by its name, and the mission lost when it runs out (countdown_escape
// OnCountdownFailed: the station goes up, a white-out and a shudder) unless the squad is aboard by then.
void AS_GenCountdownPulse () {
    int k=as_objCount-1;int left;
    if(as_genCountEnd<=0.0 || k<0) {return;}
    if(as_stage==AS_ST_DONE || as_objState[k]==2) {as_genCountEnd=0.0;as_objName[k]=as_genCountBase;return;}
    left=MaxI(0,CeilingI(as_genCountEnd-as_now));
    as_objName[k]=as_genCountBase+"  <c val=\"FF6050\">"+IntToString(left/60)+":"+StringSub(IntToString(100+left%60),2,3)+"</c>";
    if(as_now<as_genCountEnd || as_failed || as_failAt>0.0) {return;}
    as_genCountEnd=0.0;as_objName[k]=as_genCountBase;
    AS_ShakeAll(1.0,2.5);GameSetLighting("ASPowered",0.05);as_genFlashEnd=as_now+2.0;
    AS_AllSound("Doodad_SecurityGateDiagonalImpact");
    as_failAt=as_now+1.5;as_failWhy="The warhead went off with the squad still in the station.";
    AS_Log("countdown ran out");
}
// The storm: the sky flashes white-blue over the whole level for a moment, and the thunder follows.
void AS_Lightning () {
    int p;
    for(p=1;p<=AS_PLAYERS;p+=1) {
        if(!AS_Person(p)) {continue;}
        CameraShakeStart(p,c_cameraPositionBoth,c_cameraDirectionXYZ,0.02,6.0,40.0,0.3);
    }
    GameSetLighting("ASPowered",0.05);as_genFlashEnd=as_now+0.3;
    AS_AllSound("Event_Horner05sTerminalHack");
}
// Every step of a scripted mission: snow under the sky, the storm's flash fading, the dropship's turrets.
void AS_GenPulse () {
    int m;int t;fixed x;fixed y;fixed ang;
    AS_SnowPulse();AS_WeldWatchPulse();AS_HivePulse();AS_GenCountdownPulse();
    if(as_genFlashEnd>0.0 && as_now>=as_genFlashEnd) {as_genFlashEnd=0.0;GameSetLighting(as_lightId[as_light],0.5);}
    if(as_genShip=="") {return;}
    m=AS_MoverNamed(as_genShip);
    if(m<0 || as_moA[m]==null) {return;}
    x=as_moX[m];y=as_moY[m];
    // Her lamps go with her: the bridge is dark but where she lights it.
    if(as_genShipLamp==null) {
        UnitCreate(1,"ASLightWhitebig",c_unitCreateIgnorePlacement,0,Point(x,y),0.0);as_genShipLamp=UnitLastCreated();
        UnitCreate(1,"ASLightColdbig",c_unitCreateIgnorePlacement,0,Point(x,y),0.0);as_genShipLamp2=UnitLastCreated();
    }
    UnitSetPosition(as_genShipLamp,Point(x,y-3.0),true);UnitSetPosition(as_genShipLamp2,Point(x+2.5,y-3.5),true);
    // Two sentry tops under her nose (asw_sentry_top_machinegun, TurretRange 1800): a round every 0.15 s.
    if(as_now<as_genShipNext) {return;}
    as_genShipNext=as_now+0.15;
    t=AS_AssistTarget(x,y-1.0,270.0,14.0,180.0);
    if(t<0) {return;}
    ang=ATan2(as_aY[t]-y,as_aX[t]-x);
    AS_Bullet(0,x+Cos(ang)*1.0,y+Sin(ang)*1.0,ang+RandomFixed(-2.0,2.0),16.0,12.0,0,0,70.0,"255,210,130",1.4,1.8,0.04);
    AS_Flash(x+Cos(ang)*1.1,y+Sin(ang)*1.1,1.6,0.4,"");
    AS_Sound("SentryGun_AttackLaunch",x,y,80.0,0.1);
}
void AS_GenClear () {
    if(as_genShipLamp!=null) {UnitRemove(as_genShipLamp);as_genShipLamp=null;}
    if(as_genShipLamp2!=null) {UnitRemove(as_genShipLamp2);as_genShipLamp2=null;}
    as_genShip="";as_genFlashEnd=0.0;as_genBroken="|";as_genCountEnd=0.0;
    if(as_genMusic!=null) {SoundStop(as_genMusic,true);as_genMusic=null;}
}
// QA: Ctrl+L, the next objective done and the squad at the next marker.
void AS_GenSkip () {
    int k;
    for(k=0;k<as_objCount-1;k+=1) {
        if(as_objState[k]==2) {continue;}
        if(as_objMX[k]>0.0) {AS_SquadTo(as_objMX[k]-1.0,as_objMY[k]-1.0);}
        AS_GenComplete(as_objKey[k]);
        return;
    }
    AS_SquadTo((as_extX0+as_extX1)*0.5,(as_extY0+as_extY1)*0.5);
}
