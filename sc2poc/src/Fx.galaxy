// =====================================================================
// Effects: pooled additive mesh units (tracers, flashes, bursts, flame,
// arcs), one-shot stock models (deaths, impacts), lamps, sounds.
// =====================================================================

const int AS_FXN = 192;
unit[192] as_fx;
int[192] as_fxLife;
int[192] as_fxBorn;
string[192] as_fxRot;          // a streak's rotation message, built once and sent again each step ("" for sprites)
int as_fxNext;

// Lay an authored effect mesh's +X along `facing`. A unit's actor takes SetRotation
// absolutely and the mesh's +X comes out as up x forward (PUBG's BG_AimActor), so
// forward is the level vector to the right of the direction. libNtve's
// MakeModelFaceAngle sends forward = the direction itself, which drew every tracer
// and the laser sight a quarter turn off their line.
string AS_AimMsg (fixed facing) {
    return libNtve_gf_SetRotation(Sin(facing),0.0-Cos(facing),0.0,0.0,0.0,1.0);
}
void AS_AimFx (unit u, fixed facing) {
    ActorSend(libNtve_gf_MainActorofUnit(u),AS_AimMsg(facing));
}
// A short-lived effect unit. z is the height above the deck; s* are scale multipliers.
// Only streaks (tracers, arcs) are turned: the flash, burst, flame and ring meshes look
// the same at any facing, and building a rotation message per sprite per step was the
// costliest thing a burst of fire did.
unit AS_FxUnit (string kind, fixed x, fixed y, fixed z, fixed facing, fixed sx, fixed syz, string tint, int life) {
    int i=as_fxNext;
    as_fxNext=(as_fxNext+1)%AS_FXN;
    if(as_fx[i]!=null) {UnitRemove(as_fx[i]);as_fx[i]=null;}
    if(x<as_oxF+0.5 || y<as_oyF+0.5 || x>as_oxF+IntToFixed(as_lw)-0.5 || y>as_oyF+IntToFixed(as_lh)-0.5) {return null;}
    UnitCreate(1,kind,c_unitCreateIgnorePlacement,0,Point(x,y),facing-90.0);
    as_fx[i]=UnitLastCreated();as_fxLife[i]=life;as_fxBorn[i]=as_tick;as_fxRot[i]="";
    // Facing on the actor as well: the unit's own facing alone did not turn the meshes.
    if(kind=="ASFxTracer" || kind=="ASFxArc") {as_fxRot[i]=AS_AimMsg(facing);ActorSend(libNtve_gf_MainActorofUnit(as_fx[i]),as_fxRot[i]);}
    UnitSetHeight(as_fx[i],z,0.0);
    UnitSetScale(as_fx[i],sx*100.0,syz*100.0,syz*100.0);
    if(tint!="") {ActorSend(libNtve_gf_MainActorofUnit(as_fx[i]),"SetTintColor "+tint);}
    return as_fx[i];
}
void AS_FxPulse () {
    int i;
    for(i=0;i<AS_FXN;i+=1) {
        // A unit made this step has not been drawn yet: it starts counting next step.
        if(as_fx[i]==null || as_fxBorn[i]==as_tick) {continue;}
        // Streaks (rail beams, arcs) hold their line only if the rotation is sent again.
        if(as_fxRot[i]!="") {ActorSend(libNtve_gf_MainActorofUnit(as_fx[i]),as_fxRot[i]);}
        as_fxLife[i]-=1;
        if(as_fxLife[i]==1) {ActorSend(libNtve_gf_MainActorofUnit(as_fx[i]),"SetOpacity 0 0.0625");}
        if(as_fxLife[i]<=0) {UnitRemove(as_fx[i]);as_fx[i]=null;}
    }
}
// A tracer from (x0,y0) to (x1,y1): the mesh is one unit long along the unit's facing.
void AS_Tracer (fixed x0, fixed y0, fixed x1, fixed y1, fixed z, string tint, fixed width, int life) {
    fixed d=SquareRoot((x1-x0)*(x1-x0)+(y1-y0)*(y1-y0));
    if(d<0.05) {return;}
    AS_FxUnit("ASFxTracer",x0,y0,z,ATan2(y1-y0,x1-x0),d,width,tint,life);
}
void AS_Arc (fixed x0, fixed y0, fixed x1, fixed y1, fixed z) {
    fixed d=SquareRoot((x1-x0)*(x1-x0)+(y1-y0)*(y1-y0));
    if(d<0.05) {return;}
    AS_FxUnit("ASFxArc",x0,y0,z,ATan2(y1-y0,x1-x0),d,RandomFixed(0.7,1.3),"",2);
}
void AS_Flash (fixed x, fixed y, fixed z, fixed scale, string tint) {
    AS_FxUnit("ASFxFlash",x,y,z,RandomFixed(0.0,360.0),scale,scale,tint,1);
}
void AS_Burst (fixed x, fixed y, fixed z, fixed scale, string tint, int life) {
    AS_FxUnit("ASFxBurst",x,y,z,RandomFixed(0.0,360.0),scale,scale,tint,life);
}
void AS_Ring (fixed x, fixed y, fixed radius, string tint, int life) {
    AS_FxUnit("ASFxRing",x,y,0.03,0.0,radius,radius,tint,life);
}
// A stock model played once where something happened (deaths, impacts).
void AS_Fx (string kind, fixed x, fixed y, fixed z, fixed facing) {
    actor a=libNtve_gf_CreateActorAtPoint(kind,Point(x,y));
    ActorSend(a,libNtve_gf_SetPosition(x,y,AS_GroundZ(x,y)+z));
    // Stock models take SetRotation with the nose along minus the forward vector (PUBG's BG_ShipAim).
    ActorSend(a,libNtve_gf_SetRotation(0.0-Cos(facing),0.0-Sin(facing),0.0,0.0,0.0,1.0));
}

// ---- sounds -----------------------------------------------------------
fixed[16] as_sndLast;
string[16] as_sndId;
int as_sndCount;
void AS_Sound (string id, fixed x, fixed y, fixed volume, fixed minGap) {
    int i;int slot= -1;
    // Rapid weapons would stack hundreds of the same sound: one every minGap seconds.
    for(i=0;i<as_sndCount;i+=1) {if(as_sndId[i]==id) {slot=i;break;}}
    if(slot<0 && as_sndCount<16) {slot=as_sndCount;as_sndId[slot]=id;as_sndLast[slot]= -10.0;as_sndCount+=1;}
    if(slot>=0) {
        if(as_now-as_sndLast[slot]<minGap) {return;}
        as_sndLast[slot]=as_now;
    }
    SoundPlayAtPoint(SoundLink(id,-1),PlayerGroupAll(),Point(x,y),0.5,volume,0.0);
}
void AS_SoundUI (int p, string id) {
    SoundPlay(SoundLink(id,-1),AS_Me(p),100.0,0.0);
}

// ---- lamps ------------------------------------------------------------
const int AS_LAMPS = 160;
unit[AS_LAMPS] as_lamp;
int[AS_LAMPS] as_lampFlicker;
bool[AS_LAMPS] as_lampOn;
fixed[AS_LAMPS] as_lampNext;
int as_lampCount;
// Room lamps throw Alien Swarm's wide pools: the stock large omni light of their colour, scaled up
// (tried: the map's own M3 point lights drew nothing in the client, 2026-10-23).
string AS_LightUnit (string kind) {
    if(kind=="red" || kind=="redbig") {return "ASLightRedbig";}
    if(kind=="orange" || kind=="orangebig") {return "ASLightOrangebig";}
    if(kind=="cold" || kind=="coldbig") {return "ASLightColdbig";}
    if(kind=="green") {return "ASLightGreenbig";}
    if(kind=="purple") {return "ASLightPurplebig";}
    if(kind=="yellow") {return "ASLightYellowbig";}
    return "ASLightWhitebig";
}
void AS_Lamp (fixed x, fixed y, string kind, int flicker) {
    if(as_lampCount>=AS_LAMPS) {return;}
    UnitCreate(1,AS_LightUnit(kind),c_unitCreateIgnorePlacement,0,Point(x,y),270.0);
    UnitSetHeight(UnitLastCreated(),2.1,0.0);
    if(StringContains(kind,"big",c_stringEnd,c_stringCase)) {ActorSend(libNtve_gf_MainActorofUnit(UnitLastCreated()),"SetScale 2.2");}
    else {ActorSend(libNtve_gf_MainActorofUnit(UnitLastCreated()),"SetScale 1.7");}
    as_lamp[as_lampCount]=UnitLastCreated();
    as_lampFlicker[as_lampCount]=flicker;as_lampOn[as_lampCount]=true;
    as_lampNext[as_lampCount]=RandomFixed(0.5,4.0);
    as_lampCount+=1;
}
// A light made elsewhere (a wall bay's lamp box) joins the lamps, to fail or sputter as the room lamps do.
// False when the table is full: the caller keeps it.
bool AS_LampAdopt (unit u, int flicker) {
    if(as_lampCount>=AS_LAMPS) {return false;}
    as_lamp[as_lampCount]=u;as_lampFlicker[as_lampCount]=flicker;as_lampOn[as_lampCount]=true;
    as_lampNext[as_lampCount]=as_now+RandomFixed(0.5,6.0);
    as_lampCount+=1;
    return true;
}
void AS_LampSet (int i, bool on) {
    if(as_lampOn[i]==on) {return;}
    as_lampOn[i]=on;libNtve_gf_ShowHideUnit(as_lamp[i],on);
}
void AS_LampsClear () {
    int i;
    for(i=0;i<as_lampCount;i+=1) {UnitRemove(as_lamp[i]);as_lamp[i]=null;}
    as_lampCount=0;
}
// Failing lamps: long dark spells; sputtering lamps: rapid stutter; alarms pulse.
void AS_LampSparks (int i) {
    point q=UnitGetPosition(as_lamp[i]);int k;
    for(k=0;k<3;k+=1) {AS_Fx("ASFxSpark",PointGetX(q)+RandomFixed(-0.3,0.3),PointGetY(q)+RandomFixed(-0.3,0.3),RandomFixed(1.4,2.0),RandomFixed(0.0,360.0));}
    AS_Burst(PointGetX(q),PointGetY(q),2.0,0.5,"255,230,170",2);
}
void AS_LampPulse () {
    int i;
    for(i=0;i<as_lampCount;i+=1) {
        if(as_lampFlicker[i]==0 || as_now<as_lampNext[i]) {continue;}
        if(as_lampFlicker[i]==1) {
            if(as_lampOn[i]) {AS_LampSet(i,false);as_lampNext[i]=as_now+RandomFixed(0.4,2.5);}
            else {AS_LampSet(i,true);as_lampNext[i]=as_now+RandomFixed(1.5,7.0);}
        }
        else if(as_lampFlicker[i]==2) {
            AS_LampSet(i,!as_lampOn[i]);
            // A sputtering lamp spits sparks now and then as it catches, as Alien Swarm's broken lights do.
            if(as_lampOn[i] && RandomInt(0,11)==0) {AS_LampSparks(i);}
            if(RandomInt(0,9)==0) {as_lampNext[i]=as_now+RandomFixed(1.0,4.0);}
            else {as_lampNext[i]=as_now+RandomFixed(0.06,0.2);}
        }
        else {
            AS_LampSet(i,!as_lampOn[i]);
            as_lampNext[i]=as_now+0.5;
            if(AS_HordeActive()) {as_lampNext[i]=as_now+0.25;}
        }
    }
}

// ---- flame puffs ------------------------------------------------------
// The flamer's burning gobs (and the incendiary sentry's); cold puffs are the extinguisher's spray
// (no damage: they put fires out) and the freeze sentry's nitrogen (they freeze what they touch).
const int AS_PUFFS = 64;
unit[64] as_puff;
fixed[64] as_puffX;
fixed[64] as_puffY;
fixed[64] as_puffVX;
fixed[64] as_puffVY;
fixed[64] as_puffAge;
fixed[64] as_puffLife;
fixed[64] as_puffDmg;
bool[64] as_puffCold;
int[64] as_puffItem;
int[64] as_puffBy;
int as_puffNext;
// lead: how long ago in this step the puff left the nozzle, so a stream spreads evenly.
void AS_Puff (int p, fixed x, fixed y, fixed angle, fixed speed, fixed life, fixed lead, fixed dmg, bool cold) {
    int i=as_puffNext;
    as_puffNext=(as_puffNext+1)%AS_PUFFS;
    if(as_puff[i]!=null) {UnitRemove(as_puff[i]);}
    if(lead>0.0 && !AS_Solid(x+Cos(angle)*speed*lead,y+Sin(angle)*speed*lead)) {x+=Cos(angle)*speed*lead;y+=Sin(angle)*speed*lead;}
    UnitCreate(1,"ASFxFlame",c_unitCreateIgnorePlacement,0,Point(x,y),RandomFixed(0.0,360.0));
    as_puff[i]=UnitLastCreated();
    UnitSetHeight(as_puff[i],0.55,0.0);UnitSetScale(as_puff[i],30.0,30.0,30.0);
    if(cold) {ActorSend(libNtve_gf_MainActorofUnit(as_puff[i]),"SetTintColor 170,220,255");}
    // Flame leaves the nozzle blue-white hot, as AS's flamer jet does, and turns to orange fire (AS_PuffPulse).
    else {ActorSend(libNtve_gf_MainActorofUnit(as_puff[i]),"SetTintColor 150,190,255");}
    as_puffX[i]=x;as_puffY[i]=y;as_puffVX[i]=Cos(angle)*speed;as_puffVY[i]=Sin(angle)*speed;
    as_puffAge[i]=0.0;as_puffLife[i]=life;as_puffBy[i]=p;as_puffDmg[i]=dmg;as_puffCold[i]=cold;as_puffItem[i]=as_dmgItem;
}
void AS_PuffPulse () {
    int i;int j;fixed nx;fixed ny;fixed t;fixed r;fixed s;
    for(i=0;i<AS_PUFFS;i+=1) {
        if(as_puff[i]==null) {continue;}
        as_puffAge[i]+=AS_DT;
        if(as_puffAge[i]>=as_puffLife[i]) {UnitRemove(as_puff[i]);as_puff[i]=null;continue;}
        if(!as_puffCold[i] && as_puffAge[i]>=0.1 && as_puffAge[i]-AS_DT<0.1) {ActorSend(libNtve_gf_MainActorofUnit(as_puff[i]),"SetTintColor 255,255,255");}
        nx=as_puffX[i]+as_puffVX[i]*AS_DT;ny=as_puffY[i]+as_puffVY[i]*AS_DT;
        if(AS_Solid(nx,ny)) {
            // Flame splashes along a wall instead of passing through it.
            as_puffVX[i]*=0.2;as_puffVY[i]*=0.2;nx=as_puffX[i];ny=as_puffY[i];
        }
        as_puffX[i]=nx;as_puffY[i]=ny;
        t=as_puffAge[i]/as_puffLife[i];
        s=30.0+150.0*t;r=0.25+0.75*t;
        UnitSetPosition(as_puff[i],Point(nx,ny),true);
        UnitSetScale(as_puff[i],s,s,s);
        if(t>0.6) {ActorSend(libNtve_gf_MainActorofUnit(as_puff[i]),"SetOpacity "+FixedToString(1.0-(t-0.6)*2.5,2)+" 0.0625");}
        // Everything the flame touches burns; the cold freezes or puts fires out.
        for(j=0;j<AS_MAXALIEN;j+=1) {
            if(as_a[j]==null || as_aKind[j]==AS_BARREL && as_puffCold[i]) {continue;}
            if(AbsF(as_aX[j]-nx)>r+as_aRadius[j] || AbsF(as_aY[j]-ny)>r+as_aRadius[j]) {continue;}
            if((as_aX[j]-nx)*(as_aX[j]-nx)+(as_aY[j]-ny)*(as_aY[j]-ny)<(r+as_aRadius[j])*(r+as_aRadius[j])) {
                if(as_puffCold[i]) {
                    as_aBurnUntil[j]=0.0;
                    // The freeze sentry's spray also stings, 1 a shot (asw_sentry_top_icer.cpp 54-56); the extinguisher does not.
                    if(as_puffDmg[i]>0.0) {
                        if(as_aFreezeUntil[j]<=as_now) {as_dmgItem=as_puffItem[i];AS_HurtAlien(j,as_puffDmg[i],0,as_puffBy[i],as_puffX[i]-as_puffVX[i],as_puffY[i]-as_puffVY[i]);as_dmgItem=0;}
                        if(as_a[j]!=null) {AS_Freeze(j,0.6);}
                    }
                    continue;
                }
                as_dmgItem=as_puffItem[i];AS_HurtAlien(j,as_puffDmg[i]*AS_DT*3.0,1,as_puffBy[i],as_puffX[i]-as_puffVX[i],as_puffY[i]-as_puffVY[i]);as_dmgItem=0;
                if(as_a[j]!=null) {AS_Ignite(j,as_puffBy[i],5.0);}
            }
        }
    }
}

// ---- gore ---------------------------------------------------------------
// Blood splats stay on the deck for most of a minute, multiplied over the floor.
const int AS_SPLATS = 64;
unit[64] as_splat;
unit[64] as_splatGlow;            // the splat's added yellow-green glow, laid with it
fixed[64] as_splatUntil;
bool[64] as_splatFading;
int as_splatNext;
void AS_Splat (fixed x, fixed y, fixed facing, fixed size) {
    int i=as_splatNext;string kind="1";
    as_splatNext=(as_splatNext+1)%AS_SPLATS;
    if(as_splat[i]!=null) {UnitRemove(as_splat[i]);as_splat[i]=null;}
    if(as_splatGlow[i]!=null) {UnitRemove(as_splatGlow[i]);as_splatGlow[i]=null;}
    if(AS_Solid(x,y)) {return;}
    if(RandomInt(0,1)==0) {kind="2";}
    UnitCreate(1,"ASFxSplat"+kind,c_unitCreateIgnorePlacement,0,Point(x,y),facing-90.0);
    as_splat[i]=UnitLastCreated();
    AS_AimFx(as_splat[i],facing);
    UnitSetScale(as_splat[i],size*100.0,size*100.0,100.0);
    UnitCreate(1,"ASFxSplatGlow"+kind,c_unitCreateIgnorePlacement,0,Point(x,y),facing-90.0);
    as_splatGlow[i]=UnitLastCreated();
    AS_AimFx(as_splatGlow[i],facing);
    UnitSetScale(as_splatGlow[i],size*100.0,size*100.0,100.0);
    as_splatUntil[i]=as_now+RandomFixed(35.0,50.0);as_splatFading[i]=false;
}
// A blast's scorch mark: the splat pool's next slot, without the glow.
void AS_Scorch (fixed x, fixed y, fixed size) {
    int i=as_splatNext;
    as_splatNext=(as_splatNext+1)%AS_SPLATS;
    if(as_splat[i]!=null) {UnitRemove(as_splat[i]);as_splat[i]=null;}
    if(as_splatGlow[i]!=null) {UnitRemove(as_splatGlow[i]);as_splatGlow[i]=null;}
    if(AS_Solid(x,y)) {return;}
    UnitCreate(1,"ASFxScorch",c_unitCreateIgnorePlacement,0,Point(x,y),RandomFixed(0.0,360.0));
    as_splat[i]=UnitLastCreated();
    UnitSetScale(as_splat[i],size*100.0,size*100.0,100.0);
    as_splatUntil[i]=as_now+RandomFixed(40.0,55.0);as_splatFading[i]=false;
}
void AS_SplatPulse () {
    int i=as_tick%AS_SPLATS;
    if(as_splat[i]==null || as_now<as_splatUntil[i]) {return;}
    if(!as_splatFading[i]) {
        ActorSend(libNtve_gf_MainActorofUnit(as_splat[i]),"SetOpacity 0 3");
        if(as_splatGlow[i]!=null) {ActorSend(libNtve_gf_MainActorofUnit(as_splatGlow[i]),"SetOpacity 0 3");}
        as_splatFading[i]=true;as_splatUntil[i]=as_now+3.5;return;
    }
    UnitRemove(as_splat[i]);as_splat[i]=null;
    if(as_splatGlow[i]!=null) {UnitRemove(as_splatGlow[i]);as_splatGlow[i]=null;}
}
// Every effect unit still out (tracer meshes, flame puffs, splats), cleared between levels.
// ---- snow -------------------------------------------------------------
// Landing Bay opens outdoors in falling snow, as AS's dock does: flakes drift down round each player
// while they are under the sky, thinning out as they fall. A pool of its own, so a fight never takes them.
const int AS_FLAKES = 96;
unit[96] as_flake;
int as_flakeNext;
void AS_SnowPulse () {
    int p;unit u;point c;fixed fall;
    if(as_outX1<=as_outX0) {return;}
    for(p=1;p<=AS_PLAYERS;p+=1) {
        if(!AS_Person(p) || !as_alive[p] || (as_bot[p] && !(as_auto && p==1))) {continue;}
        c=UnitGetPosition(as_m[p]);
        if(!AS_InRect(c,as_outX0,as_outY0,as_outX1,as_outY1)) {continue;}
        u=as_flake[as_flakeNext];
        if(u==null) {
            UnitCreate(1,"ASFxBurst",c_unitCreateIgnorePlacement,0,c,0.0);u=UnitLastCreated();as_flake[as_flakeNext]=u;
            UnitSetScale(u,4.5,4.5,4.5);ActorSend(libNtve_gf_MainActorofUnit(u),"SetTintColor 200,210,235");
        }
        as_flakeNext=(as_flakeNext+1)%AS_FLAKES;
        fall=RandomFixed(2.0,3.2);
        UnitSetPosition(u,PointWithOffset(c,RandomFixed(-6.0,6.0),RandomFixed(-3.5,7.5)),false);
        UnitSetHeight(u,RandomFixed(4.0,6.0),0.0);UnitSetHeight(u,0.05,fall);
        ActorSend(libNtve_gf_MainActorofUnit(u),"SetOpacity 1 0");ActorSend(libNtve_gf_MainActorofUnit(u),"SetOpacity 0 "+FixedToString(fall,2));
    }
}
void AS_SnowClear () {
    int i;
    for(i=0;i<AS_FLAKES;i+=1) {if(as_flake[i]!=null) {UnitRemove(as_flake[i]);as_flake[i]=null;}}
}
// ---- the air ---------------------------------------------------------------
// Alien Swarm's rooms are never still: dust hangs in the air and catches the light, the red laser sight lights
// up the motes it passes through, and steam curls off the grates over the lit under-deck. Each human player's
// screen gets its share, from a pool of its own.
const int AS_MOTES = 96;
unit[96] as_mote;
fixed[96] as_moteFade;            // when it starts to fade out (0 already fading)
fixed[96] as_moteGone;            // when it is removed
int as_moteNext;
fixed as_steamVentNext;
fixed as_sparkNext;
unit AS_Mote (fixed x, fixed y, fixed z, fixed scale, string tint, fixed rise, fixed life) {
    int i=as_moteNext;unit u;actor a;
    as_moteNext=(as_moteNext+1)%AS_MOTES;
    if(AS_Solid(x,y)) {return null;}
    u=as_mote[i];
    if(u==null) {UnitCreate(1,"ASFxSmoke",c_unitCreateIgnorePlacement,0,Point(x,y),0.0);u=UnitLastCreated();as_mote[i]=u;}
    else {UnitSetPosition(u,Point(x,y),false);}
    a=libNtve_gf_MainActorofUnit(u);
    UnitSetScale(u,scale,scale,scale);
    ActorSend(a,"SetTintColor "+tint);
    ActorSend(a,"SetOpacity 0 0");ActorSend(a,"SetOpacity 1 "+FixedToString(life*0.3,2));
    UnitSetHeight(u,z,0.0);UnitSetHeight(u,z+rise,life);
    as_moteFade[i]=as_now+life*0.6;as_moteGone[i]=as_now+life;
    return u;
}
void AS_AirPulse () {
    int p;int i;point c;fixed d;fixed t;int v;fixed vx;fixed vy;fixed s;
    for(i=0;i<AS_MOTES;i+=1) {
        if(as_mote[i]==null) {continue;}
        if(as_moteFade[i]>0.0 && as_now>=as_moteFade[i]) {ActorSend(libNtve_gf_MainActorofUnit(as_mote[i]),"SetOpacity 0 "+FixedToString(MaxF(0.1,as_moteGone[i]-as_now),2));as_moteFade[i]=0.0;}
    }
    for(p=1;p<=AS_PLAYERS;p+=1) {
        if(!AS_Person(p) || !as_alive[p] || (as_bot[p] && !(as_auto && p==1)) || as_view[p]!=0) {continue;}
        if(as_camUnit[p]!=null) {c=UnitGetPosition(as_camUnit[p]);}
        else {c=UnitGetPosition(as_m[p]);}
        // Dust: a faint warm speck somewhere on screen, drifting up through the lamp light.
        if(as_tick%2==0) {
            s=RandomFixed(3.5,6.0);
            AS_Mote(PointGetX(c)+RandomFixed(-4.5,4.5),PointGetY(c)+RandomFixed(-2.4,4.6),RandomFixed(0.3,2.2),s,"92,86,72",RandomFixed(0.15,0.5),RandomFixed(2.5,4.5));
        }
        // The motes the laser passes through glow pink for a moment (as in Landing Bay's dock, 2026-10-23).
        if(as_tick%3==p%3 && AS_GunHasLaser(p)) {
            d=AS_RayWall(PointGetX(UnitGetPosition(as_laser[p])),PointGetY(UnitGetPosition(as_laser[p])),as_aim[p],8.0);
            t=RandomFixed(0.4,MaxF(0.5,d));
            AS_Mote(PointGetX(UnitGetPosition(as_laser[p]))+Cos(as_aim[p])*t+RandomFixed(-0.05,0.05),PointGetY(UnitGetPosition(as_laser[p]))+Sin(as_aim[p])*t+RandomFixed(-0.05,0.05),
                    MaxF(0.1,0.56*(1.0-t/MaxF(1.0,d))),RandomFixed(2.5,4.0),"255,70,95",0.05,RandomFixed(0.5,0.9));
        }
    }
    AS_ConsoleSparks();
    // Steam off a grate, or out of a pipe run high on a wall, near a player: soft grey puffs that spread as they go.
    if(as_grateCount+as_pipeCount>0 && as_now>=as_steamVentNext) {
        as_steamVentNext=as_now+RandomFixed(0.7,1.4);
        v=RandomInt(0,as_grateCount+as_pipeCount-1);
        if(v<as_grateCount) {
            vx=IntToFixed(as_grateX[v]);vy=IntToFixed(as_grateY[v]);
            if(AS_HumanSees(Point(vx,vy))) {
                for(i=0;i<3;i+=1) {
                    s=RandomFixed(40.0,70.0)+IntToFixed(i)*25.0;
                    AS_Mote(vx+RandomFixed(-0.6,0.6),vy+RandomFixed(-0.6,0.6),0.1+0.25*IntToFixed(i),s,"46,48,50",RandomFixed(0.9,1.5),RandomFixed(1.6,2.4));
                }
            }
        }
        else {
            // A pipe on a wall facing the deck (rot 0 faces south): the jet blows out from the wall and sags.
            v-=as_grateCount;vx=as_pipeX[v]+RandomFixed(-0.8,0.8);vy=as_pipeY[v];t=as_pipeRot[v]-90.0;
            if(AS_HumanSees(Point(vx,vy))) {
                for(i=0;i<4;i+=1) {
                    s=RandomFixed(25.0,40.0)+IntToFixed(i)*22.0;
                    AS_Mote(vx+Cos(t)*(0.25+0.35*IntToFixed(i)),vy+Sin(t)*(0.25+0.35*IntToFixed(i)),2.15-0.12*IntToFixed(i),s,"52,54,56",RandomFixed(0.2,0.5),RandomFixed(1.2,1.9));
                }
            }
        }
    }
}
// A damaged console on a wall the camera sees spits a burst of sparks now and then, with a blue-white flash.
void AS_ConsoleSparks () {
    int c;fixed x;fixed y;fixed t;int k;
    if(as_consoleCount<=0 || as_now<as_sparkNext) {return;}
    as_sparkNext=as_now+RandomFixed(2.5,5.5);
    c=RandomInt(0,as_consoleCount-1);t=as_consoleRot[c]-90.0;
    // The console stands against the wall facing out along -Y of its turn: its top front edge is 0.45 out.
    x=as_consoleX[c]+Cos(t)*0.45+RandomFixed(-0.4,0.4);y=as_consoleY[c]+Sin(t)*0.45;
    if(!AS_HumanSees(Point(x,y))) {return;}
    for(k=0;k<3;k+=1) {AS_Fx("ASFxSpark",x+RandomFixed(-0.1,0.1),y+RandomFixed(-0.1,0.1),RandomFixed(0.8,1.0),t+RandomFixed(-40.0,40.0));}
    AS_Burst(x,y,0.95,0.35,"170,210,255",2);
}
void AS_AirClear () {
    int i;
    for(i=0;i<AS_MOTES;i+=1) {if(as_mote[i]!=null) {UnitRemove(as_mote[i]);as_mote[i]=null;}}
}
void AS_FxClear () {
    int i;
    for(i=0;i<AS_FXN;i+=1) {if(as_fx[i]!=null) {UnitRemove(as_fx[i]);as_fx[i]=null;}}
    for(i=0;i<AS_PUFFS;i+=1) {if(as_puff[i]!=null) {UnitRemove(as_puff[i]);as_puff[i]=null;}}
    for(i=0;i<AS_SPLATS;i+=1) {if(as_splat[i]!=null) {UnitRemove(as_splat[i]);as_splat[i]=null;}}
    for(i=0;i<AS_SPLATS;i+=1) {if(as_splatGlow[i]!=null) {UnitRemove(as_splatGlow[i]);as_splatGlow[i]=null;}}
    AS_AirClear();
}
// Alien Swarm's kill: a bright lime-green flare of acid a cell and a half across that hangs a moment
// and thins out, over a wider dim haze of it (seen in Landing Bay, 2026-10-23).
void AS_AcidCloud (fixed x, fixed y, fixed z, fixed big) {
    unit u;fixed s=1.1+big*1.2;
    u=AS_FxUnit("ASFxBurst",x,y,0.45+z,0.0,s,s,"150,255,40",12);
    if(u!=null) {ActorSend(libNtve_gf_MainActorofUnit(u),"SetOpacity 0 0.7");}
    u=AS_FxUnit("ASFxBurst",x,y,0.3+z,0.0,s*1.6,s*1.6,"40,90,10",18);
    if(u!=null) {ActorSend(libNtve_gf_MainActorofUnit(u),"SetOpacity 0 1.1");}
}
// A spray of alien blood along the direction the hit travelled.
void AS_Spray (fixed x, fixed y, fixed z, fixed ang, fixed size) {
    int k;fixed d;fixed s;
    for(k=0;k<3;k+=1) {
        d=0.1+IntToFixed(k)*0.3*size;s=size*(0.5-0.1*IntToFixed(k));
        AS_FxUnit("ASFxBurst",x+Cos(ang+RandomFixed(-20.0,20.0))*d,y+Sin(ang+RandomFixed(-20.0,20.0))*d,MaxF(0.1,z+RandomFixed(-0.1,0.15)),RandomFixed(0.0,360.0),s,s,"170,235,40",3+k);
    }
}
