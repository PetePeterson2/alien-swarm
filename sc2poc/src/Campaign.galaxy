// =====================================================================
// The campaign. Every level is in this one map (build.py LEVELS) and is
// built from its strings when it is played (src/Kit.galaxy), so the map
// carries no level geometry and the 256 x 256 limit never comes into it.
//
// The flow is Alien Swarm's: the map opens on MISSION PREP (src/Briefing.galaxy),
// where the host picks the mission (from those any player here has unlocked),
// the difficulty and Onslaught, and everyone picks a marine and gear. A won
// mission shows the debrief (XP, medals, the squad's numbers), saves to every
// player's bank and opens the next mission; the host CONTINUEs to its briefing.
// A lost one shows MISSION FAILED and a line of advice; the host RESTARTs it,
// from the briefing again. Four failures in a row and the host is offered an
// easier difficulty.
//
// The bank: HalcyonDrift.SC2Bank (HalcyonDriftQA in QA builds), per player:
//   campaign  "unlocked", how many missions are open (1 at first); "won<n>"
//   xp        "xp", "promo"
//   ach, cnt, won, best, lesson, load   achievements, counters, missions won by
//             difficulty, best times, hint counts, the gear last chosen per marine
//   cosmetic  "portrait", the portrait the marine wears (tools/hudart.py PORTRAITS)
// =====================================================================

int[5] as_unlocked;
int as_failStreak;
// What a level puts down besides its deck, so it can all be cleared for the next.
unit[16] as_ammoU;
const int AS_CREEPS = 32;
fixed[32] as_creepX;
fixed[32] as_creepY;
fixed[32] as_creepR;
int as_creepN;
bool as_debriefOn;
bool as_continueGo;

void AS_AmmoCrate (int i, fixed x, fixed y) {
    as_ammoAt[i]=Point(x,y);
    UnitCreate(1,"ASAmmo",c_unitCreateIgnorePlacement,0,as_ammoAt[i],0.0);
    as_ammoU[i]=UnitLastCreated();
}
void AS_Creep (fixed x, fixed y, fixed r) {
    CreepModify(Point(x,y),r,true,true);
    if(as_creepN<AS_CREEPS) {as_creepX[as_creepN]=x;as_creepY[as_creepN]=y;as_creepR[as_creepN]=r;as_creepN+=1;}
}

// ---- banks ----------------------------------------------------------
// A marine with a bank: every human; in the autopilot, marine 1 too (the QA bank).
bool AS_Banked (int p) {
    return AS_Person(p) && (!as_bot[p] || (as_auto && p==1));
}
void AS_BankLoad () {
    int p;int n;
    as_open=1;
    for(p=1;p<=AS_PLAYERS;p+=1) {
        as_bankOn[p]=false;as_unlocked[p]=1;
        if(!AS_Banked(p)) {continue;}
        as_bank[p]=BankLoad(as_bankName,p);as_bankOn[p]=true;
        n=1;
        if(BankKeyExists(as_bank[p],"campaign","unlocked")) {n=BankValueGetAsInt(as_bank[p],"campaign","unlocked");}
        as_unlocked[p]=MaxI(1,MinI(AS_LEVELS,n));
        if(BankKeyExists(as_bank[p],"cosmetic","portrait") && AS_HudPortraitKnown(BankValueGetAsString(as_bank[p],"cosmetic","portrait"))) {
            as_portrait[p]=BankValueGetAsString(as_bank[p],"cosmetic","portrait");
        }
        as_open=MaxI(as_open,as_unlocked[p]);
        AS_ProgressLoad(p);
    }
    AS_Log("banks read: "+IntToString(as_open)+" of "+IntToString(AS_LEVELS)+" levels open");
}
// Level n won: the next one opens for every player still in the game.
void AS_BankWin (int n) {
    int p;int open=MinI(AS_LEVELS,n+2);int best;int secs=FixedToInt(as_missionEnd-as_missionStart);
    for(p=1;p<=AS_PLAYERS;p+=1) {
        if(!as_bankOn[p] || PlayerStatus(p)!=c_playerStatusActive) {continue;}
        as_unlocked[p]=MaxI(as_unlocked[p],open);
        BankValueSetFromInt(as_bank[p],"campaign","version",2);
        BankValueSetFromInt(as_bank[p],"campaign","unlocked",as_unlocked[p]);
        BankValueSetFromInt(as_bank[p],"campaign","won"+IntToString(n),1);
        best=AS_BankGet(p,"best",IntToString(n)+"_"+IntToString(as_skill));
        if(best==0 || secs<best) {BankValueSetFromInt(as_bank[p],"best",IntToString(n)+"_"+IntToString(as_skill),secs);}
        BankSave(as_bank[p]);
        AS_Log("bank p"+IntToString(p)+": won "+IntToString(n)+", unlocked "+IntToString(as_unlocked[p]));
    }
    as_open=MaxI(as_open,open);
}

// ---- a level from start to finish -------------------------------------
// Launched from the briefing: the squad's difficulty, then the level.
void AS_LevelLaunch (int n) {
    int p;int squad=0;
    for(p=1;p<=AS_PLAYERS;p+=1) {if(as_on[p] && as_prof[p]<0) {as_on[p]=false;as_bot[p]=false;}}
    for(p=1;p<=AS_PLAYERS;p+=1) {if(as_on[p]) {squad+=1;}}
    for(p=1;p<=AS_PLAYERS;p+=1) {as_invLaunch[p][0]=as_inv[p][0];as_invLaunch[p][1]=as_inv[p][1];as_invLaunch[p][2]=as_inv[p][2];}
    AS_DifficultySet(as_skill,squad);
    AS_MusicStop();
    as_botCount=0;
    for(p=1;p<=AS_PLAYERS;p+=1) {if(as_on[p] && as_bot[p] && !(as_auto && p==1)) {as_botCount+=1;}}
    AS_Log("launch "+as_levelTitle[n]+" skill "+IntToString(as_skill)+" md "+IntToString(as_md)+" squad "+IntToString(squad)+" onslaught "+IntToString(BoolToInt(as_onslaught)));
    AS_LevelBegin(n);
}
void AS_LevelBegin (int n) {
    int p;
    as_level=n;as_debriefOn=false;
    for(p=1;p<=AS_PLAYERS;p+=1) {as_squadProf[p]= -1;if(AS_Person(p)) {as_squadProf[p]=as_prof[p];}}
    AS_MissionStatsReset();
    // Its tables, lamps, crates, eggs and biomass; the kit starts building the deck.
    AS_LevelLoad(n);AS_MissionData();
    as_light=0;GameSetLighting(as_lightId[0],0.0);
    for(p=1;p<=AS_PLAYERS;p+=1) {
        if(!AS_Person(p)) {continue;}
        as_respawnPt[p]=null;as_respawnAt[p]=0.0;
        as_kills[p]=0;as_ffDealt[p]=0.0;as_shotsFired[p]=0;as_shotsHit[p]=0;as_dmgTaken[p]=0.0;as_deaths[p]=0;
        as_botGoalPt[p]=null;as_botLast[p]=null;as_botFoe[p]= -1;as_botOrder[p]=0;
        AS_GiveLoadout(p);
        AS_MarineSpawn(p);
        AS_DebriefHide(p);
        AS_HudShow(p,true);
        AS_Announce(p,as_levelTitle[n],as_levelPlace[n]+"  //  "+AS_SkillName(as_skill));
    }
    AS_DirectorInit();AS_MissionInit();
    if(as_amb!=null) {SoundStop(as_amb,true);}
    SoundPlay(SoundLink("Ambience_HybridLabInner",-1),PlayerGroupAll(),45.0,0.0);as_amb=SoundLastPlayed();
    as_levelReady=true;
    AS_Log("level "+IntToString(n)+" begins: "+as_levelTitle[n]);
}
// Clear the level away: its deck, mission pieces, aliens, effects, lamps, crates and creep.
void AS_LevelEnd () {
    int p;int i;
    as_levelReady=false;
    AS_KitClear();AS_MissionClear();AS_AliensClear();AS_WeaponsClear();AS_FxClear();AS_LampsClear();AS_HintsHideAll();
    for(i=0;i<16;i+=1) {if(as_ammoU[i]!=null) {UnitRemove(as_ammoU[i]);as_ammoU[i]=null;}}
    as_ammoCount=0;
    for(i=0;i<as_creepN;i+=1) {CreepModify(Point(as_creepX[i],as_creepY[i]),as_creepR[i],false,true);}
    as_creepN=0;
    as_director=false;as_hordeLeftN=0;
    for(p=1;p<=AS_PLAYERS;p+=1) {
        as_god[p]=as_auto && p==1;as_infestUntil[p]=0.0;as_trigger[p]=false;as_trigger2[p]=false;as_spectate[p]=0;
        if(as_m[p]!=null) {libNtve_gf_ShowHideUnit(as_m[p],false);as_alive[p]=false;AS_TorchShow(p);}
        // Guns found or dropped in the mission stay in it: the loadout picked at the briefing comes back.
        if(as_invLaunch[p][0]+as_invLaunch[p][1]+as_invLaunch[p][2]>0) {as_inv[p][0]=as_invLaunch[p][0];as_inv[p][1]=as_invLaunch[p][1];as_inv[p][2]=as_invLaunch[p][2];}
    }
    AS_Log("level "+IntToString(as_level)+" cleared, units left "+IntToString(UnitGroupCount(UnitGroup(null,c_playerAny,RegionEntireMap(),null,0),c_unitCountAll)));
}
// A mission is won: medals and XP, the banks, the debrief; then the next mission's briefing.
// The mission is over: hints, the commander's subtitle and any lines still queued leave the screen to the debrief.
void AS_ScreenQuiet () {
    int p;
    AS_HintsHideAll();
    as_lineN=0;as_lineUntil=0.0;as_lineBusy=0.0;as_lineTalk=0.0;
    AS_MusicStop();
    for(p=1;p<=AS_PLAYERS;p+=1) {if(AS_Person(p)) {AS_HudSubtitle(p,"");}}
}
void AS_MissionWon () {
    int p;string next;
    AS_ScreenQuiet();
    as_lastWon=true;as_failStreak=0;
    AS_MissionAwards(true);
    AS_BankWin(as_level);
    if(as_level+1<AS_LEVELS) {next="Next: <c val=\"FFBA40\">"+as_levelTitle[as_level+1]+"</c>";}
    else {next="<c val=\"FFBA40\">CAMPAIGN COMPLETE</c>  -  Jacob's Rest is done.";}
    for(p=1;p<=AS_PLAYERS;p+=1) {if(AS_Person(p)) {AS_Debrief(p,next,true);}}
    AS_Music("ASMus_Aftermath");
    AS_UiDump("debrief_"+IntToString(as_level),1);
    as_debriefOn=true;as_continueGo=false;
    TriggerExecute(TriggerCreate("AS_NextT"),false,false);
}
// A mission is lost: MISSION FAILED and a line of advice, then the debrief with RESTART.
void AS_MissionLost (string why) {
    int p;string advice=AS_FailAdvice(why);
    AS_ScreenQuiet();
    as_lastWon=false;as_failStreak+=1;as_failWhy=advice;
    AS_MissionAwards(false);
    AS_AllSound("Alert_Defeat");
    for(p=1;p<=AS_PLAYERS;p+=1) {if(AS_Person(p)) {AS_AnnounceFor(p,"MISSION FAILED",advice,6.0);}}
    TriggerExecute(TriggerCreate("AS_FailT"),false,false);
}
bool AS_FailT (bool testConds, bool runActions) {
    int p;
    Wait(6.0,c_timeGame);
    for(p=1;p<=AS_PLAYERS;p+=1) {if(AS_Person(p)) {AS_Debrief(p,"<c val=\"FF6050\">"+as_failWhy+"</c>",false);}}
    AS_Music("ASMus_Aftermath");
    AS_UiDump("failed_"+IntToString(as_level),1);
    as_debriefOn=true;as_continueGo=false;
    if(as_failStreak>=4 && as_skill>1) {AS_AllMsg("Your squad may be better suited to an easier difficulty: the host can lower it in the briefing.");}
    TriggerExecute(TriggerCreate("AS_NextT"),false,false);
    return true;
}
// Alien Swarm's fail advice (asw_fail_advice.cpp 41-89): each mission scores what went wrong; a lost mission's
// advice is the highest score that came to anything and is not cooling down. It then cools for 3 missions, one
// fewer each mission, and scores nothing meanwhile. Nothing scored: teamwork, loadout or routes at random. Lines
// from swarm_english.txt 1191-1209; the ignored-item, wasted-heal, lighting and slow-progress tips have nothing
// here to count.
fixed[12] as_faScore;
int[12] as_faCool;
fixed[5][3] as_faHitAt;
string AS_FailLine (int k) {
    if(k==AS_FA_TEAMWORK) {return "Coordinate your squad's movement and firing zones.";}
    if(k==AS_FA_LOADOUT) {return "Tactically coordinate your squad's loadout equipment.";}
    if(k==AS_FA_ROUTES) {return "Plan your squad's route and consider alternatives.";}
    if(k==AS_FA_LOWAMMO) {return "Conserve your squad's ammo carefully.";}
    if(k==AS_FA_INFESTEDLOTS) {return "Avoid becoming infested to save health resources.";}
    if(k==AS_FA_INFESTED) {return "Use health resources to save and cure infested squad mates.";}
    if(k==AS_FA_SWARMED) {return "Build defensive sentries to fight large swarms.";}
    if(k==AS_FA_FF) {return "Avoid dealing damage to other squad mates.";}
    if(k==AS_FA_HACKER) {return "Protect the squad tech while they hack.";}
    if(k==AS_FA_SHIELDBUG) {return "The shield bug can block frontal attacks.";}
    if(k==AS_FA_ALONE) {return "Keep your squad formation tight to prevent becoming overwhelmed.";}
    return "Bring a medic along to keep the squad in good health.";
}
void AS_FailScore (int k, fixed v) {
    if(k<0 || k>=AS_FA_N || as_faCool[k]>0) {return;}
    as_faScore[k]+=v;
}
// Each mission's start: the scores from nothing, the cooldowns one shorter, and a squad with no medic noted.
void AS_FailReset () {
    int k;int p;bool medic=false;
    for(k=0;k<AS_FA_N;k+=1) {as_faScore[k]=0.0;if(as_faCool[k]>0) {as_faCool[k]-=1;}}
    for(p=1;p<=AS_PLAYERS;p+=1) {
        for(k=0;k<3;k+=1) {as_faHitAt[p][k]= -10.0;}
        if(AS_Person(p) && AS_Class(p)==AS_CL_MEDIC) {medic=true;}
    }
    if(!medic) {AS_FailScore(AS_FA_NOMEDIC,2.0);}
}
void AS_FailHurt (int p, fixed dmg, int kind, int byP) {
    if(byP>=1 && byP<=AS_PLAYERS && byP!=p) {AS_FailScore(AS_FA_FF,dmg/50.0);}
    if(as_using[p]>=0 && AS_IsTech(p)) {AS_FailScore(AS_FA_HACKER,dmg/40.0);}
    if(kind!=0 || byP>=1) {return;}
    as_faHitAt[p][2]=as_faHitAt[p][1];as_faHitAt[p][1]=as_faHitAt[p][0];as_faHitAt[p][0]=as_now;
    if(as_now-as_faHitAt[p][2]<1.5) {AS_FailScore(AS_FA_SWARMED,1.0);as_faHitAt[p][1]= -10.0;as_faHitAt[p][2]= -10.0;}
}
void AS_FailDied (int p) {
    int q;fixed best=999.0;point here=UnitGetPosition(as_m[p]);
    if(as_using[p]>=0 && AS_IsTech(p)) {AS_FailScore(AS_FA_HACKER,1.0);}
    for(q=1;q<=AS_PLAYERS;q+=1) {
        if(q!=p && as_alive[q] && as_m[q]!=null) {best=MinF(best,DistanceBetweenPoints(here,UnitGetPosition(as_m[q])));}
    }
    if(best<999.0 && best>12.5) {AS_FailScore(AS_FA_ALONE,1.0);}
}
string AS_FailAdvice (string why) {
    int k;int pick= -1;fixed need;
    for(k=AS_FA_LOWAMMO;k<AS_FA_N;k+=1) {
        need=1.0;if(k==AS_FA_SWARMED) {need=3.0;}
        if(as_faCool[k]>0 || as_faScore[k]<need) {continue;}
        if(pick<0 || as_faScore[k]>as_faScore[pick]) {pick=k;}
    }
    if(pick<0) {pick=RandomInt(AS_FA_TEAMWORK,AS_FA_ROUTES);}
    else {as_faScore[pick]=0.0;as_faCool[pick]=3;}
    AS_Log("fail advice: "+IntToString(pick));
    if(why!="") {return why+"  -  "+AS_FailLine(pick);}
    return AS_FailLine(pick);
}
// The debrief waits for the host (CONTINUE or RESTART); the autopilot waits a moment and goes on.
bool AS_NextT (bool testConds, bool runActions) {
    fixed waited=0.0;
    AS_ReadyReset();
    while(!as_continueGo) {
        if(as_auto && waited>=3.0) {break;}
        Wait(0.25,c_timeGame);waited+=0.25;
        AS_DebriefCountdown(0);
    }
    as_debriefOn=false;
    if(as_lastWon && as_level+1>=AS_LEVELS) {AS_Log("CAMPAIGN COMPLETE");}
    AS_LevelEnd();
    Wait(0.5,c_timeGame);
    if(as_lastWon) {
        if(as_auto && as_level+1<AS_LEVELS) {AS_LevelLaunch(as_level+1);return true;}
        if(as_auto) {AS_Log("autopilot done");return true;}
        AS_HudAllHide();
        AS_BriefingOpen(MinI(as_level+1,AS_LEVELS-1));
        return true;
    }
    if(as_auto) {AS_Log("autopilot: mission failed, relaunching");AS_LevelLaunch(as_level);return true;}
    AS_HudAllHide();
    AS_BriefingOpen(as_level);
    return true;
}
// Restart without the failure screen (the last tech fell in the first 30 s).
void AS_MissionRestart () {
    TriggerExecute(TriggerCreate("AS_RestartT"),false,false);
}
// AS's in-game restart (no live tech): the same squad and loadouts start the mission over, no briefing between.
bool AS_RestartT (bool testConds, bool runActions) {
    Wait(0.5,c_timeGame);
    AS_LevelEnd();
    Wait(0.5,c_timeGame);
    AS_LevelLaunch(as_level);
    return true;
}
// The host's CONTINUE / RESTART on the debrief (src/HUD.galaxy).
void AS_DebriefGo (int p) {
    if(!as_debriefOn || p!=as_brHost) {return;}
    as_continueGo=true;
}
// Before a level is running: nothing yet (the briefing is click-driven).
void AS_CampaignPulse () {}
// After the players and their HUDs are made: read the banks, then the briefing (or the QA start level).
void AS_CampaignInit () {
    int p;
    AS_LevelNames();
    AS_BankLoad();
    as_brHost=AS_BrFirstHuman();
    // The autopilot goes through the briefing as a player would, then launches from it.
    if(as_auto) {as_brHost=1;TriggerExecute(TriggerCreate("AS_AutoBriefT"),false,false);return;}
    if(as_startLevel>=0) {
        // QA: everyone on a marine at once (alone: Sarge, Wildcat, Faith, Crash), straight in.
        for(p=1;p<=AS_PLAYERS;p+=1) {if(as_on[p] && as_prof[p]<0) {AS_BrAssign(p,AS_BrFreeProfile(-1));}}
        if(AS_HumanCount()<=1) {AS_BrAutoFill();}
        AS_LevelLaunch(MinI(as_startLevel,AS_LEVELS-1));
        return;
    }
    AS_BriefingOpen(as_open-1);
}

// ---- the autopilot's pass through the briefing ------------------------------------------------
// Every control a host uses, through the same actions their clicks run (AS_BrAction): the mission arrows,
// each difficulty, Onslaught, the roster and each bio, the item list and each item's page, an equip, the
// achievements. Player 1 takes the marine build.py --marine names (Crash by default, so the hacks are done at the screens).
bool AS_AutoBriefT (bool testConds, bool runActions) {
    int p=1;int k;int orig;int xp;
    AS_HintsReset(p);
    AS_BriefingOpen(as_open-1);
    // The briefing makes the first human the host; the autopilot's player counts as a bot there.
    as_brHost=1;
    AS_Log("ui test: briefing open on "+as_levelTitle[as_briefMission]+", squad slots "+IntToString(AS_SquadCount()));
    Wait(1.0,c_timeGame);
    AS_BrAction(p,2);AS_BrAction(p,1);
    // To the --start level (Landing Bay unless asked otherwise).
    for(k=0;k<AS_LEVELS && as_briefMission!=MaxI(as_startLevel,AS_LV_BAY);k+=1) {AS_BrAction(p,1);}
    for(k=11;k<=15;k+=1) {AS_BrAction(p,k);Wait(0.25,c_timeGame);}
    AS_BrAction(p,10+as_autoSkill);AS_BrAction(p,20);AS_BrAction(p,20);
    if(as_autoOnslaught) {AS_BrAction(p,20);}
    AS_Log("ui test: "+as_levelTitle[as_briefMission]+" on "+AS_SkillName(as_skill)+", onslaught "+IntToString(BoolToInt(as_onslaught)));
    AS_BrAction(p,31);
    for(k=70;k<=77;k+=1) {AS_BrAction(p,k);Wait(0.25,c_timeGame);}
    AS_BrAction(p,70+as_autoProf);AS_UiDump("roster",p);AS_BrAction(p,80);
    AS_BrAutoFill();AS_BrRefreshAll();
    AS_Log("ui test: p1 is "+AS_MarineNameS(p)+", squad "+IntToString(AS_SquadCount())+", tech "+IntToString(BoolToInt(AS_BrSquadHasTech())));
    Wait(0.5,c_timeGame);
    AS_UiDump("briefing",p);
    for(k=0;k<3;k+=1) {
        orig=as_inv[p][k];
        AS_BrAction(p,43+k);Wait(0.25,c_timeGame);
        if(k==0) {AS_BrAction(p,100);AS_UiDump("items",p);}
        if(k==2) {AS_BrAction(p,100);AS_UiDump("items_offhand",p);}
        AS_AutoBriefItems(p,orig);
    }
    AS_Log("ui test: loadout "+as_it[as_inv[p][0]].title+" / "+as_it[as_inv[p][1]].title+" / "+as_it[as_inv[p][2]].title);
    AS_BrAction(p,152);Wait(1.0,c_timeGame);AS_UiDump("achievements",p);AS_BrAction(p,154);
    // Promotion from level 27 (PROMOTE on the achievements page), then the real rank back.
    xp=as_xp[p];as_xp[p]=AS_XpFor(p,27);
    AS_Log("ui test: rank level "+IntToString(AS_PlayerLevel(p))+", can promote "+IntToString(BoolToInt(AS_CanPromote(p))));
    AS_BrAction(p,153);
    AS_Log("ui test: promoted to "+AS_PromoName(as_promo[p])+", level "+IntToString(AS_PlayerLevel(p))+", level 2 now needs "+IntToString(AS_XpFor(p,2))+" xp");
    as_promo[p]=MaxI(0,as_promo[p]-1);as_xp[p]=xp;AS_BankSet(p,"xp","xp",xp);AS_BankSet(p,"xp","promo",as_promo[p]);AS_BankSave(p);AS_BrRefreshAll();
    AS_Log("ui test: achievements "+IntToString(AS_AchievedCount(p))+" of "+IntToString(as_achN));
    Wait(0.5,c_timeGame);
    AS_BrAction(p,150);
    return true;
}
// Each item's page in the open list, then the one the marine had equipped again (EQUIP).
void AS_AutoBriefItems (int p, int orig) {
    int j;int back= -1;
    for(j=0;j<as_itListN[p];j+=1) {
        AS_BrAction(p,100+j);
        if(as_itListed[p][j]==orig) {back=j;}
    }
    if(back<0) {AS_BrAction(p,141);AS_Log("ui test: equipped item missing from its list");return;}
    AS_BrAction(p,100+back);AS_BrAction(p,140);
}
